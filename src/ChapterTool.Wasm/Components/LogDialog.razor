@inject WasmWorkspace Workspace
@inject WasmLocalizer L
@inject IJSRuntime Js
@implements IDisposable

<WasmDialog Title="@L.T("Modal.LogTitle")" CssClass="log-modal" OnClose="CloseOrBackAsync" LightDismiss="true">
    <div class="modal-body">
        <div class="log-filters">
            <label for="log-search">@L.T("Parity.LogSearch")</label>
            <input id="log-search" type="search" @bind="_view.Search" @bind:event="oninput" @bind:after="Refresh" />
            <label for="log-severity">@L.T("Parity.LogSeverity")</label>
            <select id="log-severity" @bind="_view.Severity" @bind:after="Refresh">
                <option value="">@L.T("Parity.LogAll")</option>
                <option value="Info">@L.T("Tool.Log.FilterInformation")</option>
                <option value="Warning">@L.T("Tool.Log.FilterWarning")</option>
                <option value="Error">@L.T("Tool.Log.FilterError")</option>
            </select>
            <button type="button" class="secondary" disabled="@(_view.Search.Length == 0 && _view.Severity.Length == 0)" @onclick="ResetFilters">@L.T("Tool.Log.ResetFilters")</button>
            <output aria-live="polite">@L.Format("Parity.LogCount", _view.Visible.Count)</output>
        </div>
        <div class="log-surfaces @(_view.InspectorOpen ? "inspecting" : null)">
            <div class="log-list" id="log-list" role="list" aria-label="@L.T("Modal.LogTitle")" tabindex="-1">
                @if (_view.Visible.Count == 0) { <p>@L.T(_view.HasAnyEntries ? "Tool.Log.Empty" : "Tool.Log.NoEntries")</p> }
                @foreach (var entry in _view.Visible.Reverse())
                {
                    var time = entry.Timestamp.ToLocalTime().ToString("HH:mm:ss.fff");
                    var summary = WasmLogView.CompactSummary(entry.Message);
                    var level = LevelName(entry.Level);
                    var additionalSearchMatch = _view.Search.Length > 0 && !summary.Contains(_view.Search, StringComparison.OrdinalIgnoreCase)
                        && WasmLogView.SearchesAdditionalFields(entry, _view.Search, summary, time, level);
                    var accessibleName = L.Format("Tool.Log.EntryAccessibleName", level, summary, time, string.Empty)
                        + (additionalSearchMatch ? $" {L.T("Tool.Log.SearchMatchAdditional")}" : string.Empty);
                    <div @key="entry.Id" id="@($"log-{entry.Id}")" class="log-entry @(_view.SelectedId == entry.Id ? "selected" : null)"
                         role="listitem">
                        <button type="button" id="@($"log-select-{entry.Id}")" class="log-select" aria-pressed="@(_view.SelectedId == entry.Id ? "true" : "false")"
                                aria-label="@accessibleName"
                                @onclick="() => _view.SelectedId = entry.Id">
                            <time>@Highlight(time)</time>
                            <span class="log-level @entry.Level.ToLowerInvariant()">@Highlight(level)</span>
                            <span class="log-summary">@Highlight(summary)</span>
                            @if (additionalSearchMatch)
                            {
                                <span class="log-detail-match">@L.T("Parity.LogDetailMatch")</span>
                            }
                        </button>
                        <button type="button" class="secondary log-details-button"
                                aria-label="@L.T("Parity.LogDetails")"
                                aria-controls="log-inspector"
                                @onclick="() => Inspect(entry)">@L.T("Parity.LogDetails")</button>
                    </div>
                }
            </div>
            @if (_view.InspectorOpen && _view.Selected is { } selected)
            {
                <section id="log-inspector" class="log-inspector" aria-labelledby="log-inspector-title">
                    <button id="log-back" type="button" class="secondary" @onclick="BackAsync">@L.T("Parity.LogBack")</button>
                    <h3 id="log-inspector-title">@L.T("Parity.LogDetails")</h3>
                    <p>@selected.Timestamp.ToLocalTime() · @LevelName(selected.Level)</p>
                    <p>@selected.Message</p>
                    @if (!string.IsNullOrWhiteSpace(selected.Details)) { <pre>@selected.Details</pre> }
                    <details><summary>@L.T("Parity.LogRaw")</summary><pre>@System.Text.Json.JsonSerializer.Serialize(selected)</pre></details>
                    <button type="button" class="secondary" @onclick="() => CopyTextAsync(selected.Message)">@L.T("Tool.Log.CopySummary")</button>
                    <button type="button" class="secondary" disabled="@string.IsNullOrWhiteSpace(selected.Details)" @onclick="() => CopyTextAsync(selected.Details)">@L.T("Tool.Log.CopyDetails")</button>
                    <button type="button" class="secondary" @onclick="CopyAsync">@L.T("Text.Copy")</button>
                </section>
            }
        </div>
        @if (_status is not null) { <p role="status">@_status</p> }
    </div>
    <footer class="modal-footer">
        <button type="button" class="secondary" @onclick="Clear">@L.T("Common.Clear")</button>
        <details class="log-export"><summary>@L.T("Parity.LogExport")</summary>
            <button type="button" class="secondary" @onclick="() => ExportAsync(false)">JSON</button>
            <button type="button" class="secondary" @onclick="() => ExportAsync(true)">CSV</button>
        </details>
        <span class="modal-spacer"></span>
        <button type="button" class="secondary" @onclick="OnClose">@L.T("Action.Close")</button>
    </footer>
</WasmDialog>

@code {
    [Parameter, EditorRequired] public EventCallback OnClose { get; set; }
    private WasmLogView _view = null!;
    private string? _status;
    private string? _pendingFocus;
    protected override void OnInitialized() { _view = new WasmLogView(Workspace.Logs); Workspace.Changed += Changed; }
    private void Changed() => InvokeAsync(() => { _view.Refresh(); StateHasChanged(); });
    public void Dispose() => Workspace.Changed -= Changed;
    protected override void OnParametersSet() => _view?.Refresh();
    private void Refresh() => _view.Refresh();
    private void ResetFilters()
    {
        _view.Search = string.Empty;
        _view.Severity = string.Empty;
        _view.Refresh();
    }
    private void Inspect(WasmLogEntry entry) { _view.SelectedId = entry.Id; _view.InspectorOpen = true; _pendingFocus = "log-back"; }
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_pendingFocus is not { } target) return;
        _pendingFocus = null;
        await Js.InvokeVoidAsync("chapterToolWasm.focus", target);
    }
    private string LevelName(string level) => L.T("Parity.LogLevel." + level);
    private void Clear() { Workspace.ClearLogs(); _view.ClearSelection(); _view.Refresh(); }
    private Task CloseOrBackAsync() => _view.InspectorOpen ? BackAsync() : OnClose.InvokeAsync();
    private Task BackAsync()
    {
        _view.InspectorOpen = false;
        _pendingFocus = _view.SelectedId is { } id && _view.Visible.Any(entry => entry.Id == id)
            ? $"log-select-{id}"
            : "log-search";
        return Task.CompletedTask;
    }
    private async Task CopyAsync()
    {
        if (_view.Selected is not { } selected) return;
        await CopyTextAsync(System.Text.Json.JsonSerializer.Serialize(selected));
    }
    private async Task CopyTextAsync(string? text)
    {
        if (string.IsNullOrWhiteSpace(text)) return;
        try { await Js.InvokeVoidAsync("chapterToolWasm.copyText", text); _status = L.T("Copy.Preview"); }
        catch (JSException) { _status = L.T("Parity.LogFailed"); }
    }
    private async Task ExportAsync(bool csv)
    {
        var content = _view.Export(csv);
        try
        {
            await Js.InvokeVoidAsync("chapterToolWasm.downloadText", csv ? "chaptertool-log.csv" : "chaptertool-log.json", content, "utf8", false);
            _status = L.T("Parity.LogExported");
        }
        catch (JSException) { _status = L.T("Parity.LogFailed"); }
    }
    private RenderFragment Highlight(string text) => builder =>
    {
        var match = _view.Search.Length == 0 ? -1 : text.IndexOf(_view.Search, StringComparison.OrdinalIgnoreCase);
        if (match < 0) { builder.AddContent(0, text); return; }
        builder.AddContent(0, text[..match]);
        builder.OpenElement(1, "mark"); builder.AddContent(2, text.Substring(match, _view.Search.Length)); builder.CloseElement();
        builder.AddContent(3, text[(match + _view.Search.Length)..]);
    };
}
