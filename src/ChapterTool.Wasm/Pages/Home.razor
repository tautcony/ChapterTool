                else if (_settingsTab == 5)
                {
                    <h3>@L.T("Settings.Shortcuts")</h3>
                    <ShortcutSettingsEditor Draft="@_draftShortcuts" OnChanged="ApplySettingsDraftAsync" />
                }
                else
                {
                    <h3>@L.T("Settings.About")</h3>
                    <div class="about-body">
                        <p>@L.T("Settings.AboutBody")</p>
                        <p class="settings-note">@L.T("Settings.AboutRuntime")</p>
                        <p class="settings-note">@L.T("Settings.AboutLicense")</p>
                        <a href="https://github.com/tautcony/ChapterTool" target="_blank" rel="noreferrer">github.com/tautcony/ChapterTool</a>
                    </div>
                }
            </div>
            @if (_settingsError is not null) { <p class="settings-note" role="alert">@_settingsError</p> }
            <footer class="modal-footer">
                <button type="button" class="secondary" @onclick="ResetSettings">@L.T("Action.RestoreDefaults")</button>
                <span class="modal-spacer"></span>
                <button type="button" class="secondary" data-testid="settings-cancel" @onclick="CancelSettings">@L.T("Common.Cancel")</button>
                <button type="button" class="secondary" disabled="@(!SettingsDraftValid)" data-testid="settings-apply" @onclick="ApplySettingsAsync">@L.T("Common.Save")</button>
            </footer>
    </WasmDialog>
}

@if (_activeDialog == DialogKind.History)
