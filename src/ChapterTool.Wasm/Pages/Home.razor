@if (_activeDialog == DialogKind.ExportOptions)
{
    <ExportOptionsDialog OnClose="CloseDialog" OnApply="ApplyExportOptionsAsync" />
}

@code {
    private const string SettingsStorageKey = "chaptertool.wasm.settings";
    private static readonly JsonSerializerOptions SettingsJsonOptions = new(JsonSerializerDefaults.Web)
    {
        WriteIndented = true
    };
    private static readonly WasmLanguageOption[] UiLanguages =
    [
        new("zh-CN", "简体中文"),
        new("en-US", "English"),
        new("ja-JP", "日本語")
    ];
    private static readonly WasmFontOption[] UiFontOptions =
    [
        new("system-ui", "System UI"),
        new("Segoe UI, system-ui, sans-serif", "Segoe UI"),
        new("Arial, sans-serif", "Arial")
    ];
    private static readonly WasmFontOption[] MonospaceFontOptions =
    [
        new("ui-monospace, SFMono-Regular, Menlo, Consolas, monospace", "System monospace"),
        new("Menlo, Consolas, monospace", "Menlo / Consolas"),
        new("Courier New, monospace", "Courier New")
    ];
    private static readonly WasmThemeOption[] ThemeOptions =
    [
        new("avalonia-default", "Avalonia Default", ["#F0F0F0", "#F7F7F7", "#FFFFFF", "#111111", "#0067C0", "#767676", "#D6E9F8", "#CCE4F7"]),
        new("solarized-light", "Solarized Light", ["#FDF6E3", "#EEE8D5", "#FFFDF5", "#002B36", "#006C75", "#657B83", "#E1DABF", "#C8BE9F"]),
        new("solarized-dark", "Solarized Dark", ["#002B36", "#073642", "#0B414D", "#FDF6E3", "#D9A400", "#839496", "#155766", "#1E6675"]),
        new("gruvbox-light", "Gruvbox Light", ["#FBF1C7", "#EBDBB2", "#FFF8D9", "#282828", "#9D0006", "#7C6F64", "#D5C4A1", "#BDAE93"]),
        new("gruvbox-dark", "Gruvbox Dark", ["#282828", "#3C3836", "#32302F", "#FBF1C7", "#D79921", "#A89984", "#504945", "#665C54"]),
        new("ayu-light", "Ayu Light", ["#FAFAFA", "#F3F4F5", "#FFFFFF", "#242936", "#006D77", "#6C7680", "#E1E7EA", "#CBD3D8"]),
        new("ayu-mirage", "Ayu Mirage", ["#1F2430", "#242936", "#2A3141", "#F3F4F5", "#FFCC66", "#8A919F", "#343D50", "#475268"]),
        new("ayu-dark", "Ayu Dark", ["#0B0E14", "#11151C", "#151A23", "#E6E1CF", "#FFB454", "#7A8494", "#242B38", "#343D4D"])
    ];
    private int _saveFormatIndex;
    private int _chapterNameModeIndex;
    private int _orderShift;
    private int _selectedFrameRateIndex;
    private string _xmlLanguage = "eng";
    private string _defaultXmlLanguage = "eng";
    private bool _roundFrames = true;
    private string _uiLanguage = "en-US";
    private int _outputTextEncodingIndex;
    private bool _emitBom;
    private decimal _frameAccuracyTolerance = 0.15m;
    private string _themePresetId = "avalonia-default";
    private string _uiFontFamily = "system-ui";
    private string _monospaceFontFamily = "ui-monospace, SFMono-Regular, Menlo, Consolas, monospace";
    private bool _appReady;
    private enum DialogKind { None, History, Expression, ExportOptions, Settings, Logs, Preview, Forward, Related }
    private DialogKind _activeDialog;
    private string _contentOperation = "naming";
    private bool _isDragOver;
    private bool _mainExpressionPreviewPending;
    private bool _mainOptionsCandidateAtExpressionOpen;
    private CancellationTokenSource? _mainExpressionPreviewCancellation;
    private int _settingsTab;
    private ShortcutSettings _shortcuts = WasmShortcuts.Normalize(null);
    private ShortcutSettings _draftShortcuts = WasmShortcuts.Normalize(null);
    private string? _entrySettingsJson;
    private WasmSettings? _entryRuntimeSettings;
    private WasmSettings? _lastAppliedRuntimeSettings;
    private bool _entryRuntimeRoundFrames;
    private bool _confirmSettingsDiscard;
    private string? _settingsError;
    private int _defaultSaveFormatIndex;
    private int _draftSaveFormatIndex;
    private string _draftXmlLanguage = "eng";
    private string _draftUiLanguage = "en-US";
    private int _draftOutputTextEncodingIndex;
    private bool _draftEmitBom;
    private decimal _draftFrameAccuracyTolerance = 0.15m;
    private int _draftFrameDisplayModeIndex;
    private string _draftFrameDecimalPlaces = "3";
    private bool _draftShowRepeatingFrameDecimals = true;
    private bool _showRepeatingFrameDecimals = true;
    private int _draftDeleteRowsTimingModeIndex;
    private string _draftThemePresetId = "avalonia-default";
    private string _draftUiFontFamily = "system-ui";
    private string _draftMonospaceFontFamily = "ui-monospace, SFMono-Regular, Menlo, Consolas, monospace";
    private int _contextMenuIndex = -1;
    private string _contextMenuXpx = "0px";
    private string _contextMenuYpx = "0px";
    private string? _contextMenuTarget;
    private bool _loadMenuOpen;
    private string _previewText = string.Empty;
    private string? _previewFileName;
    private DotNetObjectReference<Home>? _dropZoneRef;

    private WasmThemeOption SelectedTheme =>
        ThemeOptions.FirstOrDefault(theme => string.Equals(theme.Id, _draftThemePresetId, StringComparison.OrdinalIgnoreCase)) ?? ThemeOptions[0];

    protected override void OnInitialized()
    {
        Workspace.SessionLossConfirmation = ConfirmSessionLossAsync;
        Workspace.Changed += OnWorkspaceChanged;
        L.CultureChanged += OnCultureChanged;
        PullOptionsFromWorkspace();
        Workspace.SetStatusMessage(L.T("Status.Ready"));
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        _dropZoneRef = DotNetObjectReference.Create(this);
        try
        {
            await Js.InvokeVoidAsync("chapterToolWasm.registerShortcutGuard");
            await Js.InvokeVoidAsync("chapterToolWasm.registerDropZone", "chaptertool-shell", _dropZoneRef, WasmWorkspace.MaxLoadBytes);

            var json = await Js.InvokeAsync<string?>("chapterToolWasm.getLocalStorage", SettingsStorageKey);
            if (!string.IsNullOrWhiteSpace(json))
            {
                try
                {
                    var settings = JsonSerializer.Deserialize<WasmSettings>(json, SettingsJsonOptions);
                    if (settings is { SchemaVersion: 1, Application: not null, Theme: not null, Font: not null })
                    {
                        ApplySettingsToWorkspace(settings);
                        PullOptionsFromWorkspace();
                        StateHasChanged();
                    }
                    else
                    {
                        await Js.InvokeVoidAsync("chapterToolWasm.removeLocalStorage", SettingsStorageKey);
                    }
                }
                catch (JsonException)
                {
                    await Js.InvokeVoidAsync("chapterToolWasm.removeLocalStorage", SettingsStorageKey);
                }
            }
        }
        catch (JSException)
        {
            // Privacy mode or a missing JavaScript host must not block first render.
        }
        finally
        {
            try { await ApplyAppearanceAsync(); }
            catch (JSException) { }
            try { await SyncShortcutGuardAsync(); }
            catch (JSException) { }
            _appReady = true;
            await InvokeAsync(StateHasChanged);
        }
    }

    public void Dispose()
    {
        Workspace.Changed -= OnWorkspaceChanged;
        L.CultureChanged -= OnCultureChanged;
        _mainExpressionPreviewCancellation?.Cancel();
        _mainExpressionPreviewCancellation?.Dispose();
        _dropZoneRef?.Dispose();
    }

    [JSInvokable]
    public void OnDragStateChanged(bool over)
    {
        if (_activeDialog != DialogKind.None) return;
        if (_isDragOver == over)
        {
            return;
        }

        _isDragOver = over;
        if (over)
        {
            Workspace.SetStatusMessage(L.T("Status.DropReady"));
        }

        StateHasChanged();
    }

    [JSInvokable]
    public async Task OnBrowserFileDropped(string name, byte[]? bytes)
    {
        if (_activeDialog != DialogKind.None) return;
        _isDragOver = false;
        CloseContextMenu();
        if (string.IsNullOrWhiteSpace(name) || bytes is null || bytes.Length == 0)
        {
            Workspace.SetStatusMessage(L.T("Status.DropEmpty"));
            Workspace.RecordAction(L.T("Status.DropEmpty"));
            StateHasChanged();
            return;
        }

        if (bytes.LongLength > WasmWorkspace.MaxLoadBytes)
        {
            Workspace.SetStatusMessage(L.T("Status.DropTooLarge"));
            Workspace.RecordAction(L.T("Status.DropTooLarge"));
            StateHasChanged();
            return;
        }

        PushExportOptions();
        PushProjectionOptions();
        await Workspace.LoadAsync(name, bytes);
        PullOptionsFromWorkspace();
        StateHasChanged();
    }

    [JSInvokable]
    public void OnBrowserFileDropRejected(string reason)
    {
        if (_activeDialog != DialogKind.None) return;
        _isDragOver = false;
        var message = string.Equals(reason, "too-large", StringComparison.OrdinalIgnoreCase)
            ? L.T("Status.DropTooLarge")
            : L.T("Status.DropBlocked");
        Workspace.SetStatusMessage(message);
        Workspace.RecordAction(message);
        StateHasChanged();
    }

    private void OnWorkspaceChanged() => InvokeAsync(() =>
    {
        PullOptionsFromWorkspace();
        StateHasChanged();
    });

    private void OnCultureChanged() => InvokeAsync(StateHasChanged);

    private void PullOptionsFromWorkspace()
    {
        _saveFormatIndex = Workspace.SaveFormatIndex;
        _chapterNameModeIndex = Workspace.ChapterNameModeIndex;
        _orderShift = Workspace.OrderShift;
        _xmlLanguage = Workspace.XmlLanguage;
        _roundFrames = Workspace.RoundFrames;
        _selectedFrameRateIndex = Workspace.SelectedFrameRateIndex;
        _outputTextEncodingIndex = OutputTextEncodings.All.ToList().IndexOf(Workspace.TextEncoding);
        _emitBom = Workspace.EmitBom;
        _frameAccuracyTolerance = Workspace.FrameAccuracyTolerance;
    }

    private void PushExportOptions()
    {
        Workspace.SaveFormatIndex = _saveFormatIndex;
        Workspace.XmlLanguage = _xmlLanguage;
        Workspace.TextEncoding = OutputTextEncodings.All[Math.Clamp(_outputTextEncodingIndex, 0, OutputTextEncodings.All.Count - 1)];
        Workspace.EmitBom = _emitBom;
        Workspace.FrameAccuracyTolerance = _frameAccuracyTolerance;
    }

    private void PushProjectionOptions()
    {
        Workspace.ChapterNameModeIndex = _chapterNameModeIndex;
        Workspace.OrderShift = _orderShift;
        Workspace.RoundFrames = _roundFrames;
    }

    private async Task OnExportOptionsChanged()
    {
        PushExportOptions();
        StateHasChanged();
        await PersistSettingsAsync();
    }

    private async Task OnProjectionOptionsChanged()
    {
        PushProjectionOptions();
        await PrepareMainOptionsPreviewAsync();
    }

    private void OnRoundFramesChanged(ChangeEventArgs args)
    {
        _roundFrames = args.Value is bool b
            ? b
            : string.Equals(args.Value?.ToString(), "true", StringComparison.OrdinalIgnoreCase);
        Workspace.RoundFrames = _roundFrames;
        Workspace.ApplyOptionsAndRefresh();
    }

    private async Task OnFrameRateChanged(ChangeEventArgs args)
    {
        if (int.TryParse(args.Value?.ToString(), out var index))
        {
            _selectedFrameRateIndex = index;
            Workspace.PreferredFrameRateIndex = index;
            Workspace.SelectedFrameRateIndex = index;
            await PersistSettingsAsync();
        }
    }

    private async Task TriggerLoad()
    {
        CloseContextMenu();
        await Js.InvokeVoidAsync("chapterToolWasm.click", "loadFileInput");
    }

    private async Task TriggerAppendMpls()
    {
        CloseContextMenu();
        await Js.InvokeVoidAsync("chapterToolWasm.click", "appendMplsInput");
    }

    private async Task OnFileSelected(InputFileChangeEventArgs args)
    {
        var file = args.File;

        await LoadFileAsync(file);
    }

    private async Task OnAppendMplsSelected(InputFileChangeEventArgs args)
    {
        var file = args.File;

        await AppendMplsFileAsync(file);
    }

    private async Task LoadFileAsync(IBrowserFile file)
    {
        try
        {
            if (file.Size is < 0 or > WasmWorkspace.MaxLoadBytes)
            {
                throw new IOException();
            }

            await using var stream = file.OpenReadStream(maxAllowedSize: WasmWorkspace.MaxLoadBytes);
            var bytes = new byte[file.Size];
            var read = 0;
            while (read < bytes.Length)
            {
                var n = await stream.ReadAsync(bytes.AsMemory(read));
                if (n == 0)
                {
                    break;
                }

                read += n;
            }

            if (read < bytes.Length)
            {
                Array.Resize(ref bytes, read);
            }

            PushExportOptions();
            PushProjectionOptions();
            await Workspace.LoadAsync(file.Name, bytes);
            PullOptionsFromWorkspace();
        }
        catch (IOException)
        {
            Workspace.SetStatusMessage(L.T("Status.DropTooLarge"));
            Workspace.RecordAction(L.T("Status.DropTooLarge"));
        }
        catch (Exception ex)
        {
            Workspace.SetStatusMessage(ex.Message);
            await Js.InvokeVoidAsync("console.error", ex.Message);
        }
    }

    private async Task AppendMplsFileAsync(IBrowserFile file)
    {
        try
        {
            if (file.Size is < 0 or > WasmWorkspace.MaxLoadBytes)
            {
                throw new IOException();
            }

            await using var stream = file.OpenReadStream(maxAllowedSize: WasmWorkspace.MaxLoadBytes);
            using var memory = new MemoryStream();
            await stream.CopyToAsync(memory);
            PushExportOptions();
            PushProjectionOptions();
            await Workspace.AppendMplsAsync(file.Name, memory.ToArray());
            PullOptionsFromWorkspace();
        }
        catch (Exception ex)
        {
            Workspace.SetStatusMessage(ex.Message);
            Workspace.RecordAction(ex.Message);
        }
    }

    private async Task LoadSampleAsync()
    {
        PushExportOptions();
        PushProjectionOptions();
        await Workspace.LoadSampleAsync();
        PullOptionsFromWorkspace();
    }

    private async Task ReloadAsync()
    {
        CloseContextMenu();
        PushExportOptions();
        PushProjectionOptions();
        await Workspace.ReloadAsync();
        PullOptionsFromWorkspace();
    }

    private async Task SaveAsync()
    {
        PushExportOptions();
        var result = Workspace.Save();
        if (result is { Success: true, Content: not null, FileName: not null })
