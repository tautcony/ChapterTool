    private void ResetSettings()
    {
        draftShortcuts = WasmShortcuts.Normalize(null);
        draftSaveFormatIndex = 0;
        draftXmlLanguage = Workspace.XmlLanguages.FirstOrDefault("und");
        draftUiLanguage = "en-US";
        draftOutputTextEncodingIndex = 0;
        draftEmitBom = true;
        draftFrameAccuracyTolerance = 0.15m;
        draftFrameDisplayModeIndex = 0;
        draftFrameDecimalPlaces = "3";
        draftShowRepeatingFrameDecimals = true;
        draftDeleteRowsTimingModeIndex = 0;
        draftThemePresetId = "avalonia-default";
        draftUiFontFamily = "system-ui";
        draftMonospaceFontFamily = "ui-monospace, SFMono-Regular, Menlo, Consolas, monospace";
    }

    private bool SettingsDraftValid => WasmShortcuts.InvalidActions(draftShortcuts).Count == 0
        && int.TryParse(draftFrameDecimalPlaces, NumberStyles.Integer, CultureInfo.InvariantCulture, out var decimals) && decimals is >= 1 and <= 6
        && draftFrameAccuracyTolerance is >= 0.01m and <= 0.30m
        && draftSaveFormatIndex >= 0 && draftSaveFormatIndex < Workspace.SaveFormats.Count
        && draftOutputTextEncodingIndex >= 0 && draftOutputTextEncodingIndex < OutputTextEncodings.All.Count
        && draftFrameDisplayModeIndex is 0 or 1 or 2 && draftDeleteRowsTimingModeIndex is 0 or 1
        && UiLanguages.Any(language => language.Code == draftUiLanguage)
        && Workspace.XmlLanguages.Contains(draftXmlLanguage, StringComparer.OrdinalIgnoreCase)
        && ThemeOptions.Any(option => option.Id == draftThemePresetId);

    private async Task ApplySettingsAsync()
    {
        if (!SettingsDraftValid) return;
        var settings = CreateSettingsDocumentFromDraft();
        var previous = CreateSettingsDocument();
        var persisted = false;
        try
        {
            await Js.InvokeVoidAsync("chapterToolWasm.setLocalStorage", SettingsStorageKey, JsonSerializer.Serialize(settings, SettingsJsonOptions));
            persisted = true;
            await Js.InvokeVoidAsync("chapterToolWasm.applyAppearance", draftThemePresetId, draftUiLanguage, draftUiFontFamily.Trim(), draftMonospaceFontFamily.Trim());
            await Js.InvokeVoidAsync("chapterToolWasm.setShortcutBindings", WasmShortcuts.Bindings(draftShortcuts).Keys.ToArray());
            ApplySettingsToWorkspace(settings);
            CloseDialog();
        }
        catch (JSException)
        {
            if (persisted)
            {
                try
                {
                    await Js.InvokeVoidAsync("chapterToolWasm.setLocalStorage", SettingsStorageKey, JsonSerializer.Serialize(previous, SettingsJsonOptions));
                    await ApplyAppearanceAsync();
                    await SyncShortcutGuardAsync();
                }
                catch (JSException) { }
            }
            settingsError = L.T("Parity.SettingsSaveFailed");
        }
    }

    private void ApplySettingsToWorkspace(WasmSettings settings)
    {
        var application = settings.Application ?? new WasmApplicationSettings();
        var theme = settings.Theme ?? new WasmThemeSettings();
        var font = settings.Font ?? new WasmFontSettings();
        var parsedFormat = Enum.TryParse<ChapterExportFormat>(application.DefaultSaveFormat, true, out var format)
            ? format
            : ChapterExportFormat.Txt;

        defaultSaveFormatIndex = Math.Clamp(ChapterExportFormats.IndexOf(parsedFormat), 0, Math.Max(0, Workspace.SaveFormats.Count - 1));
        if (Workspace.IsChapterGridEmpty) saveFormatIndex = defaultSaveFormatIndex;
        shortcuts = WasmShortcuts.Normalize(settings.Shortcuts);
        xmlLanguage = Workspace.XmlLanguages.Contains(application.DefaultXmlLanguage, StringComparer.OrdinalIgnoreCase)
            ? application.DefaultXmlLanguage
            : Workspace.XmlLanguages.FirstOrDefault("und");
        uiLanguage = UiLanguages.Any(language => string.Equals(language.Code, application.Language, StringComparison.OrdinalIgnoreCase))
            ? application.Language
            : "en-US";
        L.SetCulture(uiLanguage);
        outputTextEncodingIndex = Math.Max(0, OutputTextEncodings.All.ToList().IndexOf(OutputTextEncodings.ParseOrDefault(application.OutputTextEncoding)));
        emitBom = application.EmitBom;
        frameAccuracyTolerance = Math.Clamp(application.FrameAccuracyTolerance <= 0 ? 0.15m : application.FrameAccuracyTolerance, 0.01m, 0.30m);
        showRepeatingFrameDecimals = application.ShowRepeatingFrameDecimals;
        draftFrameDisplayModeIndex = (int)FrameDisplayModes.ParseOrDefault(application.FrameDisplayMode);
        draftFrameDecimalPlaces = FrameDisplayModes.NormalizeDecimalPlaces(application.FrameDecimalPlaces).ToString(CultureInfo.InvariantCulture);
        draftDeleteRowsTimingModeIndex = DeleteRowsTimingModes.ParseOrDefault(application.DeleteRowsTimingMode) == ContractDeleteRowsTimingMode.Preserve ? 0 : 1;
        Workspace.EditingOptions = new ChapterEditingOptions(draftDeleteRowsTimingModeIndex == 0 ? DeleteRowsTimingMode.Preserve : DeleteRowsTimingMode.Normalize, (FrameDisplayMode)draftFrameDisplayModeIndex, FrameDisplayModes.NormalizeDecimalPlaces(application.FrameDecimalPlaces));
        roundFrames = Workspace.RoundFrames = draftFrameDisplayModeIndex == 0;
        themePresetId = ThemeOptions.Any(option => string.Equals(option.Id, theme.PresetId, StringComparison.OrdinalIgnoreCase))
            ? theme.PresetId
            : "avalonia-default";
        uiFontFamily = string.IsNullOrWhiteSpace(font.UiFontFamily) ? "system-ui" : font.UiFontFamily;
        monospaceFontFamily = string.IsNullOrWhiteSpace(font.MonospaceFontFamily)
            ? "ui-monospace, SFMono-Regular, Menlo, Consolas, monospace"
            : font.MonospaceFontFamily;
        PushExportOptions();
        Workspace.ApplyOptionsAndRefresh();
    }

    private async Task PersistSettingsAsync()
    {
        var settings = CreateSettingsDocument();
        await Js.InvokeVoidAsync("chapterToolWasm.setLocalStorage", SettingsStorageKey, JsonSerializer.Serialize(settings, SettingsJsonOptions));
    }

    private WasmSettings CreateSettingsDocumentFromDraft() =>
        new(
            SchemaVersion: 1,
            Application: new WasmApplicationSettings(
                Language: draftUiLanguage,
                DefaultSaveFormat: ChapterExportFormats.AtIndex(draftSaveFormatIndex).ToString(),
                DefaultXmlLanguage: draftXmlLanguage,
                OutputTextEncoding: OutputTextEncodings.Id(OutputTextEncodings.All[Math.Clamp(draftOutputTextEncodingIndex, 0, OutputTextEncodings.All.Count - 1)]),
                EmitBom: draftEmitBom,
                FrameAccuracyTolerance: draftFrameAccuracyTolerance,
                DeleteRowsTimingMode: draftDeleteRowsTimingModeIndex == 0 ? "preserve" : "normalize",
                FrameDisplayMode: FrameDisplayModes.Id((ContractFrameDisplayMode)draftFrameDisplayModeIndex),
                FrameDecimalPlaces: int.TryParse(draftFrameDecimalPlaces, NumberStyles.Integer, CultureInfo.InvariantCulture, out var decimals) ? decimals : 0,
                ShowRepeatingFrameDecimals: draftShowRepeatingFrameDecimals),
            Theme: new WasmThemeSettings(draftThemePresetId),
            Font: new WasmFontSettings(
                UiFontFamily: draftUiFontFamily.Trim() == "system-ui" ? string.Empty : draftUiFontFamily.Trim(),
                MonospaceFontFamily: draftMonospaceFontFamily.Trim() == "ui-monospace, SFMono-Regular, Menlo, Consolas, monospace" ? string.Empty : draftMonospaceFontFamily.Trim()),
            Shortcuts: new ShortcutSettings(draftShortcuts));

    private WasmSettings CreateSettingsDocument() =>
        new(
            SchemaVersion: 1,
            Application: new WasmApplicationSettings(
                Language: uiLanguage,
                DefaultSaveFormat: ChapterExportFormats.AtIndex(defaultSaveFormatIndex).ToString(),
                DefaultXmlLanguage: xmlLanguage,
                OutputTextEncoding: Workspace.OutputTextEncodingId,
                EmitBom: emitBom,
                FrameAccuracyTolerance: frameAccuracyTolerance,
                DeleteRowsTimingMode: Workspace.EditingOptions.DeleteRowsTiming == DeleteRowsTimingMode.Preserve ? "preserve" : "normalize",
                FrameDisplayMode: FrameDisplayModes.Id((ContractFrameDisplayMode)Workspace.EditingOptions.FrameDisplay),
                FrameDecimalPlaces: Workspace.EditingOptions.FrameDecimalPlaces,
                ShowRepeatingFrameDecimals: showRepeatingFrameDecimals),
            Theme: new WasmThemeSettings(themePresetId),
            Font: new WasmFontSettings(
                UiFontFamily: uiFontFamily == "system-ui" ? string.Empty : uiFontFamily,
                MonospaceFontFamily: monospaceFontFamily == "ui-monospace, SFMono-Regular, Menlo, Consolas, monospace" ? string.Empty : monospaceFontFamily),
            Shortcuts: new ShortcutSettings(shortcuts));

