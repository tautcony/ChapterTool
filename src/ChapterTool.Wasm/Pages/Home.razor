    private WasmThemeOption SelectedTheme =>
        ThemeOptions.FirstOrDefault(theme => string.Equals(theme.Id, draftThemePresetId, StringComparison.OrdinalIgnoreCase)) ?? ThemeOptions[0];

    protected override void OnInitialized()
    {
        Workspace.SessionLossConfirmation = ConfirmSessionLossAsync;
        Workspace.Changed += OnWorkspaceChanged;
        L.CultureChanged += OnCultureChanged;
        PullOptionsFromWorkspace();
        Workspace.SetStatusMessage(L.T("Status.Ready"));
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        dropZoneRef = DotNetObjectReference.Create(this);
        try
        {
            await Js.InvokeVoidAsync("chapterToolWasm.registerShortcutGuard");
            await Js.InvokeVoidAsync("chapterToolWasm.registerDropZone", "chaptertool-shell", dropZoneRef, WasmWorkspace.MaxLoadBytes);

            var json = await Js.InvokeAsync<string?>("chapterToolWasm.getLocalStorage", SettingsStorageKey);
            if (string.IsNullOrWhiteSpace(json))
            {
                foreach (var legacyKey in LegacySettingsStorageKeys)
                {
                    var legacyJson = await Js.InvokeAsync<string?>("chapterToolWasm.getLocalStorage", legacyKey);
                    if (!string.IsNullOrWhiteSpace(legacyJson))
                    {
                        json = legacyJson;
                        await Js.InvokeVoidAsync("chapterToolWasm.setLocalStorage", SettingsStorageKey, legacyJson);
                        break;
                    }
                }
            }

            foreach (var legacyKey in LegacySettingsStorageKeys)
            {
                await Js.InvokeVoidAsync("chapterToolWasm.removeLocalStorage", legacyKey);
            }

            if (!string.IsNullOrWhiteSpace(json))
            {
                try
                {
                    var settings = JsonSerializer.Deserialize<WasmSettings>(json, SettingsJsonOptions);
                    if (settings is { SchemaVersion: 1, Application: not null, Theme: not null, Font: not null })
                    {
                        ApplySettingsToWorkspace(settings);
                        await ApplyAppearanceAsync();
                        PullOptionsFromWorkspace();
                        StateHasChanged();
                    }
                    else
                    {
                        await Js.InvokeVoidAsync("chapterToolWasm.removeLocalStorage", SettingsStorageKey);
                    }
                }
                catch (JsonException)
                {
                    await Js.InvokeVoidAsync("chapterToolWasm.removeLocalStorage", SettingsStorageKey);
                }
            }
        }
        catch (JSException)
        {
            // Privacy mode or a missing JavaScript host must not block first render.
        }
        finally
        {
            try { await SyncShortcutGuardAsync(); }
            catch (JSException) { }
            appReady = true;
            await InvokeAsync(StateHasChanged);
        }
    }

    public void Dispose()
    {
        Workspace.Changed -= OnWorkspaceChanged;
        L.CultureChanged -= OnCultureChanged;
        mainExpressionPreviewCancellation?.Cancel();
        mainExpressionPreviewCancellation?.Dispose();
        dropZoneRef?.Dispose();
    }

    [JSInvokable]
    public void OnDragStateChanged(bool over)
    {
        if (activeDialog != DialogKind.None) return;
        if (isDragOver == over)
        {
            return;
        }

        isDragOver = over;
        if (over)
        {
            Workspace.SetStatusMessage(L.T("Status.DropReady"));
        }

        StateHasChanged();
    }

    [JSInvokable]
    public async Task OnBrowserFileDropped(string name, byte[]? bytes)
    {
        if (activeDialog != DialogKind.None) return;
        isDragOver = false;
        CloseContextMenu();
        if (string.IsNullOrWhiteSpace(name) || bytes is null || bytes.Length == 0)
        {
            Workspace.SetStatusMessage(L.T("Status.DropEmpty"));
            Workspace.RecordAction(L.T("Status.DropEmpty"));
            StateHasChanged();
            return;
        }

        if (bytes.LongLength > WasmWorkspace.MaxLoadBytes)
        {
            Workspace.SetStatusMessage(L.T("Status.DropTooLarge"));
            Workspace.RecordAction(L.T("Status.DropTooLarge"));
            StateHasChanged();
            return;
        }

        PushExportOptions();
        PushProjectionOptions();
        await Workspace.LoadAsync(name, bytes);
        PullOptionsFromWorkspace();
        StateHasChanged();
    }

    [JSInvokable]
    public void OnBrowserFileDropRejected(string reason)
    {
        if (activeDialog != DialogKind.None) return;
        isDragOver = false;
        var message = string.Equals(reason, "too-large", StringComparison.OrdinalIgnoreCase)
            ? L.T("Status.DropTooLarge")
            : L.T("Status.DropBlocked");
        Workspace.SetStatusMessage(message);
        Workspace.RecordAction(message);
        StateHasChanged();
    }

    private void OnWorkspaceChanged() => InvokeAsync(() =>
    {
        PullOptionsFromWorkspace();
        StateHasChanged();
    });

    private void OnCultureChanged() => InvokeAsync(StateHasChanged);

    private void PullOptionsFromWorkspace()
    {
        saveFormatIndex = Workspace.SaveFormatIndex;
        chapterNameModeIndex = Workspace.ChapterNameModeIndex;
        orderShift = Workspace.OrderShift;
        xmlLanguage = Workspace.XmlLanguage;
        roundFrames = Workspace.RoundFrames;
        selectedFrameRateIndex = Workspace.SelectedFrameRateIndex;
        outputTextEncodingIndex = OutputTextEncodings.All.ToList().IndexOf(Workspace.TextEncoding);
        emitBom = Workspace.EmitBom;
        frameAccuracyTolerance = Workspace.FrameAccuracyTolerance;
    }

    private void PushExportOptions()
    {
        Workspace.SaveFormatIndex = saveFormatIndex;
        Workspace.XmlLanguage = xmlLanguage;
        Workspace.TextEncoding = OutputTextEncodings.All[Math.Clamp(outputTextEncodingIndex, 0, OutputTextEncodings.All.Count - 1)];
        Workspace.EmitBom = emitBom;
        Workspace.FrameAccuracyTolerance = frameAccuracyTolerance;
    }

    private void PushProjectionOptions()
    {
        Workspace.ChapterNameModeIndex = chapterNameModeIndex;
        Workspace.OrderShift = orderShift;
        Workspace.RoundFrames = roundFrames;
    }

    private async Task OnExportOptionsChanged()
    {
        PushExportOptions();
        StateHasChanged();
        await PersistSettingsAsync();
    }

    private async Task OnProjectionOptionsChanged()
    {
        PushProjectionOptions();
        Workspace.ApplyOptionsAndRefresh();
        await PersistSettingsAsync();
    }

    private async Task OnRoundFramesChanged(ChangeEventArgs args)
    {
        roundFrames = args.Value is bool b
            ? b
            : string.Equals(args.Value?.ToString(), "true", StringComparison.OrdinalIgnoreCase);
        Workspace.RoundFrames = roundFrames;
        Workspace.ApplyOptionsAndRefresh();
        await PersistSettingsAsync();
    }

    private async Task OnFrameRateChanged(ChangeEventArgs args)
    {
        if (int.TryParse(args.Value?.ToString(), out var index))
        {
            selectedFrameRateIndex = index;
            Workspace.PreferredFrameRateIndex = index;
            Workspace.SelectedFrameRateIndex = index;
            await PersistSettingsAsync();
        }
    }

    private async Task TriggerLoad()
