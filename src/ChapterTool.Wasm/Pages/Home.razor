    private void CloseDialog() => activeDialog = DialogKind.None;

    private async Task ApplyExportOptionsAsync(ExportOptionsDraft draft)
    {
        xmlLanguage = draft.XmlLanguage;
        outputTextEncodingIndex = draft.EncodingIndex;
        emitBom = draft.EmitBom;
        PushExportOptions();
        PullOptionsFromWorkspace();
        await PersistSettingsAsync();
        CloseDialog();
    }

    private async Task UndoHistoryAsync() => await Workspace.UndoAsync();

    private async Task RedoHistoryAsync() => await Workspace.RedoAsync();

    private void RefreshRows()
    {
        PushExportOptions();
        PushProjectionOptions();
        Workspace.RefreshRows();
    }

    private bool ShowMainExpressionCandidate => !mainExpressionPreviewPending
        && !Workspace.IsExpressionPreviewStale
        && Workspace.ExpressionPreview is { IsValid: true }
        && Workspace.ExpressionPreviewProjection is { HasChanges: true };

    private ExpressionChapterComparison? ExpressionComparison(ChapterRowModel row) =>
        Workspace.ExpressionPreviewProjection?.Chapters.FirstOrDefault(item => item.Id == row.Id);

    private string FormatExpressionDelta(long? ticks)
    {
        if (ticks is null)
        {
            return L.T("Expression.Value.Missing");
        }

        var value = Workspace.FormatExpressionTimeTicks(Math.Abs(ticks.Value));
        return ticks > 0 ? "+" + value : ticks < 0 ? "−" + value : value;
