    private async Task OnKeyDownAsync(KeyboardEventArgs args)
    {
        if (activeDialog != DialogKind.None) return;
        bool typing;
        try
        {
            typing = await Js.InvokeAsync<bool>("chapterToolWasm.isEditableTarget");
        }
        catch (JSException)
        {
            typing = false;
        }

        if (typing)
        {
            return;
        }

        var gesture = WasmShortcuts.Gesture(args.Key, args.CtrlKey, args.AltKey, args.MetaKey, args.ShiftKey);
        var action = WasmShortcuts.Bindings(shortcuts).GetValueOrDefault(gesture);
        switch (action)
        {
            case ShortcutCatalog.LoadId: await TriggerLoad(); break;
            case ShortcutCatalog.SaveId: await SaveAsync(); break;
            case ShortcutCatalog.ReloadId: await ReloadAsync(); break;
            case ShortcutCatalog.PreviewId: await PreviewAsync(); break;
            case ShortcutCatalog.LogId: OpenLogs(); break;
            case ShortcutCatalog.UndoId: await Workspace.UndoAsync(); break;
            case ShortcutCatalog.RedoId: await Workspace.RedoAsync(); break;
            case ShortcutCatalog.InsertId:
                if (Workspace.CanRefreshRows) Workspace.InsertBefore(Math.Max(0, Workspace.SelectedRowIndex));
                break;
            case ShortcutCatalog.DeleteId: Workspace.DeleteSelectedRows(); break;
            case ShortcutCatalog.PreviousClipId: Workspace.SelectAdjacentClip(-1); break;
            case ShortcutCatalog.NextClipId: Workspace.SelectAdjacentClip(1); break;
            case "refresh-rows": RefreshRows(); break;
        }
    }

