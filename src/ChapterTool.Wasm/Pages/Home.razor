                        <label for="settings-ui-font">@L.T("Settings.Appearance.UiFont")</label>
                        <div class="font-setting">
                            <select id="settings-ui-font" @bind="_draftUiFontFamily" @bind:after="ApplySettingsDraftAsync">
                                @foreach (var font in UiFontOptions)
                                {
                                    <option value="@font.Value">@font.Name</option>
                                }
                            </select>
                            <div class="font-preview" style="font-family:@_draftUiFontFamily">ChapterTool UI preview</div>
                        </div>
                        <label for="settings-mono-font">@L.T("Settings.Appearance.MonospaceFont")</label>
                        <div class="font-setting">
                            <select id="settings-mono-font" @bind="_draftMonospaceFontFamily" @bind:after="ApplySettingsDraftAsync">
                                @foreach (var font in MonospaceFontOptions)
                                {
                                    <option value="@font.Value">@font.Name</option>
                                }
                            </select>
                            <div class="font-preview mono-preview" style="font-family:@_draftMonospaceFontFamily">00:00:00.000  Chapter</div>
