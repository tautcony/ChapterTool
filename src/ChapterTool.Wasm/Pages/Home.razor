                        <label>@L.T("Settings.EmitBom")</label>
                        <label class="settings-check"><input type="checkbox" data-testid="settings-emit-bom" @bind="draftEmitBom" /> @L.T("Settings.EmitBomLabel")</label>
                    </div>
                }
                else if (settingsTab == 3)
                {
                    <h3>@L.T("Settings.Editing")</h3>
                    <div class="settings-grid">
                        <label for="settings-tolerance">@L.T("Settings.Tolerance")</label>
                        <div class="range-setting"><input id="settings-tolerance" type="range" min="0.01" max="0.30" step="0.01" @bind="draftFrameAccuracyTolerance" /><output>@draftFrameAccuracyTolerance.ToString("0.##")</output></div>
                        <label for="settings-frame-display">@L.T("Settings.FrameDisplay")</label>
                        <div class="settings-inline">
                            <select id="settings-frame-display" @bind="draftFrameDisplayModeIndex"><option value="0">@L.T("Settings.FrameDisplayRound")</option><option value="1">@L.T("Settings.FrameDisplayDecimalPlaces")</option><option value="2">@L.T("Settings.FrameDisplayFullPrecision")</option></select>
                            @if (draftFrameDisplayModeIndex == 1)
                            {
                                <label for="settings-frame-decimals">@L.T("Settings.FrameDecimalPlaces")</label>
                                <input id="settings-frame-decimals" type="number" min="1" max="6" step="1" @bind="draftFrameDecimalPlaces" @bind:event="oninput" aria-invalid="@(!SettingsDraftValid ? "true" : "false")" />
                            }
                        </div>
                        <label for="settings-repeating-frame-decimals">@L.T("Settings.ShowRepeatingFrameDecimals")</label>
                        <div>
                            <label class="settings-check">
                                <input id="settings-repeating-frame-decimals" type="checkbox" data-testid="settings-repeating-frame-decimals" @bind="draftShowRepeatingFrameDecimals" disabled="@(draftFrameDisplayModeIndex != 2)" />
                            </label>
                            <small>@L.T("Settings.ShowRepeatingFrameDecimals.Help")</small>
                        </div>
                        <label for="settings-delete-timing">@L.T("Settings.DeleteRowsTiming")</label>
                        <select id="settings-delete-timing" @bind="draftDeleteRowsTimingModeIndex">
                            <option value="0">@L.T("Settings.PreserveChapterTimes")</option>
                            <option value="1">@L.T("Settings.NormalizeChapterTimes")</option>
                        </select>
                    </div>
                }
                else if (settingsTab == 4)
                {
                    <h3>@L.T("Settings.Appearance")</h3>
                    <div class="settings-grid">
                        <label for="settings-theme">@L.T("Settings.Preset")</label>
                        <select id="settings-theme" @bind="draftThemePresetId">
                            @foreach (var theme in ThemeOptions)
                            {
                                <option value="@theme.Id">@theme.DisplayName</option>
                            }
                        </select>
                        <label>@L.T("Settings.Preview")</label>
                        <div class="theme-swatches">
                            @foreach (var swatch in SelectedTheme.PreviewSwatches)
                            {
                                <span style="background:@swatch" title="@swatch"></span>
                            }
                        </div>
                        <label for="settings-ui-font">@L.T("Settings.Appearance.UiFont")</label>
                        <div class="font-setting">
                            <select id="settings-ui-font" @bind="draftUiFontFamily">
                                @foreach (var font in UiFontOptions)
                                {
                                    <option value="@font.Value">@font.Name</option>
                                }
                            </select>
                            <div class="font-preview" style="font-family:@draftUiFontFamily">ChapterTool UI preview</div>
                        </div>
                        <label for="settings-mono-font">@L.T("Settings.Appearance.MonospaceFont")</label>
                        <div class="font-setting">
                            <select id="settings-mono-font" @bind="draftMonospaceFontFamily">
                                @foreach (var font in MonospaceFontOptions)
                                {
                                    <option value="@font.Value">@font.Name</option>
                                }
                            </select>
                            <div class="font-preview mono-preview" style="font-family:@draftMonospaceFontFamily">00:00:00.000  Chapter</div>
                        </div>
                    </div>
                }
                else if (settingsTab == 5)
                {
                    <h3>@L.T("Settings.Shortcuts")</h3>
                    <ShortcutSettingsEditor Draft="@draftShortcuts" OnChanged="StateHasChanged" />
                }
                else
                {
                    <h3>@L.T("Settings.About")</h3>
                    <div class="about-body">
                        <p>@L.T("Settings.AboutBody")</p>
                        <p class="settings-note">@L.T("Settings.AboutRuntime")</p>
                        <p class="settings-note">@L.T("Settings.AboutLicense")</p>
                        <a href="https://github.com/tautcony/ChapterTool" target="_blank" rel="noreferrer">github.com/tautcony/ChapterTool</a>
                    </div>
                }
            </div>
            @if (settingsError is not null) { <p class="settings-note" role="alert">@settingsError</p> }
            <footer class="modal-footer">
                <button type="button" class="secondary" @onclick="ResetSettings">@L.T("Action.RestoreDefaults")</button>
                <span class="modal-spacer"></span>
                <button type="button" class="secondary" data-testid="settings-cancel" @onclick="CancelSettings">@L.T("Common.Cancel")</button>
                <button type="button" class="secondary" disabled="@(!SettingsDraftValid)" data-testid="settings-apply" @onclick="ApplySettingsAsync">@L.T("Common.Save")</button>
            </footer>
    </WasmDialog>
}

@if (activeDialog == DialogKind.History)
{
    <HistoryDialog OnClose="CloseDialog" />
}
@if (activeDialog == DialogKind.Expression)
{
    <ExpressionDialog OnClose="CloseDialog" />
}
@if (activeDialog == DialogKind.ExportOptions)
{
    <ExportOptionsDialog OnClose="CloseDialog" OnApply="ApplyExportOptionsAsync" />
}

@code {
