        await Js.InvokeVoidAsync("chapterToolWasm.click", "loadFileInput");
    }

    private async Task TriggerAppendMpls()
    {
        CloseContextMenu();
        await Js.InvokeVoidAsync("chapterToolWasm.click", "appendMplsInput");
    }

    private async Task OnFileSelected(InputFileChangeEventArgs args)
    {
        var file = args.File;

        await LoadFileAsync(file);
    }

    private async Task OnAppendMplsSelected(InputFileChangeEventArgs args)
    {
        var file = args.File;

        await AppendMplsFileAsync(file);
    }

    private async Task LoadFileAsync(IBrowserFile file)
    {
        try
        {
            if (file.Size is < 0 or > WasmWorkspace.MaxLoadBytes)
            {
                throw new IOException();
            }

            await using var stream = file.OpenReadStream(maxAllowedSize: WasmWorkspace.MaxLoadBytes);
            var bytes = new byte[file.Size];
            var read = 0;
            while (read < bytes.Length)
            {
                var n = await stream.ReadAsync(bytes.AsMemory(read));
                if (n == 0)
                {
                    break;
                }

                read += n;
            }

            if (read < bytes.Length)
            {
                Array.Resize(ref bytes, read);
            }

            PushExportOptions();
            PushProjectionOptions();
            await Workspace.LoadAsync(file.Name, bytes);
            PullOptionsFromWorkspace();
        }
        catch (IOException)
        {
            Workspace.SetStatusMessage(L.T("Status.DropTooLarge"));
            Workspace.RecordAction(L.T("Status.DropTooLarge"));
        }
        catch (Exception ex)
        {
            Workspace.SetStatusMessage(ex.Message);
            await Js.InvokeVoidAsync("console.error", ex.Message);
        }
    }

    private async Task AppendMplsFileAsync(IBrowserFile file)
    {
        try
        {
            if (file.Size is < 0 or > WasmWorkspace.MaxLoadBytes)
            {
                throw new IOException();
            }

            await using var stream = file.OpenReadStream(maxAllowedSize: WasmWorkspace.MaxLoadBytes);
            using var memory = new MemoryStream();
            await stream.CopyToAsync(memory);
            PushExportOptions();
            PushProjectionOptions();
            await Workspace.AppendMplsAsync(file.Name, memory.ToArray());
            PullOptionsFromWorkspace();
        }
        catch (Exception ex)
        {
            Workspace.SetStatusMessage(ex.Message);
            Workspace.RecordAction(ex.Message);
        }
    }

    private async Task LoadSampleAsync()
    {
        PushExportOptions();
        PushProjectionOptions();
        await Workspace.LoadSampleAsync();
        PullOptionsFromWorkspace();
