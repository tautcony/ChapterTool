    private async Task OnMainExpressionInput(ChangeEventArgs args)
    {
        mainExpressionPreviewCancellation?.Cancel();
        mainExpressionPreviewCancellation?.Dispose();
        Workspace.CancelExpressionPreview();
        Workspace.Expression = args.Value?.ToString() ?? string.Empty;
        if (string.IsNullOrWhiteSpace(Workspace.Expression) || Workspace.IsChapterGridEmpty)
        {
            mainExpressionPreviewPending = false;
            return;
        }

        var cancellation = mainExpressionPreviewCancellation = new CancellationTokenSource();
        mainExpressionPreviewPending = true;
        try
        {
            await Task.Delay(250, cancellation.Token);
            if (!cancellation.IsCancellationRequested)
            {
                Workspace.PrepareExpressionPreview(Workspace.Expression);
                mainExpressionPreviewPending = false;
            }
        }
        catch (OperationCanceledException) when (cancellation.IsCancellationRequested)
        {
        }
        if (!cancellation.IsCancellationRequested)
        {
            await InvokeAsync(StateHasChanged);
        }
    }

    private void OpenExpressionDialog()
    {
        mainExpressionPreviewCancellation?.Cancel();
        mainExpressionPreviewPending = false;
        if (!string.IsNullOrWhiteSpace(Workspace.Expression) && !Workspace.IsChapterGridEmpty)
        {
            Workspace.PrepareExpressionPreview(Workspace.Expression);
        }
        OpenDialog(DialogKind.Expression);
    }

    private async Task LoadMainExpressionScriptAsync(InputFileChangeEventArgs args)
    {
        try
        {
            await using var stream = args.File.OpenReadStream(2 * 1024 * 1024);
            using var reader = new StreamReader(stream, new UTF8Encoding(false, true), true);
            var script = await reader.ReadToEndAsync();
            Workspace.ClearExpressionPresetSelection();
            Workspace.ExpressionSourceName = args.File.Name;
            await OnMainExpressionInput(new ChangeEventArgs { Value = script });
        }
        catch (Exception exception) when (exception is IOException or DecoderFallbackException)
        {
            Workspace.SetStatusMessage(L.T("Parity.ScriptLoadFailed"));
        }
    }

    private async Task ApplyMainExpressionPreviewAsync()
    {
        if (!ShowMainExpressionCandidate || Workspace.IsBusy)
