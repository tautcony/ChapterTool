@page "/"
@implements IDisposable
@using System.Text
@using System.Text.Json
@using System.Globalization
@using DeleteRowsTimingModes = ChapterTool.Contracts.Configuration.DeleteRowsTimingModes
@using ContractDeleteRowsTimingMode = ChapterTool.Contracts.Configuration.DeleteRowsTimingMode
@using FrameDisplayModes = ChapterTool.Contracts.Configuration.FrameDisplayModes
@using ContractFrameDisplayMode = ChapterTool.Contracts.Configuration.FrameDisplayMode
@using ChapterTool.Core.Editing
@using ChapterTool.Core.Models
@using ChapterTool.Core.Session
@using ChapterTool.Core.Transform
@using ChapterTool.Contracts.Shortcuts
@inject WasmWorkspace Workspace
@inject WasmLocalizer L
@inject IJSRuntime Js

<PageTitle>@L.T("App.Title")</PageTitle>

<div id="chaptertool-shell"
     class="shell @(_isDragOver ? "drag-over" : null)"
     data-app-ready="@(_appReady ? "true" : "false")"
     aria-busy="@(_appReady ? "false" : "true")"
     tabindex="0"
     @onkeydown="OnKeyDownAsync"
     @onclick="OnShellClick">
    <div class="main">
    @{
        var mainOptionsProjection = Workspace.MainOptionsPreviewProjection;
        var mainOptionsComparisons = mainOptionsProjection?.Chapters.ToDictionary(comparison => comparison.Id);
        var preserveMainOptionsCandidateInExpressionDialog = _activeDialog == DialogKind.Expression
            && _mainOptionsCandidateAtExpressionOpen;
        var showMainOptionsCandidate = !_mainExpressionPreviewPending
            && (!Workspace.IsMainOptionsPreviewStale || preserveMainOptionsCandidateInExpressionDialog)
            && Workspace.MainOptionsPreview is { IsValid: true }
            && mainOptionsProjection is { HasChanges: true };
        var mainOptionsStateVisible = _activeDialog != DialogKind.Expression;
        var mainOptionsInvalid = mainOptionsStateVisible && !_mainExpressionPreviewPending
            && !Workspace.IsMainOptionsPreviewStale && Workspace.MainOptionsPreview is { IsValid: false };
        var mainOptionsErrors = mainOptionsInvalid ? string.Join("\n", Workspace.MainOptionsPreview!.Errors) : null;
        var mainOptionsActionsVisible = mainOptionsStateVisible
            && (_mainExpressionPreviewPending || Workspace.MainOptionsPreview is not null);
    }

        <!-- Top: load/save + clip + frame tools (Avalonia zone) -->
        <div class="top-bar">
            <div class="top-actions">
                <div class="load-group" @onclick:stopPropagation>
                    <button type="button"
                            class="primary"
                            disabled="@Workspace.IsBusy"
                            @onclick="TriggerLoad"
                            @oncontextmenu="OpenLoadContextMenu"
                            @oncontextmenu:preventDefault
                            title="@ShortcutHint(ShortcutCatalog.LoadId, L.T("Title.Load"))">
                        @L.T("Action.Load")
                    </button>
                    <button id="load-menu-toggle" type="button" class="secondary load-menu-toggle" data-testid="load-menu-toggle" aria-label="@L.T("Main.LoadTooltip")"
                            aria-haspopup="menu" aria-controls="load-menu" aria-expanded="@(_loadMenuOpen ? "true" : "false")" @onclick="ToggleLoadMenu"><span aria-hidden="true">▾</span></button>
                    @if (_loadMenuOpen)
                    {
                        <div id="load-menu" class="load-menu" role="menu" aria-label="@L.T("Action.Load")" @onkeydown="OnLoadMenuKeyDown">
                            <button type="button" role="menuitem" disabled="@(!Workspace.CanReload)"
                                    title="@ShortcutHint(ShortcutCatalog.ReloadId, L.T("Action.Reload"))" @onclick="ReloadAsync">@L.T("Action.Reload")</button>
                            <button type="button" role="menuitem" disabled="@(!Workspace.CanAppendMpls)" @onclick="TriggerAppendMpls">@L.T("Action.AppendMpls")</button>
                        </div>
                    }
                </div>
                <button type="button"
                        class="primary"
                        disabled="@(!Workspace.CanSave)"
                        @onclick="SaveAsync"
                        title="@ShortcutHint(ShortcutCatalog.SaveId, L.T("Title.Save"))">
                    @L.T("Common.Save")
                </button>
                <button type="button" class="secondary history-action" disabled="@(!Workspace.HasHistory)"
                        @onclick="ToggleHistory" aria-haspopup="dialog">@L.T("History.Title")</button>
                <InputFile id="loadFileInput"
                           class="hidden-file"
                           OnChange="OnFileSelected"
                           accept=".txt,.vtt,.xml,.cue,.mpls,.ifo,.xpl,.flac,.tak,.csv,text/*,application/xml,application/octet-stream" />
                <InputFile id="appendMplsInput"
                           class="hidden-file"
                           OnChange="OnAppendMplsSelected"
                           accept=".mpls,application/octet-stream" />
            </div>

            <div class="top-clip">
                @if (Workspace.IsClipSelectionVisible)
                {
                    <select class="clip-box"
                            value="@Workspace.SelectedClipId"
                            disabled="@Workspace.IsBusy"
                            @onchange="OnClipChanged"
                            @oncontextmenu="OpenClipContextMenu"
                            @oncontextmenu:preventDefault
                            title="@L.T("Label.Clip")">
                        @foreach (var clip in Workspace.ClipOptions)
                        {
                            <option value="@clip.Id">@clip.DisplayText</option>
                        }
                    </select>
                }
            </div>

            <div class="top-tools">
                <div class="top-tool-actions">
                    <label class="check">
                        <input type="checkbox"
                               checked="@_roundFrames"
                               disabled="@(Workspace.IsBusy || Workspace.IsChapterGridEmpty)"
                               @onchange="OnRoundFramesChanged" />
                        @L.T("Label.RoundFrames")
                    </label>
                    <button type="button"
                            class="icon-button tool-icon-button"
                            disabled="@(!Workspace.CanPreview)"
                            @onclick="PreviewAsync"
                            title="@ShortcutHint(ShortcutCatalog.PreviewId, L.T("Title.Preview"))"
                            aria-label="@L.T("Action.Preview")">
                        <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                            <path d="M2 12s3.5-6 10-6 10 6 10 6-3.5 6-10 6S2 12 2 12Z" />
                            <circle cx="12" cy="12" r="2.75" />
                        </svg>
                    </button>
                    <button type="button"
                            class="icon-button tool-icon-button"
                            disabled="@(!Workspace.CanRefreshRows)"
                            @onclick="RefreshRows"
                            title="@L.T("Title.Refresh")"
                            aria-label="@L.T("Action.Refresh")">
                        <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                            <path d="M20 11a8 8 0 0 0-14.9-3.9L3 9" />
                            <path d="M3 4v5h5" />
                            <path d="M4 13a8 8 0 0 0 14.9 3.9L21 15" />
                            <path d="M21 20v-5h-5" />
                        </svg>
                    </button>
                    <button type="button"
                            class="icon-button"
                            data-testid="settings-open"
                            @onclick="OpenSettings"
                            title="@L.T("Action.Settings")"
                            aria-label="@L.T("Action.Settings")">
                        <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                            <path d="M12 8.5a3.5 3.5 0 1 0 0 7 3.5 3.5 0 0 0 0-7Z" />
                            <path d="M12.22 2h-.44a2 2 0 0 0-2 2v.18a2 2 0 0 1-1 1.73l-.43.25a2 2 0 0 1-2 0l-.15-.08a2 2 0 0 0-2.73.73l-.22.38a2 2 0 0 0 .73 2.73l.15.09a2 2 0 0 1 1 1.74v.5a2 2 0 0 1-1 1.74l-.15.09a2 2 0 0 0-.73 2.73l.22.38a2 2 0 0 0 2.73.73l.15-.08a2 2 0 0 1 2 0l.43.25a2 2 0 0 1 1 1.73V20a2 2 0 0 0 2 2h.44a2 2 0 0 0 2-2v-.18a2 2 0 0 1 1-1.73l.43-.25a2 2 0 0 1 2 0l.15.08a2 2 0 0 0 2.73-.73l.22-.38a2 2 0 0 0-.73-2.73l-.15-.09a2 2 0 0 1-1-1.74v-.5a2 2 0 0 1 1-1.74l.15-.09a2 2 0 0 0 .73-2.73l-.22-.38a2 2 0 0 0-2.73-.73l-.15.08a2 2 0 0 1-2 0l-.43-.25a2 2 0 0 1-1-1.73V4a2 2 0 0 0-2-2Z" />
                        </svg>
                    </button>
                </div>
                <div class="fps-controls">
                    <select class="fps-box"
                            value="@_selectedFrameRateIndex"
                            disabled="@(Workspace.IsBusy || Workspace.IsChapterGridEmpty)"
                            @onchange="OnFrameRateChanged"
                            @oncontextmenu="OpenFrameRateContextMenu"
                            @oncontextmenu:preventDefault
                            title="@L.T("Label.FrameRate")">
                        @if (Workspace.FrameRateChoices.Count == 0)
                        {
                            <option value="0">—</option>
                        }
                        else
                        {
                            @foreach (var choice in Workspace.FrameRateChoices)
                            {
                                <option value="@choice.Index">@choice.DisplayName</option>
                            }
                        }
                    </select>
                    <button type="button"
                            class="icon-button tool-icon-button"
                            disabled="@(Workspace.IsBusy || Workspace.IsChapterGridEmpty || !Workspace.CanChangeSelectedFrameRate)"
                            @onclick="ChangeFrameRateContext"
                            title="@L.T("Menu.ChangeFps")"
                            aria-label="@L.T("Menu.ChangeFps")">
                        <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                            <path d="M3 12h3l2-7 4 14 2-7h7" />
                        </svg>
                    </button>
                </div>
            </div>
        </div>

        <!-- Center: chapter grid -->
        <div class="grid-zone">
            @if (!string.IsNullOrEmpty(Workspace.SourcePath))
            {
                <div class="path-line" title="@Workspace.SourcePath">
                    @Workspace.SourcePath
                    @if (Workspace.FramesPerSecond > 0)
                    {
                        <span class="path-fps"> · @Workspace.FramesPerSecondDisplay fps</span>
                    }
                </div>
            }

            <div class="grid-wrap">
                @if (Workspace.IsChapterGridEmpty)
                {
                    <div class="empty-state">
                        <div class="empty-icon">∅</div>
                        <p>@L.T("Empty.Title")</p>
                        <p class="hint">@L.T("Empty.Hint")</p>
                        <button type="button" class="secondary" disabled="@Workspace.IsBusy" @onclick="LoadSampleAsync">
                            @L.T("Action.LoadSample")
                        </button>
                    </div>
                }
                else
                {
                    <table class="chapter-grid" aria-label="@L.T("Grid.TableLabel")">
                        <thead>
                        <tr>
                            <th class="col-num">@L.T("Grid.Number")</th>
                            <th class="col-time">@L.T("Grid.Time")</th>
                            <th class="col-name">@L.T("Grid.Name")</th>
                            <th class="col-frames">@L.T("Grid.Frames")</th>
                        </tr>
                        </thead>
                        <tbody>
                        @for (var i = 0; i < Workspace.Rows.Count; i++)
                        {
                            var index = i;
                            var row = Workspace.Rows[i];
                            var optionsComparison = mainOptionsComparisons?.GetValueOrDefault(row.Id);
                            var showOptionsCandidate = showMainOptionsCandidate;
                            <tr @key="row.Id" tabindex="0" class="@(row.IsSeparator ? "separator" : null) @(Workspace.IsRowSelected(index) ? "selected" : null)"
                                @onclick="e => OnRowClick(index, e)"
                                @oncontextmenu="e => OpenContextMenu(index, e)"
                                @oncontextmenu:preventDefault>
                                <td class="col-num">
                                    @if (showOptionsCandidate && optionsComparison is { Before: not null, Candidate: not null } numberChange
                                        && numberChange.Before.DisplayNumber != numberChange.Candidate.DisplayNumber)
                                    { <span class="expression-cell-preview"><span>@numberChange.Before.DisplayNumber</span><span aria-hidden="true"> → </span><strong>@numberChange.Candidate.DisplayNumber</strong></span> }
                                    else { @(row.IsSeparator ? "—" : row.Number.ToString()) }
                                </td>
                                <td class="col-time">
                                    @if (row.IsSeparator)
                                    {
                                        <span></span>
                                    }
                                    else if (showOptionsCandidate && optionsComparison is { Before: not null, Candidate: not null } timeChange
                                        && (timeChange.Changes & ExpressionChapterChangeKind.Time) != 0)
                                    {
                                        <span class="expression-cell-preview time-expression-preview"><span>@Workspace.FormatExpressionTimeTicks(timeChange.Before.StartTicks)</span><span aria-hidden="true"> → </span><strong>@Workspace.FormatExpressionTimeTicks(timeChange.Candidate.StartTicks)</strong><span class="expression-delta">(@FormatExpressionDelta(timeChange.DeltaTicks))</span></span>
                                    }
                                    else
                                    {
                                        <ChapterCellEditor Index="@index" Field="ChapterCellField.StartTime" Value="@row.TimeText" Label="@($"{L.T("Grid.Time")} {index + 1}")" Disabled="@(Workspace.IsBusy || showOptionsCandidate)" />
                                    }
                                </td>
                                <td class="col-name">
                                    @if (showOptionsCandidate && optionsComparison is { Before: not null, Candidate: not null } nameChange
                                        && nameChange.Before.Name != nameChange.Candidate.Name)
                                    { <span class="expression-cell-preview"><span>@nameChange.Before.Name</span><span aria-hidden="true"> → </span><strong>@nameChange.Candidate.Name</strong></span> }
                                    else { <ChapterCellEditor Index="@index" Field="ChapterCellField.Name" Value="@row.Name" Label="@($"{L.T("Grid.Name")} {index + 1}")" Disabled="@(Workspace.IsBusy || showOptionsCandidate)" /> }
                                </td>
                                <td class="col-frames">
                                    @if (!row.IsSeparator && Workspace.FramesPerSecond > 0)
                                    {
                                        @if (showOptionsCandidate && optionsComparison is { CandidateFrames: not null } framesChange
                                            && (framesChange.Changes & ExpressionChapterChangeKind.FrameInformation) != 0
                                            && !string.Equals(framesChange.BeforeFrames?.Text, framesChange.CandidateFrames.Text, StringComparison.Ordinal))
                                        {
                                            var beforeParts = Workspace.FormatPreviewFramePresentation(framesChange, candidate: false, _showRepeatingFrameDecimals);
                                            var candidateParts = Workspace.FormatPreviewFramePresentation(framesChange, candidate: true, _showRepeatingFrameDecimals);
                                            var candidateFrameAccuracy = Workspace.GetPreviewFrameAccuracy(framesChange.Candidate!.StartTicks);
                                            <span class="expression-cell-preview frame-text frame-expression-preview">
                                                <FrameValueView Value="beforeParts" CssClass="@($"frame-text {(row.IsFrameAccurate ? "accurate" : row.IsFrameInexact ? "inexact" : "neutral")}")"
                                                                AccessibleName="@FrameAccessibleName(L.T("Expression.Preview.BeforeFrames"), beforeParts)" />
                                                <span aria-hidden="true">→</span>
                                                <FrameValueView Value="candidateParts" CssClass="@($"frame-text {(candidateFrameAccuracy == FrameAccuracy.Accurate ? "accurate" : candidateFrameAccuracy == FrameAccuracy.Inexact ? "inexact" : "neutral")}")"
                                                                AccessibleName="@FrameAccessibleName(L.T("Expression.Preview.CandidateFrames"), candidateParts)" />
                                            </span>
                                        }
                                        else
                                        {
                                            <ChapterCellEditor Index="@index" Field="ChapterCellField.Frame" Value="@row.FramesInfo"
                                                               Label="@($"{L.T("Grid.Frames")} {index + 1}")"
                                                               CssClass="@($"frame-text {(row.IsFrameAccurate ? "accurate" : row.IsFrameInexact ? "inexact" : "neutral")}")"
                                                               DisplayPresentation="@Workspace.FormatRowFramePresentation(index, row.FramesInfo, _showRepeatingFrameDecimals)"
                                                               Disabled="@(Workspace.IsBusy || showOptionsCandidate)" />
                                        }
                                    }
                                    else { <span class="frame-text">—</span> }
                                </td>
                            </tr>
                        }
                        </tbody>
                    </table>
                }
            </div>
        </div>

        <!-- Bottom: compact export controls and independent tool actions -->
        <div class="options-zone" data-automation-id="AdvancedOptions">
            <div class="option-cell option-format">
                <label class="option-label" for="saveFormat">@L.T("Label.Format")</label>
                <select id="saveFormat"
                        @bind="_saveFormatIndex"
                        @bind:after="OnExportOptionsChanged"
                        disabled="@Workspace.IsBusy">
                    @foreach (var format in Workspace.SaveFormats)
                    {
                        <option value="@format.Index">@format.DisplayName</option>
                    }
                </select>
            </div>

            <div class="option-cell option-name-mode">
                <label class="option-label" for="nameMode">@L.T("Label.ChapterName")</label>
                <div class="name-mode-controls">
                    <select id="nameMode"
                            @bind="_chapterNameModeIndex"
                            @bind:after="OnProjectionOptionsChanged"
                            disabled="@Workspace.IsBusy">
                        @for (var i = 0; i < L.ChapterNameModes.Count; i++)
                        {
                            <option value="@i">@L.ChapterNameModes[i]</option>
                        }
                    </select>
                    <InputFile id="chapter-name-template-input" class="hidden-file" OnChange="OnChapterNameTemplateSelected" accept=".txt,text/plain" />
                    <button type="button" class="icon-button template-button" aria-label="@L.T("Main.TemplateFile")"
                            title="@(Workspace.ChapterNameTemplateStatus ?? L.T("Main.TemplateFile"))" disabled="@Workspace.IsBusy"
                            @onclick="TriggerTemplateLoad">
                        <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M3 5h7l2 2h9v12H3z"/><path d="M12 10v6m-3-3h6"/></svg>
                    </button>
                </div>
            </div>

            <div class="option-cell option-xml-language">
                <label class="option-label" for="main-xml-language">@L.T("Main.XmlLanguage")</label>
                <select id="main-xml-language" value="@_xmlLanguage" disabled="@(Workspace.IsBusy || !Workspace.IsXmlLanguageEnabled)" @onchange="OnXmlLanguageChanged">
                    @foreach (var language in Workspace.XmlLanguages)
                    {
                        <option value="@language">@Workspace.XmlLanguageName(language)</option>
                    }
                </select>
            </div>

            <div class="option-cell option-order-shift">
                <label class="option-label" for="main-order-shift">@L.T("Main.OrderShift")</label>
                <input id="main-order-shift" type="number" min="0" max="1000" step="1" value="@_orderShift"
                       disabled="@Workspace.IsBusy" @oninput="OnOrderShiftChanged" />
            </div>

            <div class="option-tools">
                <button type="button" class="secondary" aria-haspopup="dialog" disabled="@(!Workspace.CanRefreshRows)" @onclick="OpenNaming">@L.T("Parity.NamingTitle")</button>
                <button type="button" class="secondary" aria-haspopup="dialog" disabled="@Workspace.IsBusy" @onclick="() => OpenDialog(DialogKind.ExportOptions)">@L.T("Modal.ExportOptionsTitle")</button>
            </div>
            <section class="inline-expression" aria-label="@L.T("Expression.Preview.Title")">
                <label for="main-expression-editor">@L.T("Label.Expression")</label>
                <div class="inline-expression-editor @(mainOptionsInvalid ? "has-diagnostics" : null)">
                    <textarea id="main-expression-editor" value="@Workspace.Expression" aria-label="@L.T("Label.Expression")"
                              aria-invalid="@(mainOptionsInvalid ? "true" : "false")"
                              aria-describedby="@(mainOptionsInvalid ? "main-expression-diagnostics" : null)"
                              aria-busy="@(_mainExpressionPreviewPending ? "true" : "false")"
                              disabled="@Workspace.IsBusy" @oninput="OnMainExpressionInput"></textarea>
                    @if (mainOptionsInvalid)
                    {
                        <div id="main-expression-diagnostics" role="alert" class="inline-expression-diagnostics">@mainOptionsErrors</div>
                    }
                    <span class="expression-state-announcement" role="status" aria-live="polite">
                        @(mainOptionsStateVisible && _mainExpressionPreviewPending ? L.T("Expression.Preview.Pending")
                            : mainOptionsStateVisible && Workspace.IsMainOptionsPreviewStale ? L.T("Expression.State.Stale") : null)
                    </span>
                </div>
                <InputFile id="main-expression-script" class="hidden-file" aria-label="@L.T("Tool.Expression.LoadLuaScript")"
                           OnChange="LoadMainExpressionScriptAsync" accept=".lua,text/*" disabled="@Workspace.IsBusy" />
                <button type="button" class="icon-button expression-script-button" aria-label="@L.T("Tool.Expression.LoadLuaScript")"
                        title="@L.T("Tool.Expression.LoadLuaScript")" disabled="@Workspace.IsBusy" @onclick="TriggerExpressionScriptLoad">
                    <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M8 4H4v16h16V8l-4-4h-8z"/><path d="M8 4v5h8V4M8 20v-7h8v7"/></svg>
                </button>
                <button type="button" class="secondary" aria-haspopup="dialog"
                        disabled="@(Workspace.IsBusy || Workspace.IsChapterGridEmpty)"
                        @onclick="OpenExpressionDialog">@L.T("Tool.Expression.Title")</button>
                <div class="inline-expression-actions @(mainOptionsActionsVisible ? null : "inactive")">
                    @if (mainOptionsStateVisible && !_mainExpressionPreviewPending && Workspace.IsMainOptionsPreviewStale)
                    {
                        <button type="button" class="secondary" title="@L.T("Expression.State.Stale")" @onclick="RefreshMainExpressionPreview">@L.T("Expression.Action.Refresh")</button>
                    }
                    else
                    {
                        <button type="button" class="primary" disabled="@(Workspace.IsBusy || !showMainOptionsCandidate || !mainOptionsActionsVisible)"
                                title="@mainOptionsErrors" @onclick="ApplyMainExpressionPreviewAsync">@L.T("Expression.Action.Apply")</button>
                    }
                    <button type="button" class="secondary" disabled="@(!mainOptionsActionsVisible)" @onclick="DiscardMainExpressionPreview">@L.T("Expression.Preview.Discard")</button>
                </div>
            </section>
        </div>
    </div>

    <!-- Status / progress strip -->
    <footer class="status-bar">
        <span class="status-text" role="status" aria-live="polite" title="@Workspace.StatusText">@Workspace.StatusText</span>
        <button type="button" class="secondary log-toggle" @onclick="OpenLogs" title="@ShortcutHint(ShortcutCatalog.LogId, L.T("Modal.LogTitle"))">@L.T("Action.Log")</button>
        <progress class="status-progress"
                  max="1"
                  value="@(Workspace.Progress > 0 ? Workspace.Progress : 0)"
                  style="@(Workspace.IsBusy || Workspace.Progress > 0 ? null : "visibility:hidden")"></progress>
    </footer>
</div>

@if (_contextMenuTarget == "row" && _contextMenuIndex >= 0)
{
    <div class="context-menu" style="left:@_contextMenuXpx; top:@_contextMenuYpx" @onclick:stopPropagation>
        <button type="button" @onclick="SelectContextRow">@L.T("Menu.Select")</button>
        <button type="button" @onclick="InsertContextRow">@L.T("Menu.Insert")</button>
        <button type="button" @onclick="DuplicateContextRow">@L.T("Menu.Duplicate")</button>
        <button type="button" @onclick="CopyContextRow">@L.T("Menu.CopyRow")</button>
        <button type="button" @onclick="CopyContextName">@L.T("Menu.CopyName")</button>
        <button type="button" @onclick="CopyContextZones" disabled="@(Workspace.FramesPerSecond <= 0 || !Workspace.HasRowSelection)">@L.T("Menu.CopyZones")</button>
        <button type="button" @onclick="PreviewFromMenu" disabled="@(!Workspace.CanPreview)">@L.T("Menu.Preview")</button>
        <button type="button" @onclick="ZonesFromMenu" disabled="@(Workspace.FramesPerSecond <= 0 || !Workspace.HasRowSelection)">@L.T("Menu.Zones")</button>
        <button type="button" @onclick="OpenForwardModal" disabled="@(!Workspace.CanRefreshRows)">@L.T("Menu.ForwardTranslation")</button>
        <button type="button" @onclick="OpenRelatedMedia" disabled="@(!Workspace.CanOpenRelatedMedia)">@L.T("Menu.RelatedMedia")</button>
        <button type="button" class="danger" @onclick="DeleteContextRow" disabled="@(!Workspace.HasRowSelection)">@L.T("Menu.Delete")</button>
    </div>
}

@if (_contextMenuTarget == "clip")
{
    <div class="context-menu" style="left:@_contextMenuXpx; top:@_contextMenuYpx" @onclick:stopPropagation>
        <button type="button"
                @onclick="ToggleClipCombineContext"
                disabled="@(!Workspace.CanToggleClipCombine)">
            @(Workspace.IsClipCombined ? L.T("Menu.SplitByBoundaries") : L.T("Menu.Combine"))
        </button>
    </div>
}

@if (_contextMenuTarget == "fps")
{
    <div class="context-menu" style="left:@_contextMenuXpx; top:@_contextMenuYpx" @onclick:stopPropagation>
        <button type="button"
                @onclick="ChangeFrameRateContext"
                disabled="@(!Workspace.CanChangeSelectedFrameRate)">@L.T("Menu.ChangeFps")</button>
    </div>
}

@if (_activeDialog == DialogKind.Logs)
{
    <LogDialog OnClose="CloseDialog" />
}

@if (_activeDialog == DialogKind.Preview)
{
    <WasmDialog Title="@L.T("Modal.PreviewTitle")" CssClass="preview-modal" OnClose="ClosePreview" LightDismiss="true">
            <div class="modal-body">
                <pre class="preview-text" data-testid="preview-content">@_previewText</pre>
            </div>
            <footer class="modal-footer">
                <button type="button" class="secondary" @onclick="CopyPreviewAsync" disabled="@(_previewText.Length == 0)">@L.T("Text.Copy")</button>
                <button type="button" class="secondary" @onclick="DownloadPreviewAsync" disabled="@(_previewText.Length == 0)">@L.T("Action.Download")</button>
                <span class="modal-spacer"></span>
                <button type="button" class="secondary" @onclick="ClosePreview">@L.T("Action.Close")</button>
            </footer>
    </WasmDialog>
}

@if (_activeDialog == DialogKind.Forward)
{
    <ContentOperationDialog Operation="@_contentOperation" OnClose="CloseDialog" />
}

@if (_activeDialog == DialogKind.Related)
{
    <WasmDialog Title="@L.T("Modal.RelatedTitle")" CssClass="related-modal" OnClose="CloseRelatedModal" LightDismiss="true">
            <div class="modal-body">
                @if (Workspace.RelatedMediaReferences.Count == 0)
                {
                    <p class="settings-note">@L.T("Status.NoRelatedMedia")</p>
                }
                else
                {
                    <ul class="related-list">
                        @foreach (var media in Workspace.RelatedMediaReferences)
                        {
                            <li>
                                <strong>@media.DisplayName</strong>
                                <div class="related-path">
                                    @L.T("Related.Relative"):
                                    @if (!string.IsNullOrWhiteSpace(media.RelativePath))
                                    {
                                        <a href="@media.RelativePath" target="_blank" rel="noopener">@media.RelativePath</a>
                                    }
                                    else
                                    {
                                        <code>—</code>
                                    }
                                </div>
                                @if (!string.IsNullOrWhiteSpace(media.AbsolutePath))
                                {
                                    <div class="related-path">@L.T("Related.Absolute"): <code>@media.AbsolutePath</code></div>
                                }
                            </li>
                        }
                    </ul>
                    <p class="settings-note">@L.T("Related.BrowserLimit")</p>
                }
            </div>
            <footer class="modal-footer">
                <button type="button" class="secondary" @onclick="CloseRelatedModal">@L.T("Action.Close")</button>
            </footer>
    </WasmDialog>
}

@if (_activeDialog == DialogKind.Settings)
