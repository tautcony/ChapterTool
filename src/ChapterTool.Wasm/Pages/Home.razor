    private bool SettingsDraftValid => WasmShortcuts.InvalidActions(_draftShortcuts).Count == 0
        && int.TryParse(_draftFrameDecimalPlaces, NumberStyles.Integer, CultureInfo.InvariantCulture, out var decimals) && decimals is >= 1 and <= 6
        && _draftFrameAccuracyTolerance is >= 0.01m and <= 0.30m
        && _draftSaveFormatIndex >= 0 && _draftSaveFormatIndex < Workspace.SaveFormats.Count
        && _draftOutputTextEncodingIndex >= 0 && _draftOutputTextEncodingIndex < OutputTextEncodings.All.Count
        && _draftFrameDisplayModeIndex is 0 or 1 or 2 && _draftDeleteRowsTimingModeIndex is 0 or 1
        && UiLanguages.Any(language => language.Code == _draftUiLanguage)
        && Workspace.XmlLanguages.Contains(_draftXmlLanguage, StringComparer.OrdinalIgnoreCase)
        && ThemeOptions.Any(option => option.Id == _draftThemePresetId);

    private async Task ApplySettingsAsync()
    {
        if (!SettingsDraftValid) return;
        if (!await TryApplySettingsDraftAsync()) return;
        var settings = CreateSettingsDocumentFromDraft();
        try
        {
            await Js.InvokeVoidAsync("chapterToolWasm.setLocalStorage", SettingsStorageKey, JsonSerializer.Serialize(settings, SettingsJsonOptions));
            _defaultSaveFormatIndex = _draftSaveFormatIndex;
            _defaultXmlLanguage = _draftXmlLanguage;
            _shortcuts = WasmShortcuts.Normalize(_draftShortcuts);
            CloseDialog();
        }
        catch (JSException)
        {
            _settingsError = L.T("Parity.SettingsSaveFailed");
        }
    }

    private async Task ApplySettingsDraftAsync()
    {
        await TryApplySettingsDraftAsync();
    }

    private async Task<bool> TryApplySettingsDraftAsync()
    {
        if (_activeDialog != DialogKind.Settings || !SettingsDraftValid) return false;
        var settings = CreateSettingsDocumentFromDraft();
        if (_lastAppliedRuntimeSettings is { } applied
            && JsonSerializer.Serialize(settings, SettingsJsonOptions) == JsonSerializer.Serialize(applied, SettingsJsonOptions))
        {
            _settingsError = null;
            return true;
        }

        var previous = _lastAppliedRuntimeSettings ?? _entryRuntimeSettings;
        var previousRoundFrames = _roundFrames;
        var frameDisplayChanged = previous is null
            || FrameDisplayModes.ParseOrDefault(previous.Application?.FrameDisplayMode)
                != FrameDisplayModes.ParseOrDefault(settings.Application?.FrameDisplayMode);
        try
        {
            await Js.InvokeVoidAsync("chapterToolWasm.applyAppearance", _draftThemePresetId, _draftUiLanguage, _draftUiFontFamily.Trim(), _draftMonospaceFontFamily.Trim());
            await Js.InvokeVoidAsync("chapterToolWasm.setShortcutBindings", WasmShortcuts.Bindings(_draftShortcuts).Keys.ToArray<object?>());
            ApplySettingsToWorkspace(settings, preserveSessionOutput: true);
            if (!frameDisplayChanged)
            {
                RestoreRoundFrames(previousRoundFrames);
            }
            _lastAppliedRuntimeSettings = settings;
            _settingsError = null;
            return true;
        }
        catch (JSException)
        {
            if (previous is not null)
            {
                await RestoreRuntimeSettingsAsync(previous);
                RestoreRoundFrames(previousRoundFrames);
            }
            _settingsError = L.T("Parity.SettingsApplyFailed");
            return false;
        }
    }

    private async Task RestoreRuntimeSettingsAsync(WasmSettings settings)
    {
        ApplySettingsToWorkspace(settings, preserveSessionOutput: true);
        try
        {
            await ApplyAppearanceAsync();
            await SyncShortcutGuardAsync();
        }
        catch (JSException) { }
        _lastAppliedRuntimeSettings = settings;
    }

    private void RestoreRoundFrames(bool value)
    {
        if (_roundFrames == value && Workspace.RoundFrames == value) return;
        _roundFrames = value;
        Workspace.RoundFrames = value;
        Workspace.ApplyOptionsAndRefresh();
    }

    private void ApplySettingsToWorkspace(WasmSettings settings, bool preserveSessionOutput = false)
    {
        var application = settings.Application ?? new WasmApplicationSettings();
        var theme = settings.Theme ?? new WasmThemeSettings();
        var font = settings.Font ?? new WasmFontSettings();
        var parsedFormat = Enum.TryParse<ChapterExportFormat>(application.DefaultSaveFormat, true, out var format)
            ? format
            : ChapterExportFormat.Txt;

        _defaultSaveFormatIndex = Math.Clamp(ChapterExportFormats.IndexOf(parsedFormat), 0, Math.Max(0, Workspace.SaveFormats.Count - 1));
        if (!preserveSessionOutput && Workspace.IsChapterGridEmpty) _saveFormatIndex = _defaultSaveFormatIndex;
        _shortcuts = WasmShortcuts.Normalize(settings.Shortcuts);
        _defaultXmlLanguage = Workspace.XmlLanguages.Contains(application.DefaultXmlLanguage, StringComparer.OrdinalIgnoreCase)
            ? application.DefaultXmlLanguage
            : Workspace.XmlLanguages.FirstOrDefault("und");
        if (!preserveSessionOutput && Workspace.IsChapterGridEmpty) _xmlLanguage = _defaultXmlLanguage;
        _uiLanguage = UiLanguages.Any(language => string.Equals(language.Code, application.Language, StringComparison.OrdinalIgnoreCase))
            ? application.Language
            : "en-US";
        L.SetCulture(_uiLanguage);
        _outputTextEncodingIndex = Math.Max(0, OutputTextEncodings.All.ToList().IndexOf(OutputTextEncodings.ParseOrDefault(application.OutputTextEncoding)));
        _emitBom = application.EmitBom;
        _frameAccuracyTolerance = Math.Clamp(application.FrameAccuracyTolerance <= 0 ? 0.15m : application.FrameAccuracyTolerance, 0.01m, 0.30m);
        _showRepeatingFrameDecimals = application.ShowRepeatingFrameDecimals;
        _draftFrameDisplayModeIndex = (int)FrameDisplayModes.ParseOrDefault(application.FrameDisplayMode);
        _draftFrameDecimalPlaces = FrameDisplayModes.NormalizeDecimalPlaces(application.FrameDecimalPlaces).ToString(CultureInfo.InvariantCulture);
        _draftDeleteRowsTimingModeIndex = DeleteRowsTimingModes.ParseOrDefault(application.DeleteRowsTimingMode) == ContractDeleteRowsTimingMode.Preserve ? 0 : 1;
        Workspace.EditingOptions = new ChapterEditingOptions(_draftDeleteRowsTimingModeIndex == 0 ? DeleteRowsTimingMode.Preserve : DeleteRowsTimingMode.Normalize, (FrameDisplayMode)_draftFrameDisplayModeIndex, FrameDisplayModes.NormalizeDecimalPlaces(application.FrameDecimalPlaces));
        _roundFrames = Workspace.RoundFrames = _draftFrameDisplayModeIndex == 0;
        _themePresetId = ThemeOptions.Any(option => string.Equals(option.Id, theme.PresetId, StringComparison.OrdinalIgnoreCase))
            ? theme.PresetId
            : "avalonia-default";
        _uiFontFamily = string.IsNullOrWhiteSpace(font.UiFontFamily) ? "system-ui" : font.UiFontFamily;
        _monospaceFontFamily = string.IsNullOrWhiteSpace(font.MonospaceFontFamily)
            ? "ui-monospace, SFMono-Regular, Menlo, Consolas, monospace"
            : font.MonospaceFontFamily;
        PushExportOptions();
        Workspace.ApplyOptionsAndRefresh();
    }

    private async Task PersistSettingsAsync()
    {
        var settings = CreateSettingsDocument();
        try
        {
            await Js.InvokeVoidAsync("chapterToolWasm.setLocalStorage", SettingsStorageKey, JsonSerializer.Serialize(settings, SettingsJsonOptions));
        }
        catch (JSException)
        {
            // Automatic preference persistence must not interrupt the active document.
        }
    }

    private WasmSettings CreateSettingsDocumentFromDraft() =>
        new(
            SchemaVersion: 1,
            Application: new WasmApplicationSettings(
                Language: _draftUiLanguage,
                DefaultSaveFormat: ChapterExportFormats.AtIndex(_draftSaveFormatIndex).ToString(),
                DefaultXmlLanguage: _draftXmlLanguage,
                OutputTextEncoding: OutputTextEncodings.Id(OutputTextEncodings.All[Math.Clamp(_draftOutputTextEncodingIndex, 0, OutputTextEncodings.All.Count - 1)]),
                EmitBom: _draftEmitBom,
                FrameAccuracyTolerance: _draftFrameAccuracyTolerance,
                DeleteRowsTimingMode: _draftDeleteRowsTimingModeIndex == 0 ? "preserve" : "normalize",
                FrameDisplayMode: FrameDisplayModes.Id((ContractFrameDisplayMode)_draftFrameDisplayModeIndex),
                FrameDecimalPlaces: int.TryParse(_draftFrameDecimalPlaces, NumberStyles.Integer, CultureInfo.InvariantCulture, out var decimals) ? decimals : 0,
                ShowRepeatingFrameDecimals: _draftShowRepeatingFrameDecimals),
            Theme: new WasmThemeSettings(_draftThemePresetId),
            Font: new WasmFontSettings(
                UiFontFamily: _draftUiFontFamily.Trim() == "system-ui" ? string.Empty : _draftUiFontFamily.Trim(),
                MonospaceFontFamily: _draftMonospaceFontFamily.Trim() == "ui-monospace, SFMono-Regular, Menlo, Consolas, monospace" ? string.Empty : _draftMonospaceFontFamily.Trim()),
            Shortcuts: new ShortcutSettings(_draftShortcuts));

    private WasmSettings CreateSettingsDocument() =>
        new(
            SchemaVersion: 1,
            Application: new WasmApplicationSettings(
                Language: _uiLanguage,
                DefaultSaveFormat: ChapterExportFormats.AtIndex(_defaultSaveFormatIndex).ToString(),
                DefaultXmlLanguage: _defaultXmlLanguage,
                OutputTextEncoding: Workspace.OutputTextEncodingId,
                EmitBom: _emitBom,
                FrameAccuracyTolerance: _frameAccuracyTolerance,
                DeleteRowsTimingMode: Workspace.EditingOptions.DeleteRowsTiming == DeleteRowsTimingMode.Preserve ? "preserve" : "normalize",
                FrameDisplayMode: FrameDisplayModes.Id((ContractFrameDisplayMode)Workspace.EditingOptions.FrameDisplay),
                FrameDecimalPlaces: Workspace.EditingOptions.FrameDecimalPlaces,
                ShowRepeatingFrameDecimals: _showRepeatingFrameDecimals),
            Theme: new WasmThemeSettings(_themePresetId),
            Font: new WasmFontSettings(
                UiFontFamily: _uiFontFamily == "system-ui" ? string.Empty : _uiFontFamily,
                MonospaceFontFamily: _monospaceFontFamily == "ui-monospace, SFMono-Regular, Menlo, Consolas, monospace" ? string.Empty : _monospaceFontFamily),
            Shortcuts: new ShortcutSettings(_shortcuts));

