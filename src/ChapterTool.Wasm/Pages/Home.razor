        draftFrameAccuracyTolerance = frameAccuracyTolerance;
        draftFrameDisplayModeIndex = (int)Workspace.EditingOptions.FrameDisplay;
        draftFrameDecimalPlaces = Workspace.EditingOptions.FrameDecimalPlaces.ToString(CultureInfo.InvariantCulture);
        draftShowRepeatingFrameDecimals = showRepeatingFrameDecimals;
        draftDeleteRowsTimingModeIndex = Workspace.EditingOptions.DeleteRowsTiming == DeleteRowsTimingMode.Preserve ? 0 : 1;
        draftThemePresetId = themePresetId;
        draftUiFontFamily = uiFontFamily;
        draftMonospaceFontFamily = monospaceFontFamily;
