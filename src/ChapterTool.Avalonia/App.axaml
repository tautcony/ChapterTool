<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="ChapterTool.Avalonia.App"
             RequestedThemeVariant="Light">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://ChapterTool.Avalonia/Views/SourceGit/Icons.axaml" />
        <ResourceInclude Source="avares://ChapterTool.Avalonia/Views/SourceGit/Themes.axaml" />
      </ResourceDictionary.MergedDictionaries>
    <FontFamily x:Key="ChapterTool.UiFontFamily">sans-serif</FontFamily>
    <FontFamily x:Key="ChapterTool.MonospaceFontFamily">Menlo, Consolas, monospace</FontFamily>
    <x:Double x:Key="SourceGit.FontSize.Small">12</x:Double>
    <x:Double x:Key="SourceGit.FontSize.Default">13</x:Double>
    <x:Double x:Key="SourceGit.FontSize.Large">14</x:Double>
    <SolidColorBrush x:Key="ChapterTool.WindowBackgroundBrush" Color="#F0F0F0" />
    <SolidColorBrush x:Key="ChapterTool.PanelBackgroundBrush" Color="#F7F7F7" />
    <SolidColorBrush x:Key="ChapterTool.ControlBackgroundBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="ChapterTool.ControlForegroundBrush" Color="#111111" />
    <SolidColorBrush x:Key="ChapterTool.MutedForegroundBrush" Color="#595959" />
    <SolidColorBrush x:Key="ChapterTool.AccentBrush" Color="#0067C0" />
    <SolidColorBrush x:Key="ChapterTool.AccentForegroundBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="ChapterTool.BorderBrush" Color="#767676" />
    <SolidColorBrush x:Key="ChapterTool.HoverBackgroundBrush" Color="#D6E9F8" />
    <SolidColorBrush x:Key="ChapterTool.ActiveBackgroundBrush" Color="#CCE4F7" />
    <SolidColorBrush x:Key="ChapterTool.FrameNeutralBrush" Color="#111111" />
    <SolidColorBrush x:Key="ChapterTool.FrameAccurateBrush" Color="#0F7A2F" />
    <SolidColorBrush x:Key="ChapterTool.FrameInexactBrush" Color="#B42318" />
    <SolidColorBrush x:Key="ChapterTool.DiagnosticErrorBrush" Color="#B42318" />
    <SolidColorBrush x:Key="ChapterTool.AuxiliaryTitleBackgroundBrush" Color="#CFDEEA" />
    <SolidColorBrush x:Key="ChapterTool.AuxiliaryToolbarBackgroundBrush" Color="#F0F5F9" />
    <SolidColorBrush x:Key="ChapterTool.AuxiliaryContentBackgroundBrush" Color="#FAFAFA" />
    <SolidColorBrush x:Key="ChapterTool.AuxiliaryControlBackgroundBrush" Color="#F8F8F8" />
    <SolidColorBrush x:Key="ChapterTool.AuxiliaryPopupBackgroundBrush" Color="#F4F8FB" />
    <SolidColorBrush x:Key="ChapterTool.AuxiliaryBorderBrush" Color="#898989" />
    <SolidColorBrush x:Key="ChapterTool.AuxiliarySubtleBorderBrush" Color="#CFCFCF" />
    <SolidColorBrush x:Key="ChapterTool.AuxiliaryHoverBackgroundBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="ChapterTool.AuxiliaryPressedBackgroundBrush" Color="#DDEAF4" />
    <SolidColorBrush x:Key="ChapterTool.AuxiliarySelectionBackgroundBrush" Color="#D7E7F3" />
    <SolidColorBrush x:Key="ChapterTool.AuxiliaryFocusBrush" Color="#0067C0" />
    <SolidColorBrush x:Key="ChapterTool.AuxiliaryDisabledForegroundBrush" Color="#8A94A6" />
    <SolidColorBrush x:Key="ChapterTool.LogInformationBrush" Color="#0067C0" />
    <SolidColorBrush x:Key="ChapterTool.LogWarningBrush" Color="#A15C00" />
    <SolidColorBrush x:Key="ChapterTool.LogErrorBrush" Color="#B42318" />
    <!-- Expression editor category/chrome colors (themeable; light defaults) -->
    <SolidColorBrush x:Key="ChapterTool.Expression.VariableBrush" Color="#0550ae" />
    <SolidColorBrush x:Key="ChapterTool.Expression.ConstantBrush" Color="#8250df" />
    <SolidColorBrush x:Key="ChapterTool.Expression.FunctionBrush" Color="#953800" />
    <SolidColorBrush x:Key="ChapterTool.Expression.KeywordBrush" Color="#cf222e" />
    <SolidColorBrush x:Key="ChapterTool.Expression.SnippetBrush" Color="#6f42c1" />
    <SolidColorBrush x:Key="ChapterTool.Expression.StringBrush" Color="#0a3069" />
    <SolidColorBrush x:Key="ChapterTool.Expression.OperatorBrush" Color="#cf222e" />
    <SolidColorBrush x:Key="ChapterTool.Expression.PunctuationBrush" Color="#57606a" />
    <SolidColorBrush x:Key="ChapterTool.Expression.NumberBrush" Color="#116329" />
    <SolidColorBrush x:Key="ChapterTool.Expression.CommentBrush" Color="#6e7781" />
    <SolidColorBrush x:Key="ChapterTool.Expression.UnknownBrush" Color="#b42318" />
    </ResourceDictionary>
  </Application.Resources>
  <Application.Styles>
    <FluentTheme />
    <StyleInclude Source="avares://AvaloniaEdit/Themes/Fluent/AvaloniaEdit.xaml" />
    <StyleInclude Source="avares://Avalonia.Controls.DataGrid/Themes/Fluent.xaml" />
    <StyleInclude Source="avares://ChapterTool.Avalonia/Views/SourceGit/Styles.axaml" />
    <StyleInclude Source="avares://ChapterTool.Avalonia/Views/Styles/AuxiliaryWindowStyles.axaml" />
    <Style Selector="Window">
      <Setter Property="Background" Value="{DynamicResource ChapterTool.WindowBackgroundBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource ChapterTool.ControlForegroundBrush}" />
      <Setter Property="FontFamily" Value="{DynamicResource ChapterTool.UiFontFamily}" />
    </Style>
    <Style Selector="Window.auxiliaryHost">
      <Setter Property="Background" Value="{DynamicResource ChapterTool.AuxiliaryContentBackgroundBrush}" />
    </Style>
    <Style Selector="TextBlock">
      <Setter Property="FontFamily" Value="{DynamicResource ChapterTool.UiFontFamily}" />
    </Style>
    <Style Selector="TextBox, ComboBox, NumericUpDown">
      <Setter Property="Background" Value="{DynamicResource ChapterTool.ControlBackgroundBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource ChapterTool.ControlForegroundBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource ChapterTool.BorderBrush}" />
    </Style>
    <Style Selector="Button">
      <Setter Property="Background" Value="{DynamicResource ChapterTool.ControlBackgroundBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource ChapterTool.ControlForegroundBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource ChapterTool.BorderBrush}" />
    </Style>
    <Style Selector="Button:pointerover, ComboBoxItem:pointerover, MenuItem:pointerover">
      <Setter Property="Background" Value="{DynamicResource ChapterTool.HoverBackgroundBrush}" />
    </Style>
    <Style Selector="Button:pressed, ComboBoxItem:selected, MenuItem:selected">
      <Setter Property="Background" Value="{DynamicResource ChapterTool.ActiveBackgroundBrush}" />
    </Style>
    <Style Selector="ComboBoxItem, MenuItem, CheckBox, RadioButton, TabItem">
      <Setter Property="Foreground" Value="{DynamicResource ChapterTool.ControlForegroundBrush}" />
      <Setter Property="FontFamily" Value="{DynamicResource ChapterTool.UiFontFamily}" />
    </Style>
    <Style Selector="ToolTip">
      <Setter Property="FontFamily" Value="{DynamicResource ChapterTool.UiFontFamily}" />
    </Style>
    <Style Selector="DataGrid">
      <Setter Property="Background" Value="{DynamicResource ChapterTool.ControlBackgroundBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource ChapterTool.ControlForegroundBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource ChapterTool.BorderBrush}" />
      <Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource ChapterTool.BorderBrush}" />
      <Setter Property="VerticalGridLinesBrush" Value="{DynamicResource ChapterTool.BorderBrush}" />
    </Style>
    <Style Selector="DataGridColumnHeader">
      <Setter Property="Background" Value="{DynamicResource ChapterTool.ControlBackgroundBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource ChapterTool.ControlForegroundBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource ChapterTool.BorderBrush}" />
    </Style>
    <Style Selector="DataGridColumnHeader:pointerover">
      <Setter Property="Background" Value="{DynamicResource ChapterTool.HoverBackgroundBrush}" />
    </Style>
    <Style Selector="DataGridColumnHeader:pressed">
      <Setter Property="Background" Value="{DynamicResource ChapterTool.ActiveBackgroundBrush}" />
    </Style>
    <Style Selector="DataGridColumnHeader /template/ Path">
      <Setter Property="Fill" Value="{DynamicResource ChapterTool.ControlForegroundBrush}" />
    </Style>
    <Style Selector="DataGridCell">
      <Setter Property="Background" Value="{DynamicResource ChapterTool.ControlBackgroundBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource ChapterTool.ControlForegroundBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource ChapterTool.BorderBrush}" />
      <Setter Property="FontFamily" Value="{DynamicResource ChapterTool.MonospaceFontFamily}" />
    </Style>
    <Style Selector="DataGridRow:pointerover DataGridCell">
      <Setter Property="Background" Value="{DynamicResource ChapterTool.HoverBackgroundBrush}" />
    </Style>
    <Style Selector="DataGridRow:selected DataGridCell">
      <Setter Property="Background" Value="{DynamicResource ChapterTool.ActiveBackgroundBrush}" />
    </Style>
  </Application.Styles>
</Application>
