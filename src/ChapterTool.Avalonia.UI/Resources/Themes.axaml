<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ResourceDictionary.ThemeDictionaries>
    <ResourceDictionary x:Key="Light">
      <Color x:Key="Color.Window">#FFF0F5F9</Color>
      <Color x:Key="Color.WindowBorder">#FF999999</Color>
      <Color x:Key="Color.ToolBar">#FFF0F5F9</Color>
      <Color x:Key="Color.Popup">#FFF4F8FB</Color>
      <Color x:Key="Color.PopupBorder">White</Color>
      <Color x:Key="Color.Contents">#FFFAFAFA</Color>
      <Color x:Key="Color.Border1">#FF898989</Color>
      <Color x:Key="Color.Border2">#FFCFCFCF</Color>
      <Color x:Key="Color.FlatButton.Background">#FFF8F8F8</Color>
      <Color x:Key="Color.FlatButton.BackgroundHovered">White</Color>
      <Color x:Key="Color.FG1">#FF1F1F1F</Color>
      <Color x:Key="Color.FG2">#FF6F6F6F</Color>
      <Color x:Key="Color.Hover">#FFD6E9F8</Color>
      <Color x:Key="Color.Active">#FFCCE4F7</Color>
      <Color x:Key="Color.Selection">#FFD7E7F3</Color>
    </ResourceDictionary>

    <ResourceDictionary x:Key="Dark">
      <Color x:Key="Color.Window">#FF252525</Color>
      <Color x:Key="Color.WindowBorder">#FF606060</Color>
      <Color x:Key="Color.ToolBar">#FF2F2F2F</Color>
      <Color x:Key="Color.Popup">#FF2B2B2B</Color>
      <Color x:Key="Color.PopupBorder">#FF393939</Color>
      <Color x:Key="Color.Contents">#FF1C1C1C</Color>
      <Color x:Key="Color.Border1">#FF7C7C7C</Color>
      <Color x:Key="Color.Border2">#FF404040</Color>
      <Color x:Key="Color.FlatButton.Background">#FF303030</Color>
      <Color x:Key="Color.FlatButton.BackgroundHovered">#FF333333</Color>
      <Color x:Key="Color.FG1">#FFDFDFDF</Color>
      <Color x:Key="Color.FG2">#FF9F9F9F</Color>
      <Color x:Key="Color.Hover">#FF333333</Color>
      <Color x:Key="Color.Active">#FF3A3A3A</Color>
      <Color x:Key="Color.Selection">#FF3A3A3A</Color>
    </ResourceDictionary>
  </ResourceDictionary.ThemeDictionaries>

  <SolidColorBrush x:Key="Brush.Window" Color="{DynamicResource Color.Window}"/>
  <SolidColorBrush x:Key="Brush.WindowBorder" Color="{DynamicResource Color.WindowBorder}"/>
  <SolidColorBrush x:Key="Brush.ToolBar" Color="{DynamicResource Color.ToolBar}"/>
  <SolidColorBrush x:Key="Brush.Popup" Color="{DynamicResource Color.Popup}"/>
  <SolidColorBrush x:Key="Brush.PopupBorder" Color="{DynamicResource Color.PopupBorder}"/>
  <SolidColorBrush x:Key="Brush.Contents" Color="{DynamicResource Color.Contents}"/>
  <SolidColorBrush x:Key="Brush.Border1" Color="{DynamicResource Color.Border1}"/>
  <SolidColorBrush x:Key="Brush.Border2" Color="{DynamicResource Color.Border2}"/>
  <SolidColorBrush x:Key="Brush.FlatButton.Background" Color="{DynamicResource Color.FlatButton.Background}"/>
  <SolidColorBrush x:Key="Brush.FlatButton.BackgroundHovered" Color="{DynamicResource Color.FlatButton.BackgroundHovered}"/>
  <SolidColorBrush x:Key="Brush.FG1" Color="{DynamicResource Color.FG1}"/>
  <SolidColorBrush x:Key="Brush.FG2" Color="{DynamicResource Color.FG2}"/>
  <SolidColorBrush x:Key="Brush.Accent" Color="{DynamicResource SystemAccentColor}"/>
  <SolidColorBrush x:Key="Brush.AccentHovered" Color="{DynamicResource SystemListLowColor}"/>
  <SolidColorBrush x:Key="Brush.Hover" Color="{DynamicResource Color.Hover}"/>
  <SolidColorBrush x:Key="Brush.Active" Color="{DynamicResource Color.Active}"/>
  <SolidColorBrush x:Key="Brush.Selection" Color="{DynamicResource Color.Selection}"/>

  <!-- Fluent state-resource overrides: route pointer-over and pressed states of
       Fluent-templated controls (SplitButton, plain Button/RepeatButton) through
       the shared hover/active palette so every button states match. -->
  <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="{DynamicResource Color.Hover}"/>
  <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="{DynamicResource Color.Active}"/>
  <SolidColorBrush x:Key="SplitButtonBackground" Color="{DynamicResource Color.FlatButton.Background}"/>
  <SolidColorBrush x:Key="SplitButtonBackgroundPointerOver" Color="{DynamicResource Color.Hover}"/>
  <SolidColorBrush x:Key="SplitButtonBackgroundPressed" Color="{DynamicResource Color.Active}"/>
  <SolidColorBrush x:Key="SplitButtonBackgroundChecked" Color="{DynamicResource Color.Active}"/>
  <SolidColorBrush x:Key="SplitButtonBackgroundCheckedPointerOver" Color="{DynamicResource Color.Active}"/>
  <SolidColorBrush x:Key="SplitButtonForeground" Color="{DynamicResource Color.FG1}"/>
  <SolidColorBrush x:Key="SplitButtonForegroundPointerOver" Color="{DynamicResource Color.FG1}"/>
  <SolidColorBrush x:Key="SplitButtonForegroundPressed" Color="{DynamicResource Color.FG1}"/>
  <SolidColorBrush x:Key="SplitButtonForegroundChecked" Color="{DynamicResource Color.FG1}"/>
  <SolidColorBrush x:Key="SplitButtonForegroundCheckedPointerOver" Color="{DynamicResource Color.FG1}"/>
  <SolidColorBrush x:Key="SplitButtonBorderBrush" Color="{DynamicResource Color.Border2}"/>
  <SolidColorBrush x:Key="SplitButtonBorderBrushPointerOver" Color="{DynamicResource Color.Border2}"/>
  <SolidColorBrush x:Key="SplitButtonBorderBrushPressed" Color="{DynamicResource Color.Border2}"/>
  <SolidColorBrush x:Key="SplitButtonBorderBrushChecked" Color="{DynamicResource Color.Border2}"/>
  <SolidColorBrush x:Key="SplitButtonBorderBrushCheckedPointerOver" Color="{DynamicResource Color.Border2}"/>

  <FontFamily x:Key="Fonts.Default">sans-serif</FontFamily>
</ResourceDictionary>
