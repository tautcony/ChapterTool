<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:tools="clr-namespace:ChapterTool.Avalonia.UI.ViewModels.Tools"
             x:Class="ChapterTool.Avalonia.UI.Views.Tools.TemplateNamesToolView"
             x:DataType="tools:TemplateNamesToolViewModel"
             x:CompileBindings="True">
  <Grid RowDefinitions="*,Auto">
    <Grid Grid.Row="0" Margin="16" RowDefinitions="Auto,*" RowSpacing="10">
    <CheckBox Grid.Row="0"
              VerticalAlignment="Top"
              Content="{DynamicResource Tool.TemplateNames.UseStandard}"
              IsChecked="{Binding UseTemplateNames}" />
    <TextBlock Grid.Row="1" Text="{Binding StatusText}" TextWrapping="Wrap" />
    </Grid>
    <Border Grid.Row="1" Classes="toolFooter">
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
        <Button Classes="flat"
                MinWidth="88"
                Content="{DynamicResource Menu.Preview}"
                IsVisible="{Binding CanPreparePreview}"
                Command="{Binding ApplyCommand}"
                CommandParameter="{Binding}" />
        <Button Classes="flat primary"
                MinWidth="88"
                Content="{DynamicResource Common.Apply}"
                IsVisible="{Binding IsPreviewPending}"
                IsEnabled="{Binding CanApplyPreview}"
                Command="{Binding ConfirmApplyCommand}" />
        <Button Classes="flat"
                MinWidth="88"
                Content="{DynamicResource Common.Cancel}"
                IsVisible="{Binding IsPreviewPending}"
                Command="{Binding CancelPreviewCommand}" />
      </StackPanel>
    </Border>
  </Grid>
</UserControl>
