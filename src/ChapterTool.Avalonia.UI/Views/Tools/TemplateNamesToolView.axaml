<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ChapterTool.Avalonia.UI.ViewModels"
             xmlns:tools="clr-namespace:ChapterTool.Avalonia.UI.ViewModels.Tools"
             x:Class="ChapterTool.Avalonia.UI.Views.Tools.TemplateNamesToolView"
             Classes="auxiliaryWindow"
             x:DataType="tools:TemplateNamesToolViewModel"
             x:CompileBindings="True">
  <Grid RowDefinitions="*,Auto">
    <CheckBox Grid.Row="0"
              Margin="16"
              VerticalAlignment="Top"
              Content="{DynamicResource Tool.TemplateNames.UseStandard}"
              IsChecked="{Binding UseTemplateNames}" />
    <Border Grid.Row="1" Classes="toolFooter">
      <Button Classes="primaryToolAction"
              MinWidth="88"
              HorizontalAlignment="Right"
              Content="{DynamicResource Common.Apply}"
              Command="{Binding ApplyCommand}"
              CommandParameter="{Binding}" />
    </Border>
  </Grid>
</UserControl>
