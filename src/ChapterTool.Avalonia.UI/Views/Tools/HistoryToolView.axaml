<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:tools="using:ChapterTool.Avalonia.UI.ViewModels.Tools"
             xmlns:vm="using:ChapterTool.Avalonia.UI.ViewModels"
             xmlns:history="using:ChapterTool.Core.Session"
             xmlns:models="using:ChapterTool.Core.Models"
             x:Class="ChapterTool.Avalonia.UI.Views.Tools.HistoryToolView"
             x:Name="HistoryRoot"
             x:DataType="tools:HistoryToolViewModel"
             x:CompileBindings="True"
             Background="{DynamicResource Brush.Window}"
             SizeChanged="OnSizeChanged"
             KeyDown="OnKeyDown">
  <UserControl.Styles>
    <Style Selector="TextBlock"><Setter Property="Foreground" Value="{DynamicResource Brush.FG1}" /></Style>
    <Style Selector="SelectableTextBlock"><Setter Property="Foreground" Value="{DynamicResource Brush.FG1}" /></Style>
  </UserControl.Styles>
  <Grid RowDefinitions="Auto,*,Auto" RowSpacing="8" Margin="12">
    <Grid Grid.Row="0" ColumnDefinitions="*,Auto" ColumnSpacing="12" IsVisible="{Binding IsWideLayout}">
      <StackPanel Spacing="4">
        <TextBlock Classes="toolLabel" Text="{DynamicResource History.Title}" />
        <TextBlock Text="{Binding SessionLifetimeText}" TextWrapping="Wrap" />
        <TextBlock Text="{DynamicResource History.PendingPreviewNotice}" IsVisible="{Binding HasPendingPreview}" TextWrapping="Wrap" />
      </StackPanel>
      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
        <Button Classes="flat" Content="{DynamicResource History.Undo}" Command="{Binding UndoCommand}"
                IsEnabled="{Binding CanUndo}" ToolTip.Tip="{Binding UndoDescription}" />
        <Button Classes="flat" Content="{DynamicResource History.Redo}" Command="{Binding RedoCommand}"
                IsEnabled="{Binding CanRedo}" ToolTip.Tip="{Binding RedoDescription}" />
        <ComboBox x:Name="WideRedoChoices" Width="180" ItemsSource="{Binding RedoChoices}" SelectedItem="{Binding SelectedRedoChoice, Mode=TwoWay}"
                  IsVisible="{Binding HasAlternateRedoChoices}" AutomationProperties.Name="{DynamicResource History.RedoChoices}">
          <ComboBox.ItemTemplate>
            <DataTemplate x:DataType="tools:HistoryRedoChoice">
              <StackPanel Orientation="Horizontal" Spacing="4">
                <TextBlock Text="★" IsVisible="{Binding IsPreferred}" />
                <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Title}" />
              </StackPanel>
            </DataTemplate>
          </ComboBox.ItemTemplate>
        </ComboBox>
        <Button Classes="flat" Content="{DynamicResource History.RedoChoice}" Command="{Binding ChooseRedoBranchCommand}"
                CommandParameter="{Binding SelectedRedoChoice.Id}" IsVisible="{Binding HasAlternateRedoChoices}" />
        <Button x:Name="WideLocateCurrent" Classes="flat" Content="{DynamicResource History.LocateCurrent}" Command="{Binding LocateCurrentCommand}" Click="OnLocateCurrent" />
      </StackPanel>
    </Grid>
    <Grid Grid.Row="0" RowDefinitions="Auto,Auto" RowSpacing="6" IsVisible="{Binding IsNarrowLayout}">
      <StackPanel Spacing="3">
        <TextBlock Classes="toolLabel" Text="{DynamicResource History.Title}" />
        <TextBlock Text="{Binding SessionLifetimeText}" TextWrapping="Wrap" MaxHeight="42" />
      </StackPanel>
      <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="4" HorizontalAlignment="Center">
        <Button Classes="flat" Content="{DynamicResource History.Undo}" Command="{Binding UndoCommand}" IsEnabled="{Binding CanUndo}" />
        <Button Classes="flat" Content="{DynamicResource History.Redo}" Command="{Binding RedoCommand}" IsEnabled="{Binding CanRedo}" />
        <ComboBox x:Name="NarrowRedoChoices" Width="120" ItemsSource="{Binding RedoChoices}" SelectedItem="{Binding SelectedRedoChoice, Mode=TwoWay}"
                  IsVisible="{Binding HasAlternateRedoChoices}" AutomationProperties.Name="{DynamicResource History.RedoChoices}">
          <ComboBox.ItemTemplate><DataTemplate x:DataType="tools:HistoryRedoChoice"><StackPanel Orientation="Horizontal" Spacing="4"><TextBlock Text="★" IsVisible="{Binding IsPreferred}" /><TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Title}" /></StackPanel></DataTemplate></ComboBox.ItemTemplate>
        </ComboBox>
        <Button Classes="flat" Content="{DynamicResource History.RedoChoice}" Command="{Binding ChooseRedoBranchCommand}" CommandParameter="{Binding SelectedRedoChoice.Id}" IsVisible="{Binding HasAlternateRedoChoices}" />
        <Button x:Name="NarrowLocateCurrent" Classes="flat" Content="{DynamicResource History.LocateCurrent}" Command="{Binding LocateCurrentCommand}" Click="OnLocateCurrent" />
      </StackPanel>
    </Grid>
    <Grid Grid.Row="1" ColumnSpacing="0" IsVisible="{Binding IsWideLayout}">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="2*" MinWidth="280" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="3*" MinWidth="360" />
      </Grid.ColumnDefinitions>
      <TreeView x:Name="HistoryEntries" Grid.Column="0" MinWidth="280" Focusable="True" AutoScrollToSelectedItem="True" ItemsSource="{Binding TreeRoots}"
                SelectionChanged="OnSelectionChanged" SelectedItem="{Binding SelectedEntry, Mode=OneWay}"
                Background="{DynamicResource Brush.Contents}"
                AutomationProperties.AutomationId="HistoryEntries">
        <TreeView.Styles>
          <Style Selector="TreeViewItem" x:DataType="vm:HistoryEntryViewModel"><Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" /></Style>
        </TreeView.Styles>
        <TreeView.ItemTemplate>
          <TreeDataTemplate x:DataType="vm:HistoryEntryViewModel" ItemsSource="{Binding Children}">
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8" MinHeight="36" AutomationProperties.Name="{Binding Title}">
              <TextBlock Grid.Column="0" Text="●" IsVisible="{Binding IsCurrent}" Foreground="{DynamicResource SystemAccentColor}"
                         AutomationProperties.Name="{DynamicResource History.Current}" />
              <TextBlock Grid.Column="1" Text="{Binding Title}" TextTrimming="CharacterEllipsis"
                         ToolTip.Tip="{Binding Title}" VerticalAlignment="Center" />
            </Grid>
          </TreeDataTemplate>
        </TreeView.ItemTemplate>
      </TreeView>
      <GridSplitter Grid.Column="1" Width="6" MinWidth="6" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="{DynamicResource Brush.Window}" ResizeDirection="Columns" />
      <Border x:Name="HistoryDetails" Grid.Column="2" MinWidth="360" BorderThickness="1" BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}" Background="{DynamicResource Brush.Contents}" Padding="12" Focusable="True">
        <ScrollViewer>
          <StackPanel Spacing="10">
            <TextBlock Classes="toolLabel" Text="{Binding SelectedEntry.Title}" IsVisible="{Binding HasSelection}" TextWrapping="Wrap" />
            <TextBlock Text="{Binding SelectedEntryDescription}" IsVisible="{Binding HasSelectedEntryDescription}" TextWrapping="Wrap" />
            <TextBlock Text="{Binding SelectedPublishedAtText}" IsVisible="{Binding HasPublishedAtText}" />
            <TextBlock Text="{Binding DetailErrorText}" IsVisible="{Binding HasDetailError}"
                       TextWrapping="Wrap" />
            <Button Classes="flat" Content="{DynamicResource History.Retry}" Command="{Binding RetryCommand}"
                    IsVisible="{Binding HasDetailError}" />
            <TextBlock Text="{DynamicResource History.Loading}" IsVisible="{Binding IsLoadingDetails}" />
            <TextBlock Text="{Binding NavigationStatus}" IsVisible="{Binding HasNavigationStatus}" TextWrapping="Wrap" />
            <TextBlock Text="{Binding Details.RootDocument.Title}" IsVisible="{Binding IsRootDetails}" TextWrapping="Wrap" />
            <ListBox x:Name="RootChapterList" ItemsSource="{Binding RootChapterRows}" IsVisible="{Binding HasRootChapterRows}" Height="220">
              <ListBox.ItemsPanel><ItemsPanelTemplate><VirtualizingStackPanel /></ItemsPanelTemplate></ListBox.ItemsPanel>
              <ListBox.ItemTemplate><DataTemplate x:DataType="tools:HistoryRootChapterRow"><Grid ColumnDefinitions="Auto,Auto,*,Auto,*" ColumnSpacing="8" MinHeight="32"><SelectableTextBlock Grid.Column="0" Text="{Binding TrackName}" /><SelectableTextBlock Grid.Column="1" Text="{Binding DisplayNumber}" /><SelectableTextBlock Grid.Column="2" Text="{Binding Name}" TextWrapping="Wrap" /><SelectableTextBlock Grid.Column="3" Text="{Binding StartTime}" /><SelectableTextBlock Grid.Column="4" Text="{Binding FramesInfo}" TextWrapping="Wrap" /></Grid></DataTemplate></ListBox.ItemTemplate>
            </ListBox>
            <TextBlock Text="{Binding EffectSummary}" IsVisible="{Binding HasEffectSummary}" TextWrapping="Wrap" />
            <TextBlock Text="{DynamicResource History.Parameters}" Classes="toolLabel" IsVisible="{Binding HasParameters}" />
            <ItemsControl ItemsSource="{Binding Parameters}" IsVisible="{Binding HasParameters}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="tools:HistoryParameterRow">
                  <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                    <TextBlock Grid.Column="0" Text="{Binding Name}" />
                    <TextBlock Grid.Column="1" Text="{Binding Value}" TextWrapping="Wrap" />
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <ComboBox ItemsSource="{Binding ChangeFilters}" SelectedItem="{Binding SelectedChangeFilter}" IsVisible="{Binding HasChanges}" />
            <TextBlock Text="{DynamicResource History.NoFilteredChanges}" IsVisible="{Binding HasNoVisibleChanges}" />
            <Grid ColumnDefinitions="*,*,*,Auto" IsVisible="{Binding HasVisibleChanges}"><TextBlock Grid.Column="0" Text="{DynamicResource History.FieldHeader}" /><TextBlock Grid.Column="1" Text="{DynamicResource History.BeforeHeader}" /><TextBlock Grid.Column="2" Text="{DynamicResource History.AfterHeader}" /><TextBlock Grid.Column="3" Text="{DynamicResource History.DeltaHeader}" IsVisible="{Binding HasDeltas}" /></Grid>
            <ListBox x:Name="HistoryChanges" ItemsSource="{Binding VisibleChanges}" Height="300" IsVisible="{Binding HasVisibleChanges}">
              <ListBox.ItemsPanel><ItemsPanelTemplate><VirtualizingStackPanel /></ItemsPanelTemplate></ListBox.ItemsPanel>
              <ListBox.ItemTemplate><DataTemplate x:DataType="tools:HistoryFieldRow"><Grid ColumnDefinitions="*,*,*,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="8" Margin="0,4"><SelectableTextBlock Grid.Row="0" Grid.ColumnSpan="4" Text="{Binding ObjectLabel}" TextWrapping="Wrap" /><SelectableTextBlock Grid.Row="1" Grid.Column="0" Text="{Binding Field}" TextWrapping="Wrap" /><SelectableTextBlock Grid.Row="1" Grid.Column="1" Text="{Binding BeforeText}" TextWrapping="Wrap" /><SelectableTextBlock Grid.Row="1" Grid.Column="2" Text="{Binding AfterText}" TextWrapping="Wrap" /><SelectableTextBlock Grid.Row="1" Grid.Column="3" Text="{Binding DeltaText}" TextWrapping="Wrap" /></Grid></DataTemplate></ListBox.ItemTemplate>
            </ListBox>
          </StackPanel>
        </ScrollViewer>
      </Border>
    </Grid>
    <TabControl Grid.Row="1" SelectedIndex="{Binding NarrowPageIndex, Mode=TwoWay}" IsVisible="{Binding IsNarrowLayout}">
      <TabItem Header="{DynamicResource History.HistoryPage}">
        <TreeView x:Name="NarrowHistoryEntries" Focusable="True" AutoScrollToSelectedItem="True" ItemsSource="{Binding TreeRoots}" SelectionChanged="OnSelectionChanged"
                  Background="{DynamicResource Brush.Contents}" SelectedItem="{Binding SelectedEntry, Mode=OneWay}"
                  AutomationProperties.AutomationId="NarrowHistoryEntries">
          <TreeView.Styles><Style Selector="TreeViewItem" x:DataType="vm:HistoryEntryViewModel"><Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" /></Style></TreeView.Styles>
          <TreeView.ItemTemplate>
            <TreeDataTemplate x:DataType="vm:HistoryEntryViewModel" ItemsSource="{Binding Children}">
              <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8" MinHeight="36" AutomationProperties.Name="{Binding Title}">
                <TextBlock Grid.Column="0" Text="●" IsVisible="{Binding IsCurrent}" Foreground="{DynamicResource SystemAccentColor}"
                           AutomationProperties.Name="{DynamicResource History.Current}" />
                <TextBlock Grid.Column="1" Text="{Binding Title}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Title}" VerticalAlignment="Center" />
              </Grid>
            </TreeDataTemplate>
          </TreeView.ItemTemplate>
        </TreeView>
      </TabItem>
      <TabItem Header="{DynamicResource History.DetailsPage}">
        <Grid RowDefinitions="*,Auto">
        <ScrollViewer Grid.Row="0">
          <StackPanel x:Name="NarrowHistoryDetails" Spacing="10" Margin="12" Focusable="True">
            <TextBlock Classes="toolLabel" Text="{Binding SelectedEntry.Title}" IsVisible="{Binding HasSelection}" TextWrapping="Wrap" />
            <TextBlock Text="{Binding SelectedEntryDescription}" IsVisible="{Binding HasSelectedEntryDescription}" TextWrapping="Wrap" />
            <TextBlock Text="{Binding SelectedPublishedAtText}" IsVisible="{Binding HasPublishedAtText}" />
            <TextBlock Text="{Binding DetailErrorText}" IsVisible="{Binding HasDetailError}" TextWrapping="Wrap" />
            <Button Classes="flat" Content="{DynamicResource History.Retry}" Command="{Binding RetryCommand}" IsVisible="{Binding HasDetailError}" />
            <TextBlock Text="{DynamicResource History.Loading}" IsVisible="{Binding IsLoadingDetails}" />
            <TextBlock Text="{Binding NavigationStatus}" IsVisible="{Binding HasNavigationStatus}" TextWrapping="Wrap" />
            <TextBlock x:Name="NarrowPendingPreviewNotice" Text="{DynamicResource History.PendingPreviewNotice}" IsVisible="{Binding HasPendingPreview}" TextWrapping="Wrap" />
            <TextBlock Text="{Binding Details.RootDocument.Title}" IsVisible="{Binding IsRootDetails}" TextWrapping="Wrap" />
            <ListBox x:Name="NarrowRootChapterList" ItemsSource="{Binding RootChapterRows}" IsVisible="{Binding HasRootChapterRows}" Height="180">
              <ListBox.ItemsPanel><ItemsPanelTemplate><VirtualizingStackPanel /></ItemsPanelTemplate></ListBox.ItemsPanel>
              <ListBox.ItemTemplate><DataTemplate x:DataType="tools:HistoryRootChapterRow"><StackPanel Spacing="2"><SelectableTextBlock Text="{Binding TrackName}" /><SelectableTextBlock Text="{Binding DisplayNumber}" /><SelectableTextBlock Text="{Binding Name}" TextWrapping="Wrap" /><SelectableTextBlock Text="{Binding StartTime}" /><SelectableTextBlock Text="{Binding FramesInfo}" TextWrapping="Wrap" /></StackPanel></DataTemplate></ListBox.ItemTemplate>
            </ListBox>
            <TextBlock Text="{Binding EffectSummary}" IsVisible="{Binding HasEffectSummary}" TextWrapping="Wrap" />
            <TextBlock Text="{DynamicResource History.Parameters}" Classes="toolLabel" IsVisible="{Binding HasParameters}" />
            <ItemsControl ItemsSource="{Binding Parameters}" IsVisible="{Binding HasParameters}">
              <ItemsControl.ItemTemplate><DataTemplate x:DataType="tools:HistoryParameterRow"><StackPanel Spacing="2"><TextBlock Text="{Binding Name}" /><TextBlock Text="{Binding Value}" TextWrapping="Wrap" /></StackPanel></DataTemplate></ItemsControl.ItemTemplate>
            </ItemsControl>
            <ComboBox ItemsSource="{Binding ChangeFilters}" SelectedItem="{Binding SelectedChangeFilter}" IsVisible="{Binding HasChanges}" />
            <TextBlock Text="{DynamicResource History.NoFilteredChanges}" IsVisible="{Binding HasNoVisibleChanges}" />
            <Grid ColumnDefinitions="*,*,*,Auto" IsVisible="{Binding HasVisibleChanges}"><TextBlock Grid.Column="0" Text="{DynamicResource History.FieldHeader}" /><TextBlock Grid.Column="1" Text="{DynamicResource History.BeforeHeader}" /><TextBlock Grid.Column="2" Text="{DynamicResource History.AfterHeader}" /><TextBlock Grid.Column="3" Text="{DynamicResource History.DeltaHeader}" IsVisible="{Binding HasDeltas}" /></Grid>
            <ListBox ItemsSource="{Binding VisibleChanges}" Height="300" IsVisible="{Binding HasVisibleChanges}">
              <ListBox.ItemsPanel><ItemsPanelTemplate><VirtualizingStackPanel /></ItemsPanelTemplate></ListBox.ItemsPanel>
              <ListBox.ItemTemplate><DataTemplate x:DataType="tools:HistoryFieldRow"><Grid ColumnDefinitions="*,*,*,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="8" Margin="0,4"><SelectableTextBlock Grid.Row="0" Grid.ColumnSpan="4" Text="{Binding ObjectLabel}" TextWrapping="Wrap" /><SelectableTextBlock Grid.Row="1" Grid.Column="0" Text="{Binding Field}" TextWrapping="Wrap" /><SelectableTextBlock Grid.Row="1" Grid.Column="1" Text="{Binding BeforeText}" TextWrapping="Wrap" /><SelectableTextBlock Grid.Row="1" Grid.Column="2" Text="{Binding AfterText}" TextWrapping="Wrap" /><SelectableTextBlock Grid.Row="1" Grid.Column="3" Text="{Binding DeltaText}" TextWrapping="Wrap" /></Grid></DataTemplate></ListBox.ItemTemplate>
            </ListBox>
          </StackPanel>
        </ScrollViewer>
        <Button x:Name="NarrowRestore" Grid.Row="1" Classes="flat primary" HorizontalAlignment="Right" Content="{DynamicResource History.Restore}" Command="{Binding RestoreCommand}" CommandParameter="{Binding SelectedEntry.Id}" Margin="8" />
        </Grid>
      </TabItem>
    </TabControl>
    <Border Grid.Row="2" Classes="toolFooter">
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
        <Button x:Name="WideRestore" Classes="flat primary" Content="{DynamicResource History.Restore}" Command="{Binding RestoreCommand}"
                CommandParameter="{Binding SelectedEntry.Id}" IsVisible="{Binding IsWideLayout}" />
        <Button Classes="flat" Content="{DynamicResource History.Close}" Command="{Binding CloseCommand}" />
      </StackPanel>
    </Border>
  </Grid>
</UserControl>
