<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:i="https://github.com/projektanker/icons.avalonia"
             xmlns:vm="using:ChapterTool.Avalonia.UI.ViewModels"
             xmlns:tools="clr-namespace:ChapterTool.Avalonia.UI.ViewModels.Tools"
             x:Class="ChapterTool.Avalonia.UI.Views.Tools.SettingsToolView"
             x:DataType="vm:SettingsToolViewModel"
             x:CompileBindings="True">
  <UserControl.Styles>
    <Style Selector="TextBlock.tabHeader">
      <Setter Property="TextWrapping" Value="NoWrap" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="TextBlock.label">
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="HorizontalAlignment" Value="Right" />
      <Setter Property="TextAlignment" Value="Right" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style Selector="TextBlock.status">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Foreground" Value="{DynamicResource Brush.FG2}" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style Selector="TextBlock.aboutBody">
      <Setter Property="MaxWidth" Value="680" />
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="LineHeight" Value="22" />
    </Style>
    <Style Selector="TextBlock.repoAddress">
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="FontFamily" Value="{DynamicResource ChapterTool.MonospaceFontFamily}" />
      <Setter Property="Foreground" Value="{DynamicResource Brush.Accent}" />
    </Style>
    <Style Selector="Button.linkButton">
      <Setter Property="HorizontalAlignment" Value="Left" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Foreground" Value="{DynamicResource Brush.Accent}" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="TextBox, ComboBox">
      <Setter Property="Height" Value="32" />
      <Setter Property="MinHeight" Value="32" />
      <Setter Property="CornerRadius" Value="3" />
      <Setter Property="Background" Value="{DynamicResource Brush.Contents}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border1}" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="TextBox">
      <Setter Property="Padding" Value="8,0" />
    </Style>
    <Style Selector="Slider.toleranceSlider">
      <Setter Property="MinHeight" Value="36" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="ComboBox.outputDefaultCombo">
      <Setter Property="HorizontalAlignment" Value="Stretch" />
    </Style>
    <Style Selector="TextBlock.valueBadge">
      <Setter Property="MinWidth" Value="46" />
      <Setter Property="HorizontalAlignment" Value="Right" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="TextAlignment" Value="Right" />
    </Style>
    <Style Selector="Border.themeSwatch">
      <Setter Property="Width" Value="28" />
      <Setter Property="Height" Value="28" />
      <Setter Property="Margin" Value="0,0,4,4" />
      <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border1}" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="Border.fontPreview">
      <Setter Property="MinHeight" Value="44" />
      <Setter Property="Padding" Value="10,8" />
      <Setter Property="Background" Value="{DynamicResource Brush.Contents}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border1}" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="Button.compact">
      <Setter Property="Width" Value="30" />
      <Setter Property="MinWidth" Value="30" />
      <Setter Property="Height" Value="30" />
      <Setter Property="MinHeight" Value="30" />
      <Setter Property="Padding" Value="0" />
    </Style>
    <Style Selector="Button.inputAction">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="0" />
      <Setter Property="Foreground" Value="{DynamicResource Brush.FG1}" />
      <Setter Property="Opacity" Value="0.9" />
    </Style>
    <Style Selector="Button.inputAction:pointerover">
      <Setter Property="Opacity" Value="1" />
    </Style>
    <Style Selector="Button.footerAction">
      <Setter Property="Height" Value="30" />
      <Setter Property="MinHeight" Value="30" />
      <Setter Property="MinWidth" Value="100" />
      <Setter Property="Padding" Value="16,0" />
    </Style>
  </UserControl.Styles>

  <Grid RowDefinitions="*,Auto">
    <TabControl Grid.Row="0">
      <TabItem>
        <TabItem.Header>
          <TextBlock Classes="tabHeader" Text="{DynamicResource Settings.General}" />
        </TabItem.Header>
        <ScrollViewer HorizontalScrollBarVisibility="Disabled">
          <StackPanel Spacing="8" Margin="16,12">
            <Grid ColumnDefinitions="1*,4*" RowDefinitions="Auto,Auto" RowSpacing="8" ColumnSpacing="12">
              <TextBlock Grid.Row="0" Grid.Column="0" Classes="label" Text="{DynamicResource Settings.UiLanguage}" />
              <ComboBox x:Name="GeneralLanguageCombo"
                        Grid.Row="0"
                        Grid.Column="1"
                        ItemsSource="{Binding Languages}"
                        SelectedIndex="{Binding SelectedLanguageIndex}">
                <ComboBox.ItemTemplate>
                  <DataTemplate DataType="tools:LanguageOptionViewModel">
                    <TextBlock Text="{Binding DisplayName}" />
                  </DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>

              <TextBlock Grid.Row="1" Grid.Column="0" Classes="label" IsVisible="{Binding IsSaveDirectoryVisible}" Text="{DynamicResource Settings.SaveDirectory}" />
              <TextBox x:Name="SaveDirectoryTextBox"
                       Grid.Row="1"
                       Grid.Column="1"
                       IsVisible="{Binding IsSaveDirectoryVisible}"
                       Text="{Binding SaveDirectory, Mode=TwoWay}"
                       PlaceholderText="{DynamicResource Settings.EmptyUsesSource}">
                <TextBox.InnerRightContent>
                  <StackPanel Orientation="Horizontal">
                    <Button x:Name="BrowseSaveDirectoryButton"
                            Classes="icon_button compact inputAction"
                            Command="{Binding BrowseSaveDirectoryCommand}"
                            AutomationProperties.Name="{DynamicResource Settings.BrowseDirectory}"
                            ToolTip.Tip="{DynamicResource Settings.BrowseDirectory}">
                      <i:Icon Width="15" Height="15" Value="fa-solid fa-folder-open" />
                    </Button>
                    <Button x:Name="ClearSaveDirectoryButton"
                            Classes="icon_button compact inputAction"
                            Command="{Binding ClearSaveDirectoryCommand}"
                            AutomationProperties.Name="{DynamicResource Common.Clear}"
                            ToolTip.Tip="{DynamicResource Common.Clear}">
                      <i:Icon Width="14" Height="14" Value="fa-solid fa-xmark" />
                    </Button>
                  </StackPanel>
                </TextBox.InnerRightContent>
              </TextBox>
            </Grid>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <TabItem IsVisible="{Binding IsExternalToolsVisible}">
        <TabItem.Header>
          <TextBlock Classes="tabHeader" Text="{DynamicResource Settings.ExternalTools}" />
        </TabItem.Header>
        <ScrollViewer HorizontalScrollBarVisibility="Disabled">
          <StackPanel Spacing="8" Margin="16,12">
            <Grid ColumnDefinitions="1*,4*" RowDefinitions="Auto,Auto,Auto" RowSpacing="8" ColumnSpacing="12">
              <TextBlock Grid.Row="0" Grid.Column="0" Classes="label" Text="{DynamicResource Settings.MkvToolnixPath}" />
              <Grid Grid.Row="0" Grid.Column="1" RowDefinitions="Auto,Auto" RowSpacing="3">
                <TextBox Text="{Binding MkvToolnixPath, Mode=TwoWay}">
                  <TextBox.InnerRightContent>
                    <StackPanel Orientation="Horizontal">
                      <Button Classes="icon_button compact inputAction" Command="{Binding BrowseMkvToolnixCommand}" AutomationProperties.Name="{DynamicResource Settings.BrowseExecutable}" ToolTip.Tip="{DynamicResource Settings.BrowseExecutable}">
                        <i:Icon Width="15" Height="15" Value="fa-solid fa-folder-open" />
                      </Button>
                      <Button Classes="icon_button compact inputAction" Command="{Binding ClearMkvToolnixCommand}" AutomationProperties.Name="{DynamicResource Common.Clear}" ToolTip.Tip="{DynamicResource Common.Clear}">
                        <i:Icon Width="14" Height="14" Value="fa-solid fa-xmark" />
                      </Button>
                    </StackPanel>
                  </TextBox.InnerRightContent>
                </TextBox>
                <TextBlock Grid.Row="1" Classes="status" Text="{Binding MkvToolnixStatus}" />
              </Grid>

              <TextBlock Grid.Row="1" Grid.Column="0" Classes="label" Text="{DynamicResource Settings.FfprobePath}" />
              <Grid Grid.Row="1" Grid.Column="1" RowDefinitions="Auto,Auto" RowSpacing="3">
                <TextBox Text="{Binding FfprobePath, Mode=TwoWay}">
                  <TextBox.InnerRightContent>
                    <StackPanel Orientation="Horizontal">
                      <Button Classes="icon_button compact inputAction" Command="{Binding BrowseFfprobeCommand}" AutomationProperties.Name="{DynamicResource Settings.BrowseExecutable}" ToolTip.Tip="{DynamicResource Settings.BrowseExecutable}">
                        <i:Icon Width="15" Height="15" Value="fa-solid fa-folder-open" />
                      </Button>
                      <Button Classes="icon_button compact inputAction" Command="{Binding ClearFfprobeCommand}" AutomationProperties.Name="{DynamicResource Common.Clear}" ToolTip.Tip="{DynamicResource Common.Clear}">
                        <i:Icon Width="14" Height="14" Value="fa-solid fa-xmark" />
                      </Button>
                    </StackPanel>
                  </TextBox.InnerRightContent>
                </TextBox>
                <TextBlock Grid.Row="1" Classes="status" Text="{Binding FfprobeStatus}" />
              </Grid>

              <Button Grid.Row="2"
                      Grid.Column="1"
                      Classes="flat"
                      HorizontalAlignment="Left"
                      Command="{Binding ValidateToolsCommand}"
                      ToolTip.Tip="{DynamicResource Settings.ValidateTools}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <i:Icon Width="14" Height="14" Value="fa-solid fa-magnifying-glass" />
                  <TextBlock Text="{DynamicResource Settings.ValidateTools}" />
                </StackPanel>
              </Button>
            </Grid>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <TabItem>
        <TabItem.Header>
          <TextBlock Classes="tabHeader" Text="{DynamicResource Settings.OutputDefaults}" />
        </TabItem.Header>
        <ScrollViewer HorizontalScrollBarVisibility="Disabled">
        <StackPanel Spacing="8" Margin="16,12">
          <Grid ColumnDefinitions="1*,4*" RowDefinitions="Auto,Auto,Auto,Auto,Auto" RowSpacing="8" ColumnSpacing="12">
            <TextBlock Grid.Row="0" Grid.Column="0" Classes="label" Text="{DynamicResource Settings.DefaultSaveFormat}" />
            <ComboBox x:Name="DefaultSaveFormatCombo"
                      Grid.Row="0"
                      Grid.Column="1"
                      Classes="outputDefaultCombo"
                      ItemsSource="{Binding SaveFormatOptions}"
                      SelectedIndex="{Binding DefaultSaveFormatIndex}" />
            <TextBlock Grid.Row="1" Grid.Column="0" Classes="label" Text="{DynamicResource Settings.DefaultXmlLanguage}" />
            <ComboBox x:Name="DefaultXmlLanguageCombo"
                      Grid.Row="1"
                      Grid.Column="1"
                      Classes="outputDefaultCombo"
                      ItemsSource="{Binding XmlLanguageDisplayOptions}"
                      SelectedItem="{Binding SelectedDefaultXmlLanguageDisplayOption, Mode=TwoWay}">
              <ComboBox.ItemTemplate>
                <DataTemplate x:DataType="vm:SelectorDisplayOption">
                  <TextBlock VerticalAlignment="Center" Text="{Binding DisplayText}" TextTrimming="CharacterEllipsis" />
                </DataTemplate>
              </ComboBox.ItemTemplate>
              <ComboBox.SelectionBoxItemTemplate>
                <DataTemplate x:DataType="vm:SelectorDisplayOption">
                  <TextBlock VerticalAlignment="Center" Text="{Binding DisplayText}" TextTrimming="CharacterEllipsis" />
                </DataTemplate>
              </ComboBox.SelectionBoxItemTemplate>
            </ComboBox>
            <TextBlock Grid.Row="2" Grid.Column="0" Classes="label" Text="{DynamicResource Settings.OutputTextEncoding}" />
            <ComboBox Grid.Row="2"
                      Grid.Column="1"
                      Classes="outputDefaultCombo"
                      ItemsSource="{Binding OutputTextEncodingOptions}"
                      SelectedIndex="{Binding OutputTextEncodingIndex}" />
            <TextBlock Grid.Row="3" Grid.Column="0" Classes="label" Text="{DynamicResource Settings.EmitBom}" />
            <CheckBox Grid.Row="3"
                      Grid.Column="1"
                      IsChecked="{Binding EmitBom}"
                      VerticalAlignment="Center" />
            <TextBlock Grid.Row="4" Grid.Column="0" Classes="label" Text="{DynamicResource Settings.FrameAccuracyTolerance}" />
            <Grid Grid.Row="4" Grid.Column="1" ColumnDefinitions="*,Auto" ColumnSpacing="10">
              <Slider Grid.Column="0"
                      Classes="toleranceSlider"
                      Minimum="0.01"
                      Maximum="0.30"
                      Ticks="0.05,0.10,0.15,0.20,0.25,0.30"
                      TickPlacement="BottomRight"
                      IsSnapToTickEnabled="False"
                      Value="{Binding FrameAccuracyToleranceSliderValue}" />
              <TextBlock Grid.Column="1"
                         Classes="valueBadge"
                         Text="{Binding FrameAccuracyToleranceDisplayText}" />
            </Grid>
          </Grid>
        </StackPanel>
        </ScrollViewer>
      </TabItem>

      <TabItem>
        <TabItem.Header>
          <TextBlock Classes="tabHeader" Text="{DynamicResource Settings.Appearance}" />
        </TabItem.Header>
        <ScrollViewer HorizontalScrollBarVisibility="Disabled">
          <StackPanel Spacing="8" Margin="16,12">
            <Grid ColumnDefinitions="1*,4*" RowDefinitions="Auto,Auto,Auto,Auto" ColumnSpacing="12" RowSpacing="8">
              <TextBlock Grid.Row="0" Grid.Column="0" Classes="label" Text="{DynamicResource Settings.Appearance.Preset}" />
              <ComboBox x:Name="ThemePresetCombo"
                        Grid.Row="0"
                        Grid.Column="1"
                        HorizontalAlignment="Stretch"
                        ItemsSource="{Binding Appearance.ThemePresets}"
                        SelectedIndex="{Binding Appearance.SelectedThemePresetIndex}">
                <ComboBox.ItemTemplate>
                  <DataTemplate x:DataType="vm:ThemePresetOptionViewModel">
                    <TextBlock Text="{Binding DisplayName}" />
                  </DataTemplate>
                </ComboBox.ItemTemplate>
                <ComboBox.SelectionBoxItemTemplate>
                  <DataTemplate x:DataType="vm:ThemePresetOptionViewModel">
                    <TextBlock Text="{Binding DisplayName}" />
                  </DataTemplate>
                </ComboBox.SelectionBoxItemTemplate>
              </ComboBox>
              <TextBlock Grid.Row="1" Grid.Column="0" Classes="label" Text="{DynamicResource Settings.Appearance.Preview}" />
              <ItemsControl x:Name="ThemePalettePreview"
                            Grid.Row="1"
                            Grid.Column="1"
                            HorizontalAlignment="Left"
                            ItemsSource="{Binding Appearance.SelectedThemePreset.PreviewSwatches}"
                            AutomationProperties.Name="{Binding Appearance.ThemePreviewAutomationName}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <WrapPanel Orientation="Horizontal" />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:ThemeSwatchViewModel">
                    <Border Classes="themeSwatch" Background="{Binding Color}" />
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>

              <TextBlock Grid.Row="2" Grid.Column="0" Classes="label" Text="{DynamicResource Settings.Appearance.UiFont}" />
              <StackPanel Grid.Row="2" Grid.Column="1" Spacing="6" HorizontalAlignment="Stretch">
                <ComboBox x:Name="UiFontFamilyCombo"
                          MinWidth="240"
                          HorizontalAlignment="Stretch"
                          ItemsSource="{Binding Appearance.UiFontFamilies}"
                          SelectedIndex="{Binding Appearance.SelectedUiFontFamilyIndex}">
                  <ComboBox.ItemsPanel>
                    <ItemsPanelTemplate>
                      <VirtualizingStackPanel />
                    </ItemsPanelTemplate>
                  </ComboBox.ItemsPanel>
                  <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:FontFamilyOptionViewModel">
                      <TextBlock Text="{Binding DisplayName}"
                                 FontFamily="{Binding PreviewFontFamily}"
                                 TextTrimming="CharacterEllipsis" />
                    </DataTemplate>
                  </ComboBox.ItemTemplate>
                  <ComboBox.SelectionBoxItemTemplate>
                    <DataTemplate x:DataType="vm:FontFamilyOptionViewModel">
                      <TextBlock Text="{Binding DisplayName}"
                                 FontFamily="{Binding PreviewFontFamily}"
                                 TextTrimming="CharacterEllipsis" />
                    </DataTemplate>
                  </ComboBox.SelectionBoxItemTemplate>
                </ComboBox>
                <Border x:Name="UiFontPreview"
                        Classes="fontPreview"
                        AutomationProperties.Name="{Binding Appearance.UiFontPreviewAutomationName}">
                  <TextBlock FontFamily="{DynamicResource ChapterTool.UiFontFamily}"
                             Text="{Binding Appearance.FontPreviewText}"
                             TextTrimming="CharacterEllipsis" />
                </Border>
              </StackPanel>

              <TextBlock Grid.Row="3" Grid.Column="0" Classes="label" Text="{DynamicResource Settings.Appearance.MonospaceFont}" />
              <StackPanel Grid.Row="3" Grid.Column="1" Spacing="6" HorizontalAlignment="Stretch">
                <ComboBox x:Name="MonospaceFontFamilyCombo"
                          MinWidth="240"
                          HorizontalAlignment="Stretch"
                          ItemsSource="{Binding Appearance.MonospaceFontFamilies}"
                          SelectedIndex="{Binding Appearance.SelectedMonospaceFontFamilyIndex}">
                  <ComboBox.ItemsPanel>
                    <ItemsPanelTemplate>
                      <VirtualizingStackPanel />
                    </ItemsPanelTemplate>
                  </ComboBox.ItemsPanel>
                  <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:FontFamilyOptionViewModel">
                      <TextBlock Text="{Binding DisplayName}"
                                 FontFamily="{Binding PreviewFontFamily}"
                                 TextTrimming="CharacterEllipsis" />
                    </DataTemplate>
                  </ComboBox.ItemTemplate>
                  <ComboBox.SelectionBoxItemTemplate>
                    <DataTemplate x:DataType="vm:FontFamilyOptionViewModel">
                      <TextBlock Text="{Binding DisplayName}"
                                 FontFamily="{Binding PreviewFontFamily}"
                                 TextTrimming="CharacterEllipsis" />
                    </DataTemplate>
                  </ComboBox.SelectionBoxItemTemplate>
                </ComboBox>
                <Border x:Name="MonospaceFontPreview"
                        Classes="fontPreview"
                        AutomationProperties.Name="{Binding Appearance.MonospaceFontPreviewAutomationName}">
                  <TextBlock FontFamily="{DynamicResource ChapterTool.MonospaceFontFamily}"
                             Text="{Binding Appearance.FontPreviewText}"
                             TextTrimming="CharacterEllipsis" />
                </Border>
              </StackPanel>
            </Grid>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <TabItem>
        <TabItem.Header>
          <TextBlock Classes="tabHeader" Text="{DynamicResource Settings.About}" />
        </TabItem.Header>
        <ScrollViewer HorizontalScrollBarVisibility="Disabled">
          <StackPanel Spacing="10" Margin="16,12">
            <TextBlock Classes="aboutBody" Text="{DynamicResource Settings.About.Description}" />
            <StackPanel Spacing="4">
              <TextBlock Classes="status" Text="{Binding AvaloniaRuntimeDisplay}" />
              <TextBlock Classes="status" Text="{Binding DotNetRuntimeDisplay}" />
            </StackPanel>
            <TextBlock Classes="status" Text="{DynamicResource Settings.About.License}" />
            <Button Classes="linkButton"
                    Command="{Binding OpenRepositoryCommand}"
                    ToolTip.Tip="{DynamicResource Settings.About.OpenRepository}">
              <TextBlock Classes="repoAddress" Text="{DynamicResource Settings.About.RepositoryUrl}" />
            </Button>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

    </TabControl>

    <Border x:Name="SettingsFooter"
            Grid.Row="1"
            Height="48"
            Padding="12,8"
            Background="{DynamicResource Brush.ToolBar}"
            BorderBrush="{DynamicResource Brush.Border2}"
            BorderThickness="0,1,0,0">
      <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto" ColumnSpacing="8">
        <Button x:Name="OpenSettingsFolderButton"
                Grid.Column="0"
                Classes="icon_button compact"
                IsVisible="{Binding IsSettingsFolderVisible}"
                Command="{Binding OpenSettingsFolderCommand}"
                AutomationProperties.Name="{DynamicResource Settings.OpenSettingsFolder}"
                ToolTip.Tip="{DynamicResource Settings.OpenSettingsFolder}">
          <i:Icon Width="15" Height="15" Value="fa-solid fa-folder-open" />
        </Button>
        <TextBlock Grid.Column="1"
                   Classes="status"
                   VerticalAlignment="Center"
                   Text="{Binding StatusText}"
                   TextTrimming="CharacterEllipsis" />
        <Button x:Name="ResetSettingsButton"
                Grid.Column="3"
                Classes="flat footerAction"
                Content="{DynamicResource Settings.ResetDefaults}"
                Command="{Binding ResetCommand}" />
        <Button x:Name="SaveSettingsButton"
                Grid.Column="4"
                Classes="flat primary footerAction"
                Content="{DynamicResource Common.Save}"
                Command="{Binding SaveCommand}" />
      </Grid>
    </Border>
  </Grid>
</UserControl>
