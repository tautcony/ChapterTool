<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:i="https://github.com/projektanker/icons.avalonia"
             xmlns:vm="using:ChapterTool.Avalonia.UI.ViewModels.Tools"
             x:Class="ChapterTool.Avalonia.UI.Views.Tools.LogToolView"
             x:Name="RootView"
             x:DataType="vm:LogToolViewModel"
             x:CompileBindings="True"
             Focusable="True"
             DataContextChanged="OnDataContextChanged"
             SizeChanged="OnSizeChanged"
             KeyDown="OnKeyDown">
  <UserControl.Styles>
    <Style Selector="ListBoxItem">
      <Setter Property="MinHeight" Value="42" />
      <Setter Property="Padding" Value="6,5" />
      <Setter Property="Margin" Value="0,1" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    </Style>
    <Style Selector="Button.logDetailsAction">
      <Setter Property="Width" Value="28" />
      <Setter Property="Height" Value="28" />
      <Setter Property="MinWidth" Value="28" />
      <Setter Property="MinHeight" Value="28" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="Border.logHighlightMatch">
      <Setter Property="Background" Value="{DynamicResource Brush.AccentHovered}" />
      <Setter Property="CornerRadius" Value="2" />
      <Setter Property="Padding" Value="1,0" />
    </Style>
    <Style Selector="TextBlock.logMuted">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="Foreground" Value="{DynamicResource Brush.FG2}" />
      <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>
    <Style Selector="TextBlock.logSectionTitle">
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="FontSize" Value="13" />
    </Style>
    <Style Selector="TextBlock.logMono">
      <Setter Property="FontFamily" Value="{DynamicResource ChapterTool.MonospaceFontFamily}" />
      <Setter Property="FontSize" Value="12" />
    </Style>
  </UserControl.Styles>

  <Grid RowDefinitions="Auto,*,Auto"
        RowSpacing="8"
        Margin="8"
        Background="{DynamicResource Brush.Window}"
        MinWidth="0"
        MinHeight="0"
        ClipToBounds="True">
    <Grid Grid.Row="0"
          Classes="toolToolbar"
          ColumnDefinitions="Auto,*,Auto"
          ColumnSpacing="8"
          MinWidth="0">
      <TextBlock Grid.Column="0"
                 VerticalAlignment="Center"
                 Foreground="{DynamicResource Brush.FG2}"
                 Text="{Binding EntryCountText}" />

      <TextBox x:Name="LogSearch"
               Grid.Column="1"
               MinWidth="0"
               Height="32"
               HorizontalAlignment="Stretch"
               PlaceholderText="{DynamicResource Tool.Log.SearchPlaceholder}"
               Text="{Binding SearchText, Mode=TwoWay}"
               AutomationProperties.Name="{DynamicResource Tool.Log.SearchPlaceholder}" />

      <StackPanel Grid.Column="2"
                  Orientation="Horizontal"
                  Spacing="4"
                  VerticalAlignment="Center">
        <Button x:Name="LogFilterButton"
                Classes="icon_button"
                Width="32"
                Height="32"
                AutomationProperties.Name="{DynamicResource Tool.Log.Filter}"
                ToolTip.Tip="{DynamicResource Tool.Log.Filter}">
          <Grid Width="16" Height="16">
            <i:Icon Width="15" Height="15" Value="fa-solid fa-filter" />
            <Border HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    MinWidth="11"
                    Height="11"
                    Padding="1,0"
                    Background="{DynamicResource Brush.Accent}"
                    CornerRadius="6"
                    IsVisible="{Binding HasActiveFilters}">
              <TextBlock FontSize="8"
                         Foreground="{DynamicResource AccentButtonForeground}"
                         HorizontalAlignment="Center"
                         Text="{Binding ActiveFilterCount}" />
            </Border>
          </Grid>
          <Button.Flyout>
            <Flyout Placement="BottomEdgeAlignedRight">
              <Border Padding="12"
                      MinWidth="240"
                      Background="{DynamicResource Brush.Contents}"
                      BorderBrush="{DynamicResource Brush.Border2}"
                      BorderThickness="1">
                <StackPanel Spacing="8">
                  <TextBlock Classes="bold" Text="{DynamicResource Tool.Log.Filter}" />
                  <TextBlock Classes="logMuted" Text="{DynamicResource Tool.Log.FilterLevelLabel}" />
                  <ComboBox x:Name="LogSeverityFilter"
                            Height="32"
                            ItemsSource="{Binding FilterOptions}"
                            SelectedItem="{Binding SelectedFilter, Mode=TwoWay}"
                            AutomationProperties.Name="{DynamicResource Tool.Log.FilterLevelLabel}">
                    <ComboBox.ItemTemplate>
                      <DataTemplate x:DataType="vm:LogFilterOption">
                        <TextBlock Text="{Binding DisplayName}" />
                      </DataTemplate>
                    </ComboBox.ItemTemplate>
                  </ComboBox>
                  <Button Classes="flat"
                          HorizontalAlignment="Left"
                          Command="{Binding #RootView.((vm:LogToolViewModel)DataContext).ResetFiltersCommand}"
                          AutomationProperties.Name="{DynamicResource Tool.Log.ResetFilters}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                      <i:Icon Width="13" Height="13" Value="fa-solid fa-rotate-left" />
                      <TextBlock Text="{DynamicResource Tool.Log.ResetFilters}" />
                    </StackPanel>
                  </Button>
                </StackPanel>
              </Border>
            </Flyout>
          </Button.Flyout>
        </Button>

        <Button x:Name="LogMoreButton"
                Classes="icon_button"
                Width="32"
                Height="32"
                IsVisible="{Binding HasSecondaryActions}"
                AutomationProperties.Name="{DynamicResource Tool.Log.MoreActions}"
                ToolTip.Tip="{DynamicResource Tool.Log.MoreActions}">
          <i:Icon Width="15" Height="15" Value="fa-solid fa-ellipsis" />
          <Button.Flyout>
            <Flyout Placement="BottomEdgeAlignedRight">
              <Border Padding="12"
                      MinWidth="220"
                      Background="{DynamicResource Brush.Contents}"
                      BorderBrush="{DynamicResource Brush.Border2}"
                      BorderThickness="1">
                <StackPanel Spacing="6">
                  <TextBlock Classes="bold" Text="{DynamicResource Tool.Log.MoreActions}" />
                  <ComboBox x:Name="LogExportFormat"
                            Height="32"
                            IsVisible="{Binding CanExport}"
                            ItemsSource="{Binding ExportFormatOptions}"
                            SelectedItem="{Binding SelectedExportFormat, Mode=TwoWay}"
                            AutomationProperties.Name="{DynamicResource Tool.Log.ExportFormat}">
                    <ComboBox.ItemTemplate>
                      <DataTemplate x:DataType="vm:LogExportFormatOption">
                        <TextBlock Text="{Binding DisplayName}" />
                      </DataTemplate>
                    </ComboBox.ItemTemplate>
                  </ComboBox>
                  <Button Classes="flat"
                          HorizontalAlignment="Left"
                          IsVisible="{Binding CanExport}"
                          Command="{Binding #RootView.((vm:LogToolViewModel)DataContext).ExportCommand}"
                          AutomationProperties.Name="{DynamicResource Tool.Log.Export}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                      <i:Icon Width="13" Height="13" Value="fa-solid fa-download" />
                      <TextBlock Text="{DynamicResource Tool.Log.Export}" />
                    </StackPanel>
                  </Button>
                  <Separator />
                  <Button Classes="flat"
                          HorizontalAlignment="Left"
                          IsVisible="{Binding CanCopySelected}"
                          Command="{Binding #RootView.((vm:LogToolViewModel)DataContext).CopySummaryCommand}"
                          AutomationProperties.Name="{DynamicResource Tool.Log.CopySummary}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                      <i:Icon Width="13" Height="13" Value="fa-solid fa-copy" />
                      <TextBlock Text="{DynamicResource Tool.Log.CopySummary}" />
                    </StackPanel>
                  </Button>
                  <Button Classes="flat"
                          HorizontalAlignment="Left"
                          IsVisible="{Binding CanCopySelected}"
                          Command="{Binding #RootView.((vm:LogToolViewModel)DataContext).CopyDetailsCommand}"
                          AutomationProperties.Name="{DynamicResource Tool.Log.CopyDetails}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                      <i:Icon Width="13" Height="13" Value="fa-solid fa-file-lines" />
                      <TextBlock Text="{DynamicResource Tool.Log.CopyDetails}" />
                    </StackPanel>
                  </Button>
                  <Button Classes="flat"
                          HorizontalAlignment="Left"
                          IsVisible="{Binding HasRetainedEntries}"
                          Command="{Binding #RootView.((vm:LogToolViewModel)DataContext).ClearCommand}"
                          AutomationProperties.Name="{DynamicResource Common.Clear}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                      <i:Icon Width="13" Height="13" Value="fa-solid fa-trash-can" />
                      <TextBlock Text="{DynamicResource Common.Clear}" />
                    </StackPanel>
                  </Button>
                </StackPanel>
              </Border>
            </Flyout>
          </Button.Flyout>
        </Button>

      </StackPanel>
    </Grid>

    <Grid x:Name="LogContentSurface" Grid.Row="1" MinWidth="0" MinHeight="0">
      <Border Background="{DynamicResource Brush.Contents}"
              BorderBrush="{DynamicResource Brush.Border2}"
              BorderThickness="1"
              ClipToBounds="True">
        <Grid x:Name="LogLayout"
              ColumnDefinitions="*,0"
              MinWidth="0"
              MinHeight="0">
          <Grid x:Name="LogListHost"
                Grid.Column="0"
                MinWidth="0"
                MinHeight="0">
          <ListBox x:Name="LogList"
                   Padding="4"
                   Background="Transparent"
                   BorderThickness="0"
                   ItemsSource="{Binding FilteredEntries}"
                   SelectedItem="{Binding SelectedEntry, Mode=TwoWay}"
                   SelectionMode="Single"
                   IsVisible="True"
                   AutomationProperties.Name="{DynamicResource Tool.Log.Title}"
                   ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                   ScrollViewer.VerticalScrollBarVisibility="Auto">
            <ListBox.ItemsPanel>
              <ItemsPanelTemplate>
                <VirtualizingStackPanel Orientation="Vertical" />
              </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="vm:LogEntryViewModel">
                <Grid ColumnDefinitions="4,Auto,*,Auto,28"
                      ColumnSpacing="8"
                      MinWidth="0"
                      AutomationProperties.Name="{Binding AccessibleName}">
                  <Border Grid.Column="0"
                          Width="4"
                          CornerRadius="2"
                          Background="{DynamicResource ChapterTool.LogInformationBrush}"
                          IsVisible="{Binding IsInformation}" />
                  <Border Grid.Column="0"
                          Width="4"
                          CornerRadius="2"
                          Background="{DynamicResource ChapterTool.LogWarningBrush}"
                          IsVisible="{Binding IsWarning}" />
                  <Border Grid.Column="0"
                          Width="4"
                          CornerRadius="2"
                          Background="{DynamicResource ChapterTool.LogErrorBrush}"
                          IsVisible="{Binding IsError}" />

                  <TextBlock Grid.Column="1"
                             Classes="logMuted"
                             VerticalAlignment="Center"
                             Text="{Binding LevelText}" />

                  <Grid Grid.Column="2"
                        RowDefinitions="Auto,Auto"
                        MinWidth="0"
                        VerticalAlignment="Center"
                        ClipToBounds="True">
                    <Grid ColumnDefinitions="*,Auto"
                          MinWidth="0"
                          ClipToBounds="True">
                      <TextBlock Grid.Column="0"
                                 Text="{Binding CompactSummary}"
                                 FontSize="14"
                                 TextTrimming="CharacterEllipsis"
                                 VerticalAlignment="Center"
                                 ClipToBounds="True" />
                      <i:Icon Grid.Column="1"
                              Width="13"
                              Height="13"
                              Margin="6,0,0,0"
                              VerticalAlignment="Center"
                              Foreground="{DynamicResource Brush.FG2}"
                              Value="fa-solid fa-circle-info"
                              IsVisible="{Binding HasAdditionalSearchMatch}"
                              AutomationProperties.Name="{Binding SearchMatchIndicatorText}"
                              ToolTip.Tip="{Binding SearchMatchIndicatorText}" />
                    </Grid>
                    <TextBlock Grid.Row="1"
                               Classes="logMuted"
                               IsVisible="{Binding HasRowContext}"
                               Text="{Binding RowContext}"
                               ToolTip.Tip="{Binding Context}" />
                  </Grid>

                  <TextBlock Grid.Column="3"
                             Classes="logMuted"
                             VerticalAlignment="Center"
                             Text="{Binding Time}" />

                  <Button Grid.Column="4"
                          Classes="logDetailsAction"
                          Command="{Binding #RootView.((vm:LogToolViewModel)DataContext).OpenDetailsCommand}"
                          CommandParameter="{Binding}"
                          AutomationProperties.Name="{Binding DetailsActionText}"
                          ToolTip.Tip="{Binding DetailsActionText}">
                    <i:Icon Width="13" Height="13" Value="fa-solid fa-chevron-right" />
                  </Button>
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>

          <StackPanel HorizontalAlignment="Center"
                      VerticalAlignment="Center"
                      Spacing="8"
                      Margin="24"
                      IsVisible="{Binding !HasRetainedEntries}">
            <i:Icon Width="36" Height="36"
                    Value="fa-solid fa-inbox"
                    Foreground="{DynamicResource Brush.FG2}" />
            <TextBlock Foreground="{DynamicResource Brush.FG2}"
                       Text="{DynamicResource Tool.Log.NoEntries}"
                       TextWrapping="Wrap"
                       TextAlignment="Center" />
          </StackPanel>

          <StackPanel HorizontalAlignment="Center"
                      VerticalAlignment="Center"
                      Spacing="8"
                      Margin="24"
                      IsVisible="{Binding HasNoResults}">
            <i:Icon Width="36" Height="36"
                    Value="fa-solid fa-filter-circle-xmark"
                    Foreground="{DynamicResource Brush.FG2}" />
            <TextBlock Foreground="{DynamicResource Brush.FG2}"
                       Text="{DynamicResource Tool.Log.NoMatches}"
                       TextWrapping="Wrap"
                       TextAlignment="Center" />
            <Button Classes="flat"
                    Command="{Binding ResetFiltersCommand}"
                    AutomationProperties.Name="{DynamicResource Tool.Log.ResetFilters}">
              <TextBlock Text="{DynamicResource Tool.Log.ResetFilters}" />
            </Button>
          </StackPanel>

          </Grid>

          <Border x:Name="LogDetailsPanel"
                  Grid.Column="1"
                  HorizontalAlignment="Stretch"
                  VerticalAlignment="Stretch"
                  MaxWidth="480"
                  MinWidth="0"
                  Background="{DynamicResource Brush.Contents}"
                  BorderBrush="{DynamicResource Brush.Border2}"
                  BorderThickness="1,0,0,0"
                  IsVisible="{Binding ShowDetails}"
                  ClipToBounds="True">
            <Grid RowDefinitions="Auto,*" MinWidth="0" MinHeight="0">
              <Border Grid.Row="0"
                      Padding="12,10"
                      BorderBrush="{DynamicResource Brush.Border2}"
                      BorderThickness="0,0,0,1"
                      MinWidth="0">
                <Grid ColumnDefinitions="*,Auto,Auto"
                      ColumnSpacing="4"
                      MinWidth="0">
                  <StackPanel Grid.Column="0" Spacing="2" MinWidth="0">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <TextBlock FontWeight="SemiBold"
                                 Text="{Binding SelectedEntry.LevelText}" />
                      <TextBlock Classes="logMuted"
                                 Text="{Binding SelectedEntry.Time}" />
                    </StackPanel>
                    <TextBlock Classes="logMuted"
                               Text="{Binding SelectedEntry.Context}"
                               IsVisible="{Binding SelectedEntry.HasContext}"
                               TextTrimming="CharacterEllipsis"
                               ToolTip.Tip="{Binding SelectedEntry.Context}" />
                  </StackPanel>
                  <Button Grid.Column="1"
                          Classes="icon_button"
                          Width="30"
                          Height="30"
                          IsVisible="{Binding CanCopySelected}"
                          Command="{Binding CopyDetailsCommand}"
                          AutomationProperties.Name="{DynamicResource Tool.Log.CopyDetails}"
                          ToolTip.Tip="{DynamicResource Tool.Log.CopyDetails}">
                    <i:Icon Width="13" Height="13" Value="fa-solid fa-copy" />
                  </Button>
                  <Button x:Name="LogDetailsCloseButton"
                          Grid.Column="2"
                          Classes="icon_button"
                          Width="30"
                          Height="30"
                          Command="{Binding CloseDetailsCommand}"
                          AutomationProperties.Name="{DynamicResource Tool.Log.CloseDetails}"
                          ToolTip.Tip="{DynamicResource Tool.Log.CloseDetails}">
                    <i:Icon Width="13" Height="13" Value="fa-solid fa-xmark" />
                  </Button>
                </Grid>
              </Border>

              <TabControl x:Name="LogDetailsTabs" Grid.Row="1" Margin="12,8" TabStripPlacement="Top">
                <TabItem Header="{DynamicResource Tool.Log.Overview}">
                  <ScrollViewer Padding="0,8" VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="12">
                      <StackPanel Spacing="4" IsVisible="{Binding SelectedEntry.HasSummary}">
                        <TextBlock Classes="logSectionTitle" Text="{DynamicResource Tool.Log.Message}" />
                        <SelectableTextBlock Text="{Binding SelectedEntry.Summary}" TextWrapping="Wrap" />
                      </StackPanel>
                      <StackPanel Spacing="4" IsVisible="{Binding SelectedEntry.HasTechnicalDetail}">
                        <TextBlock Classes="logSectionTitle" Text="{DynamicResource Tool.Log.TechnicalDetail}" />
                        <SelectableTextBlock Classes="logMono" Text="{Binding SelectedEntry.TechnicalDetail}" TextWrapping="Wrap" />
                      </StackPanel>
                      <StackPanel Spacing="4" IsVisible="{Binding SelectedEntry.HasException}">
                        <TextBlock Classes="logSectionTitle" Text="{DynamicResource Tool.Log.Exception}" />
                        <SelectableTextBlock Classes="logMono" Text="{Binding SelectedEntry.ExceptionText}" TextWrapping="Wrap" />
                      </StackPanel>
                      <TextBlock Foreground="{DynamicResource Brush.FG2}" Text="{DynamicResource Tool.Log.NoDetails}" TextWrapping="Wrap" IsVisible="{Binding SelectedEntry.ShowNoDetails}" />
                    </StackPanel>
                  </ScrollViewer>
                </TabItem>
                <TabItem Header="{DynamicResource Tool.Log.Properties}">
                  <ScrollViewer Padding="0,8" VerticalScrollBarVisibility="Auto">
                    <Grid>
                      <ItemsControl ItemsSource="{Binding SelectedEntry.StructuredProperties}" IsVisible="{Binding SelectedEntry.HasStructuredProperties}">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate x:DataType="vm:LogPropertyViewModel">
                            <Grid ColumnDefinitions="120,*" ColumnSpacing="8" Margin="0,2" MinWidth="0">
                              <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="Wrap" />
                              <SelectableTextBlock Grid.Column="1" Classes="logMono" Text="{Binding Value}" TextWrapping="Wrap" />
                            </Grid>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                      <TextBlock Foreground="{DynamicResource Brush.FG2}" Text="{DynamicResource Tool.Log.NoStructuredData}" TextWrapping="Wrap" IsVisible="{Binding SelectedEntry.HasNoStructuredProperties}" />
                    </Grid>
                  </ScrollViewer>
                </TabItem>
                <TabItem Header="{DynamicResource Tool.Log.Raw}" IsVisible="{Binding HasSelectedEntry}">
                  <Border Margin="0,8" Background="{DynamicResource Brush.Contents}" BorderBrush="{DynamicResource Brush.Border2}" BorderThickness="1">
                    <ContentControl x:Name="LogRawEditorHost" />
                  </Border>
                </TabItem>
              </TabControl>
            </Grid>
          </Border>
        </Grid>
      </Border>
    </Grid>

    <Border Grid.Row="2"
            Padding="8,6"
            Background="{DynamicResource Brush.ToolBar}"
            BorderBrush="{DynamicResource Brush.Border2}"
            BorderThickness="0,1,0,0"
            IsVisible="{Binding HasStatus}">
      <TextBlock Classes="logMuted"
                 Text="{Binding StatusText}"
                 TextWrapping="Wrap"
                 AutomationProperties.LiveSetting="Polite" />
    </Border>
  </Grid>
</UserControl>
