<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:i="https://github.com/projektanker/icons.avalonia"
             xmlns:vm="using:ChapterTool.Avalonia.UI.ViewModels.Tools"
             x:Class="ChapterTool.Avalonia.UI.Views.Tools.LogToolView"
             x:DataType="vm:LogToolViewModel"
             x:CompileBindings="True">
  <Grid RowDefinitions="*,Auto" Background="{DynamicResource Brush.Window}">
    <Grid Grid.Row="0" Margin="8">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="360" MinWidth="300" MaxWidth="560" />
        <ColumnDefinition Width="4" />
        <ColumnDefinition Width="*" MinWidth="250" />
      </Grid.ColumnDefinitions>

      <Border Grid.Column="0"
              Background="{DynamicResource Brush.Contents}"
              BorderBrush="{DynamicResource Brush.Border2}"
              BorderThickness="1">
        <Grid>
          <ListBox x:Name="LogList"
                   Padding="4"
                   Background="Transparent"
                   BorderThickness="0"
                   ItemsSource="{Binding FilteredEntries}"
                   SelectedItem="{Binding SelectedEntry, Mode=TwoWay}"
                   SelectionMode="Single"
                   Grid.IsSharedSizeScope="True"
                   ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                   ScrollViewer.VerticalScrollBarVisibility="Auto">
            <ListBox.Styles>
              <Style Selector="ListBoxItem">
                <Setter Property="MinHeight" Value="48" />
                <Setter Property="Margin" Value="0,1" />
                <Setter Property="Padding" Value="4,3" />
                <Setter Property="CornerRadius" Value="4" />
              </Style>
            </ListBox.Styles>
            <ListBox.ItemsPanel>
              <ItemsPanelTemplate>
                <VirtualizingStackPanel Orientation="Vertical" />
              </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="vm:LogEntryViewModel">
                <Grid ColumnDefinitions="4,Auto,*,Auto" Background="Transparent">
                  <Border Grid.Column="0"
                          Width="4"
                          Margin="0,1,6,1"
                          CornerRadius="2"
                          Background="{DynamicResource ChapterTool.LogInformationBrush}"
                          IsVisible="{Binding IsInformation}" />
                  <Border Grid.Column="0"
                          Width="4"
                          Margin="0,1,6,1"
                          CornerRadius="2"
                          Background="{DynamicResource ChapterTool.LogWarningBrush}"
                          IsVisible="{Binding IsWarning}" />
                  <Border Grid.Column="0"
                          Width="4"
                          Margin="0,1,6,1"
                          CornerRadius="2"
                          Background="{DynamicResource ChapterTool.LogErrorBrush}"
                          IsVisible="{Binding IsError}" />

                  <Grid Grid.Column="1" Width="20" Height="20" Margin="2,2,6,0" VerticalAlignment="Top">
                    <i:Icon Width="14" Height="14"
                            Value="fa-solid fa-circle-info"
                            Foreground="{DynamicResource ChapterTool.LogInformationBrush}"
                            IsVisible="{Binding IsInformation}" />
                    <i:Icon Width="14" Height="14"
                            Value="fa-solid fa-triangle-exclamation"
                            Foreground="{DynamicResource ChapterTool.LogWarningBrush}"
                            IsVisible="{Binding IsWarning}" />
                    <i:Icon Width="14" Height="14"
                            Value="fa-solid fa-circle-xmark"
                            Foreground="{DynamicResource ChapterTool.LogErrorBrush}"
                            IsVisible="{Binding IsError}" />
                  </Grid>

                  <StackPanel Grid.Column="2" Margin="0,0,6,0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding LevelText}"
                               Classes="small"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource Brush.FG2}" />
                    <TextBlock Text="{Binding Summary}"
                               MaxHeight="44"
                               TextWrapping="Wrap"
                               ToolTip.Tip="{Binding Summary}" />
                  </StackPanel>

                  <TextBlock Grid.Column="3"
                             Classes="small"
                             Margin="4,2,0,0"
                             VerticalAlignment="Top"
                             Foreground="{DynamicResource Brush.FG2}"
                             Text="{Binding Time}" />
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>

          <StackPanel HorizontalAlignment="Center"
                      VerticalAlignment="Center"
                      Spacing="10"
                      Margin="24"
                      IsVisible="{Binding IsEmpty}">
            <i:Icon Width="48" Height="48"
                    Value="fa-solid fa-inbox"
                    Foreground="{DynamicResource Brush.FG2}" />
            <TextBlock MaxWidth="220"
                       Foreground="{DynamicResource Brush.FG2}"
                       Text="{DynamicResource Tool.Log.Empty}"
                       TextWrapping="Wrap"
                       TextAlignment="Center"
                       HorizontalAlignment="Center" />
          </StackPanel>
        </Grid>
      </Border>

      <GridSplitter Grid.Column="1"
                    MinWidth="1"
                    Background="Transparent"
                    BorderThickness="0"
                    Focusable="False" />

      <Border Grid.Column="2"
              Background="{DynamicResource Brush.Contents}"
              BorderBrush="{DynamicResource Brush.Border2}"
              BorderThickness="1">
        <Grid RowDefinitions="Auto,*">
          <Border Grid.Row="0"
                  Padding="14,12"
                  Background="{DynamicResource Brush.ToolBar}"
                  BorderBrush="{DynamicResource Brush.Border2}"
                  BorderThickness="0,0,0,1"
                  IsVisible="{Binding HasSelectedEntry}">
            <Grid RowDefinitions="Auto,Auto" RowSpacing="8">
              <TextBlock Classes="bold"
                         FontSize="16"
                         Text="{Binding SelectedEntry.Summary}"
                         TextWrapping="Wrap" />
              <WrapPanel Grid.Row="1" Orientation="Horizontal" ItemSpacing="12" LineSpacing="3">
                <StackPanel Orientation="Horizontal" Spacing="5" IsVisible="{Binding SelectedEntry.IsInformation}">
                  <i:Icon Width="14" Height="14"
                          Value="fa-solid fa-circle-info"
                          Foreground="{DynamicResource ChapterTool.LogInformationBrush}" />
                  <TextBlock Classes="small"
                             FontWeight="SemiBold"
                             Foreground="{DynamicResource ChapterTool.LogInformationBrush}"
                             Text="{Binding SelectedEntry.LevelText}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="5" IsVisible="{Binding SelectedEntry.IsWarning}">
                  <i:Icon Width="14" Height="14"
                          Value="fa-solid fa-triangle-exclamation"
                          Foreground="{DynamicResource ChapterTool.LogWarningBrush}" />
                  <TextBlock Classes="small"
                             FontWeight="SemiBold"
                             Foreground="{DynamicResource ChapterTool.LogWarningBrush}"
                             Text="{Binding SelectedEntry.LevelText}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="5" IsVisible="{Binding SelectedEntry.IsError}">
                  <i:Icon Width="14" Height="14"
                          Value="fa-solid fa-circle-xmark"
                          Foreground="{DynamicResource ChapterTool.LogErrorBrush}" />
                  <TextBlock Classes="small"
                             FontWeight="SemiBold"
                             Foreground="{DynamicResource ChapterTool.LogErrorBrush}"
                             Text="{Binding SelectedEntry.LevelText}" />
                </StackPanel>
                <TextBlock Classes="small" Foreground="{DynamicResource Brush.FG2}" Text="{Binding SelectedEntry.Timestamp}" />
                <TextBlock Classes="small" Foreground="{DynamicResource Brush.FG2}" Text="{Binding SelectedEntry.Context}" TextWrapping="Wrap" />
              </WrapPanel>
            </Grid>
          </Border>

          <ScrollViewer Grid.Row="1"
                        Margin="12,10"
                        HorizontalScrollBarVisibility="Disabled"
                        VerticalScrollBarVisibility="Auto"
                        IsVisible="{Binding HasSelectedEntry}">
            <StackPanel Spacing="14" MinWidth="320">
              <StackPanel Spacing="5" IsVisible="{Binding SelectedEntry.HasTechnicalDetail}">
                <TextBlock Classes="bold" Text="{DynamicResource Tool.Log.TechnicalDetail}" />
                <Border Padding="10,8"
                        Background="{DynamicResource Brush.Window}"
                        BorderBrush="{DynamicResource Brush.Border2}"
                        BorderThickness="1">
                  <SelectableTextBlock FontFamily="{DynamicResource ChapterTool.MonospaceFontFamily}"
                                       FontSize="12"
                                       Text="{Binding SelectedEntry.TechnicalDetail}"
                                       TextWrapping="Wrap" />
                </Border>
              </StackPanel>

              <StackPanel Spacing="5" IsVisible="{Binding SelectedEntry.HasStructuredTree}">
                <TextBlock Classes="bold" Text="{DynamicResource Tool.Log.StructuredData}" />
                <TreeView ItemsSource="{Binding SelectedEntry.StructuredTree}"
                          BorderThickness="0"
                          MinHeight="80">
                  <TreeView.ItemTemplate>
                    <TreeDataTemplate x:DataType="vm:LogStructuredNodeViewModel"
                                      ItemsSource="{Binding Children}">
                      <Border Padding="8,6"
                              Background="{DynamicResource Brush.Window}"
                              BorderBrush="{DynamicResource Brush.Border2}"
                              BorderThickness="0,0,0,1">
                        <Grid ColumnSpacing="16">
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="0.35*" MinWidth="120" />
                            <ColumnDefinition Width="0.65*" MinWidth="180" />
                          </Grid.ColumnDefinitions>
                          <TextBlock Grid.Column="0"
                                     Classes="bold"
                                     Text="{Binding Name}"
                                     TextWrapping="Wrap" />
                          <SelectableTextBlock Grid.Column="1"
                                               FontFamily="{DynamicResource ChapterTool.MonospaceFontFamily}"
                                               Text="{Binding Value}"
                                               TextWrapping="Wrap" />
                        </Grid>
                      </Border>
                    </TreeDataTemplate>
                  </TreeView.ItemTemplate>
                </TreeView>
              </StackPanel>

              <StackPanel Spacing="5" IsVisible="{Binding SelectedEntry.HasException}">
                <TextBlock Classes="bold" Text="{DynamicResource Tool.Log.Exception}" />
                <Border Padding="10,8"
                        Background="{DynamicResource Brush.Window}"
                        BorderBrush="{DynamicResource ChapterTool.LogErrorBrush}"
                        BorderThickness="1">
                  <SelectableTextBlock FontFamily="{DynamicResource ChapterTool.MonospaceFontFamily}"
                                       FontSize="12"
                                       Text="{Binding SelectedEntry.ExceptionText}"
                                       TextWrapping="Wrap" />
                </Border>
              </StackPanel>
            </StackPanel>
          </ScrollViewer>

          <StackPanel Grid.Row="1"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center"
                      Spacing="10"
                      Margin="24"
                      IsVisible="{Binding !HasSelectedEntry}">
            <i:Icon Width="48" Height="48"
                    Value="fa-solid fa-list"
                    Foreground="{DynamicResource Brush.FG2}" />
            <TextBlock Foreground="{DynamicResource Brush.FG2}"
                       Text="{DynamicResource Tool.Log.Details}"
                       HorizontalAlignment="Center" />
          </StackPanel>
        </Grid>
      </Border>
    </Grid>

    <Border Grid.Row="1"
            Padding="8"
            Background="{DynamicResource Brush.ToolBar}"
            BorderBrush="{DynamicResource Brush.Border2}"
            BorderThickness="0,1,0,0">
      <Grid ColumnDefinitions="*,Auto,*" ColumnSpacing="8">
        <ComboBox Grid.Column="0"
                  Width="160"
                  HorizontalAlignment="Left"
                  ItemsSource="{Binding FilterOptions}"
                  SelectedItem="{Binding SelectedFilter, Mode=TwoWay}">
          <ComboBox.ItemTemplate>
            <DataTemplate x:DataType="vm:LogFilterOption">
              <TextBlock Text="{Binding DisplayName}" />
            </DataTemplate>
          </ComboBox.ItemTemplate>
        </ComboBox>

        <Button Grid.Column="1"
                Classes="flat primary"
                MinWidth="96"
                Content="{DynamicResource Common.Clear}"
                Command="{Binding ClearCommand}"
                AutomationProperties.Name="{DynamicResource Common.Clear}" />

        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4" HorizontalAlignment="Right">
          <Button Classes="icon_button"
                  Width="28" Height="28"
                  Command="{Binding CopySummaryCommand}"
                  AutomationProperties.Name="{DynamicResource Tool.Log.CopySummary}"
                  ToolTip.Tip="{DynamicResource Tool.Log.CopySummary}">
            <i:Icon Width="13" Height="13" Value="fa-solid fa-copy" />
          </Button>
          <Button Classes="icon_button"
                  Width="28" Height="28"
                  Command="{Binding CopyDetailsCommand}"
                  AutomationProperties.Name="{DynamicResource Tool.Log.CopyDetails}"
                  ToolTip.Tip="{DynamicResource Tool.Log.CopyDetails}">
            <i:Icon Width="13" Height="13" Value="fa-solid fa-list" />
          </Button>
        </StackPanel>
      </Grid>
    </Border>
  </Grid>
</UserControl>
