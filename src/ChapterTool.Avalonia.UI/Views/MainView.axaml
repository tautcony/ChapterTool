<UserControl xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:i="https://github.com/projektanker/icons.avalonia"
        xmlns:svg="clr-namespace:Avalonia.Svg;assembly=Svg.Controls.Avalonia"
        xmlns:media="using:Avalonia.Media"
        xmlns:controls="using:ChapterTool.Avalonia.UI.Views.Controls"
        xmlns:vm="using:ChapterTool.Avalonia.UI.ViewModels"
        x:Class="ChapterTool.Avalonia.UI.Views.MainView"
        x:Name="RootView"
        x:DataType="vm:MainWindowViewModel"
        Background="{DynamicResource Brush.Window}"
        SizeChanged="OnSizeChanged"
        KeyDown="OnKeyDown"
        DragDrop.AllowDrop="True"
        DragDrop.Drop="OnDrop"
        x:CompileBindings="True">
  <UserControl.Styles>
    <Style Selector="TextBlock.previewTarget">
      <Setter Property="Foreground" Value="{DynamicResource Brush.Accent}" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="TextBlock.framePreview">
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
  </UserControl.Styles>
  <DockPanel x:Name="RootPanel" LastChildFill="True">
    <Border x:Name="StatusBar"
            DockPanel.Dock="Bottom"
            Background="{DynamicResource Brush.StatusBar}"
            BorderBrush="{DynamicResource Brush.Border1}"
            BorderThickness="0,1,0,0">
      <Grid ColumnDefinitions="*,Auto,Auto" MinHeight="32">
        <StackPanel Grid.Column="0"
                    Orientation="Horizontal"
                    Margin="8,0"
                    Spacing="12"
                    VerticalAlignment="Center">
          <TextBlock x:Name="StatusBlock"
                     VerticalAlignment="Center"
                     FontSize="{DynamicResource ChapterTool.FontSize.Small}"
                     Foreground="{DynamicResource Brush.FG1}"
                     Text="{Binding StatusText}"
                     TextTrimming="CharacterEllipsis" />
          <TextBlock x:Name="OutputDirectoryBlock"
                     VerticalAlignment="Center"
                     FontSize="{DynamicResource ChapterTool.FontSize.Small}"
                     Opacity="0.75"
                     Foreground="{DynamicResource Brush.FG1}"
                     Text="{Binding EffectiveSaveDirectoryDisplay}"
                     ToolTip.Tip="{Binding EffectiveSaveDirectoryDisplay}"
                     TextTrimming="CharacterEllipsis"
                     MaxWidth="280"
                     AutomationProperties.AutomationId="OutputDirectoryDisplay" />
        </StackPanel>
        <ProgressBar x:Name="ProgressBar"
                     Grid.Column="2"
                     Width="144"
                     Height="8"
                     Margin="8,0,12,0"
                     VerticalAlignment="Center"
                     Minimum="0"
                     Maximum="1"
                     Value="{Binding Progress}"
                     IsVisible="{Binding IsOperationRunning}"
                     AutomationProperties.AutomationId="ProgressBar" />
        <Button x:Name="LogButton"
                Grid.Column="1"
                Classes="flat"
                MinWidth="48"
                MinHeight="28"
                FontSize="{DynamicResource ChapterTool.FontSize.Small}"
                VerticalAlignment="Center"
                AutomationProperties.AutomationId="LogWindow"
                Content="{DynamicResource Action.Log}"
                Command="{Binding LogCommand}" />
      </Grid>
    </Border>

    <Grid Margin="16"
          RowDefinitions="Auto,*,Auto"
          RowSpacing="12">
      <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="12">
          <SplitButton x:Name="LoadButton"
                       Classes="flat"
                       AutomationProperties.AutomationId="LoadButton"
                       Content="{DynamicResource Action.Load}"
                       Command="{Binding #RootView.BrowseAndLoadCommand}"
                       ToolTip.Tip="{DynamicResource Main.LoadTooltip}">
            <SplitButton.Flyout>
              <MenuFlyout>
                <MenuItem x:Name="ReloadMenuItem"
                          Header="{DynamicResource Main.Reload}"
                          InputGesture="{Binding #RootView.((vm:MainWindowViewModel)DataContext).ReloadShortcutKeyGesture}"
                          Command="{Binding #RootView.((vm:MainWindowViewModel)DataContext).ReloadCommand}" />
                <MenuItem x:Name="AppendLoadMenuItem"
                          Header="{DynamicResource Main.AppendMpls}"
                          IsEnabled="{Binding #RootView.((vm:MainWindowViewModel)DataContext).CanAppendMpls}"
                          Command="{Binding #RootView.AppendMplsCommand}" />
              </MenuFlyout>
            </SplitButton.Flyout>
          </SplitButton>
          <Button x:Name="SaveButton"
                  Classes="flat"
                  MinWidth="96"
                  MinHeight="40"
                  AutomationProperties.AutomationId="SaveButton"
                  Content="{DynamicResource Common.Save}"
                  IsEnabled="{Binding CanSave}"
                  Command="{Binding SaveCommand}"
                  ToolTip.Tip="{Binding SaveButtonTooltip}" />
        </StackPanel>

        <ComboBox x:Name="ClipBox"
                  Grid.Column="1"
                  MinWidth="176"
                  MaxWidth="288"
                  HorizontalAlignment="Left"
                  VerticalAlignment="Bottom"
                  ItemsSource="{Binding ClipDisplayOptions}"
                  SelectedItem="{Binding SelectedClipDisplayOption, Mode=TwoWay}"
                  IsVisible="{Binding IsClipSelectionVisible}"
                  ToolTip.Tip="{Binding SelectedClipDisplayOption.DisplayText}"
                  AutomationProperties.AutomationId="ClipSelector">
          <ComboBox.ItemTemplate>
            <DataTemplate x:DataType="vm:SelectorDisplayOption">
              <TextBlock VerticalAlignment="Center" Text="{Binding DisplayText}" TextTrimming="CharacterEllipsis" />
            </DataTemplate>
          </ComboBox.ItemTemplate>
          <ComboBox.SelectionBoxItemTemplate>
            <DataTemplate x:DataType="vm:SelectorDisplayOption">
              <TextBlock VerticalAlignment="Center" Text="{Binding DisplayText}" TextTrimming="CharacterEllipsis" />
            </DataTemplate>
          </ComboBox.SelectionBoxItemTemplate>
          <ComboBox.ContextMenu>
            <ContextMenu x:DataType="vm:MainWindowViewModel"
                         DataContext="{Binding #RootView.DataContext}">
              <MenuItem x:Name="ClipCombineMenuItem"
                        Header="{Binding ClipStructureActionText}"
                        ToggleType="CheckBox"
                        IsChecked="{Binding IsClipCombineChecked, Mode=OneWay}"
                        IsEnabled="{Binding CanCombine}"
                        Command="{Binding CombineCommand}" />
            </ContextMenu>
          </ComboBox.ContextMenu>
        </ComboBox>

        <Grid Grid.Column="2"
              RowDefinitions="Auto,Auto"
              RowSpacing="6"
              HorizontalAlignment="Right"
              MinWidth="208">
          <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
            <CheckBox x:Name="RoundFramesBox"
                      Content="{DynamicResource Label.RoundFrames}"
                      IsChecked="{Binding RoundFrames}" />
            <Button x:Name="HistoryButton"
                    Classes="icon_button"
                    Width="32"
                    Height="32"
                    IsEnabled="{Binding CanOpenHistory}"
                    Command="{Binding HistoryCommand}"
                    AutomationProperties.AutomationId="HistoryButton"
                    AutomationProperties.Name="{DynamicResource History.Title}"
                    ToolTip.Tip="{DynamicResource History.Title}">
              <i:Icon Value="fa-solid fa-clock-rotate-left" FontSize="14" />
            </Button>
            <Button x:Name="PreviewButton"
                    Classes="icon_button"
                    Width="32"
                    Height="32"
                    AutomationProperties.AutomationId="PreviewWindow"
                    AutomationProperties.Name="{DynamicResource Action.Preview}"
                    Command="{Binding PreviewCommand}"
                    ToolTip.Tip="{DynamicResource Action.Preview}">
              <i:Icon Value="fa-solid fa-eye" FontSize="14" />
            </Button>
            <Button x:Name="RefreshButton"
                    Classes="icon_button"
                    Width="32"
                    Height="32"
                    AutomationProperties.AutomationId="RefreshRows"
                    AutomationProperties.Name="{DynamicResource Common.Refresh}"
                    IsEnabled="{Binding CanRefreshRows}"
                    Command="{Binding RefreshCommand}"
                    ToolTip.Tip="{DynamicResource Common.Refresh}">
              <i:Icon Value="fa-solid fa-rotate" FontSize="14" />
            </Button>
            <Button x:Name="SettingsButton"
                    Classes="icon_button"
                    Width="32"
                    Height="32"
                    AutomationProperties.AutomationId="SettingsWindow"
                    AutomationProperties.Name="{DynamicResource Action.Settings}"
                    Command="{Binding SettingsCommand}"
                    ToolTip.Tip="{DynamicResource Action.Settings}">
              <i:Icon Value="fa-solid fa-gear" FontSize="14" />
            </Button>
          </StackPanel>
          <Grid Grid.Row="1"
                ColumnDefinitions="*,Auto"
                ColumnSpacing="6"
                HorizontalAlignment="Right">
            <ComboBox x:Name="FrameRateBox"
                      Grid.Column="0"
                      Width="152"
                      HorizontalAlignment="Right"
                      ItemsSource="{Binding FrameRateDisplayOptions}"
                      SelectedIndex="{Binding SelectedFrameRateIndex, Mode=TwoWay}"
                      AutomationProperties.Name="{DynamicResource Label.FrameRate}">
              <ComboBox.ItemTemplate>
                <DataTemplate x:DataType="vm:SelectorDisplayOption">
                  <TextBlock VerticalAlignment="Center" Text="{Binding DisplayText}" TextTrimming="CharacterEllipsis" />
                </DataTemplate>
              </ComboBox.ItemTemplate>
              <ComboBox.SelectionBoxItemTemplate>
                <DataTemplate x:DataType="vm:SelectorDisplayOption">
                  <TextBlock VerticalAlignment="Center" Text="{Binding DisplayText}" TextTrimming="CharacterEllipsis" />
                </DataTemplate>
              </ComboBox.SelectionBoxItemTemplate>
            </ComboBox>
            <Button x:Name="ChangeFpsButton"
                    Grid.Column="1"
                    Classes="icon_button"
                    Width="32"
                    Height="32"
                    Command="{Binding ChangeFpsCommand}"
                    AutomationProperties.Name="{DynamicResource Main.ChangeFps}"
                    ToolTip.Tip="{DynamicResource Main.ChangeFps}">
              <i:Icon Value="fa-solid fa-gauge-high" FontSize="14" />
            </Button>
          </Grid>
        </Grid>
      </Grid>

      <Grid x:Name="ChapterWorkspaceGrid" Grid.Row="1" MinHeight="128" ColumnDefinitions="*" RowDefinitions="*">
        <DataGrid x:Name="ChapterGrid"
                  Grid.Column="0"
                  AutoGenerateColumns="False"
                  CanUserReorderColumns="False"
                  CanUserResizeColumns="True"
                  IsReadOnly="{Binding IsChapterGridReadOnly}"
                  SelectionMode="Extended"
                  GridLinesVisibility="All"
                  ItemsSource="{Binding Rows}"
                  CellEditEnded="OnChapterGridCellEditEnded"
                  AutomationProperties.AutomationId="ChapterGrid">
          <DataGrid.ContextMenu>
            <ContextMenu x:DataType="vm:MainWindowViewModel"
                         DataContext="{Binding #RootView.DataContext}">
              <MenuItem x:Name="InsertMenuItem" Header="{DynamicResource Main.Insert}" Tag="⎀" IsEnabled="{Binding CanEditRows}" Command="{Binding #RootView.InsertSelectedCommand}">
                <MenuItem.Icon><i:Icon Width="16" Height="16" Value="fa-solid fa-plus" /></MenuItem.Icon>
              </MenuItem>
              <MenuItem x:Name="DeleteMenuItem" Header="{DynamicResource Menu.Delete}" Tag="⌦" IsEnabled="{Binding CanEditRows}" Command="{Binding #RootView.DeleteSelectedCommand}">
                <MenuItem.Icon><i:Icon Width="16" Height="16" Value="fa-solid fa-trash-can" /></MenuItem.Icon>
              </MenuItem>
              <MenuItem x:Name="GridCombineMenuItem"
                        Header="{Binding ClipStructureActionText}"
                        ToggleType="CheckBox"
                        IsChecked="{Binding IsClipCombineChecked, Mode=OneWay}"
                        IsEnabled="{Binding CanCombine}"
                        Command="{Binding CombineCommand}">
                <MenuItem.Icon><i:Icon Width="16" Height="16" Value="fa-solid fa-code-merge" /></MenuItem.Icon>
              </MenuItem>
              <MenuItem x:Name="OpenMediaMenuItem" Header="{DynamicResource Main.OpenRelatedMedia}" IsEnabled="{Binding CanOpenRelatedMedia}" Command="{Binding OpenRelatedMediaCommand}">
                <MenuItem.Icon><i:Icon Width="16" Height="16" Value="fa-solid fa-link" /></MenuItem.Icon>
              </MenuItem>
              <MenuItem x:Name="ZonesMenuItem" Header="{DynamicResource Main.CreateZones}" Command="{Binding #RootView.OpenZonesCommand}">
                <MenuItem.Icon><i:Icon Width="16" Height="16" Value="fa-solid fa-wand-magic-sparkles" /></MenuItem.Icon>
              </MenuItem>
              <MenuItem x:Name="ForwardShiftMenuItem" Header="{DynamicResource Main.ForwardTranslation}" Command="{Binding #RootView.OpenForwardShiftCommand}">
                <MenuItem.Icon><i:Icon Width="16" Height="16" Value="fa-solid fa-arrow-up" /></MenuItem.Icon>
              </MenuItem>
              <MenuItem x:Name="PreviewMenuItem" Header="{DynamicResource Menu.Preview}" InputGesture="{Binding #RootView.((vm:MainWindowViewModel)DataContext).PreviewShortcutKeyGesture}" Command="{Binding PreviewCommand}">
                <MenuItem.Icon><i:Icon Width="16" Height="16" Value="fa-solid fa-circle-play" /></MenuItem.Icon>
              </MenuItem>
            </ContextMenu>
          </DataGrid.ContextMenu>
          <DataGrid.Columns>
            <DataGridTemplateColumn Header="#" IsReadOnly="True" Width="88" MinWidth="72">
              <DataGridTemplateColumn.HeaderTemplate>
                <DataTemplate>
                  <TextBlock Text="#"
                             ToolTip.Tip="{DynamicResource Grid.Number}"
                             AutomationProperties.Name="{DynamicResource Grid.Number}" />
                </DataTemplate>
              </DataGridTemplateColumn.HeaderTemplate>
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate x:DataType="vm:ChapterRowViewModel">
                  <Grid>
                    <TextBlock HorizontalAlignment="Stretch" VerticalAlignment="Center" TextAlignment="Center"
                               IsVisible="{Binding ShowNormalNumber}" Text="{Binding Number}" />
                    <StackPanel ToolTip.Tip="{DynamicResource Expression.Preview.ComparisonTooltip}"
                                AutomationProperties.Name="{Binding PreviewNumberAccessibleName}"
                                Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="4"
                                IsVisible="{Binding ShowWideNumberPreview}">
                      <TextBlock Text="{Binding Number}" Opacity="0.65" />
                      <i:Icon Value="fa-solid fa-arrow-right" Width="10" Height="10" Foreground="{DynamicResource Brush.Accent}" />
                      <TextBlock Classes="previewTarget" Text="{Binding PreviewNumber}" />
                    </StackPanel>
                    <Grid ToolTip.Tip="{DynamicResource Expression.Preview.ComparisonTooltip}"
                          AutomationProperties.Name="{Binding PreviewNumberAccessibleName}"
                          ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto" ColumnSpacing="4" RowSpacing="1"
                          IsVisible="{Binding ShowNarrowNumberPreview}">
                      <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding Number}" Opacity="0.65" />
                      <i:Icon Grid.Row="1" Grid.Column="0" Value="fa-solid fa-arrow-right" Width="10" Height="10" Foreground="{DynamicResource Brush.Accent}" VerticalAlignment="Center" />
                      <TextBlock Grid.Row="1" Grid.Column="1" Classes="previewTarget" Text="{Binding PreviewNumber}" />
                    </Grid>
                  </Grid>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <DataGridTemplateColumn Header="{DynamicResource Grid.Time}"
                                    Tag="{x:Static vm:ChapterGridColumnIds.Time}"
                                    Width="300"
                                    MinWidth="220">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate x:DataType="vm:ChapterRowViewModel">
                  <Grid>
                    <TextBlock HorizontalAlignment="Stretch" VerticalAlignment="Center" TextAlignment="Center"
                               TextWrapping="NoWrap" IsVisible="{Binding ShowNormalTime}" Text="{Binding TimeText}" />
                    <StackPanel ToolTip.Tip="{DynamicResource Expression.Preview.ComparisonTooltip}"
                                AutomationProperties.Name="{Binding PreviewTimeAccessibleName}"
                                Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="4"
                                IsVisible="{Binding ShowWideTimePreview}">
                      <TextBlock Text="{Binding PreviewBeforeTimeText}" TextWrapping="NoWrap" Opacity="0.65" />
                      <i:Icon Value="fa-solid fa-arrow-right" Width="10" Height="10" Foreground="{DynamicResource Brush.Accent}" />
                      <TextBlock Classes="previewTarget" Text="{Binding PreviewTimeText}" TextWrapping="NoWrap" />
                      <TextBlock Text="{Binding PreviewTimeDelta}" TextWrapping="NoWrap" Opacity="0.8" />
                    </StackPanel>
                    <Grid ToolTip.Tip="{DynamicResource Expression.Preview.ComparisonTooltip}"
                          AutomationProperties.Name="{Binding PreviewTimeAccessibleName}"
                          ColumnDefinitions="Auto,*,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="4" RowSpacing="1"
                          IsVisible="{Binding ShowNarrowTimePreview}">
                      <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding PreviewBeforeTimeText}" TextWrapping="NoWrap" Opacity="0.65" />
                      <i:Icon Grid.Row="1" Grid.Column="0" Value="fa-solid fa-arrow-right" Width="10" Height="10" Foreground="{DynamicResource Brush.Accent}" VerticalAlignment="Center" />
                      <TextBlock Grid.Row="1" Grid.Column="1" Classes="previewTarget" Text="{Binding PreviewTimeText}" TextWrapping="NoWrap" />
                      <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding PreviewTimeDelta}" TextWrapping="NoWrap" Opacity="0.8" />
                    </Grid>
                  </Grid>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
              <DataGridTemplateColumn.CellEditingTemplate>
                <DataTemplate x:DataType="vm:ChapterRowViewModel">
                  <TextBox Classes="gridEditor"
                           Text="{Binding TimeText, Mode=TwoWay}" />
                </DataTemplate>
              </DataGridTemplateColumn.CellEditingTemplate>
            </DataGridTemplateColumn>
            <DataGridTemplateColumn Header="{DynamicResource Grid.Name}"
                                    Tag="{x:Static vm:ChapterGridColumnIds.Name}"
                                    Width="*"
                                    MinWidth="144">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate x:DataType="vm:ChapterRowViewModel">
                  <Grid>
                    <TextBlock HorizontalAlignment="Stretch" VerticalAlignment="Center" TextAlignment="Center"
                               IsVisible="{Binding ShowNormalName}" Text="{Binding Name}" />
                    <StackPanel ToolTip.Tip="{DynamicResource Expression.Preview.ComparisonTooltip}"
                                AutomationProperties.Name="{Binding PreviewNameAccessibleName}"
                                Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="4"
                                IsVisible="{Binding ShowWideNamePreview}">
                      <TextBlock Text="{Binding Name}" Opacity="0.65" TextTrimming="CharacterEllipsis" />
                      <i:Icon Value="fa-solid fa-arrow-right" Width="10" Height="10" Foreground="{DynamicResource Brush.Accent}" />
                      <TextBlock Classes="previewTarget" Text="{Binding PreviewName}" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <Grid ToolTip.Tip="{DynamicResource Expression.Preview.ComparisonTooltip}"
                          AutomationProperties.Name="{Binding PreviewNameAccessibleName}"
                          ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto" ColumnSpacing="4" RowSpacing="1"
                          IsVisible="{Binding ShowNarrowNamePreview}">
                      <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding Name}" Opacity="0.65" TextTrimming="CharacterEllipsis" />
                      <i:Icon Grid.Row="1" Grid.Column="0" Value="fa-solid fa-arrow-right" Width="10" Height="10" Foreground="{DynamicResource Brush.Accent}" VerticalAlignment="Center" />
                      <TextBlock Grid.Row="1" Grid.Column="1" Classes="previewTarget" Text="{Binding PreviewName}" TextTrimming="CharacterEllipsis" />
                    </Grid>
                  </Grid>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
              <DataGridTemplateColumn.CellEditingTemplate>
                <DataTemplate x:DataType="vm:ChapterRowViewModel">
                  <TextBox Classes="gridEditor"
                           Text="{Binding Name, Mode=TwoWay}" />
                </DataTemplate>
              </DataGridTemplateColumn.CellEditingTemplate>
            </DataGridTemplateColumn>
            <DataGridTemplateColumn Header="{DynamicResource Grid.Frames}"
                                    Tag="{x:Static vm:ChapterGridColumnIds.Frames}"
                                     Width="260"
                                     MinWidth="220">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate x:DataType="vm:ChapterRowViewModel">
                  <Grid>
                    <TextBlock Classes="frameText"
                               Classes.frameAccurate="{Binding IsFrameAccurate}"
                               Classes.frameInexact="{Binding IsFrameInexact}"
                               Classes.frameNeutral="{Binding IsFrameNeutral}"
                               HorizontalAlignment="Stretch" TextAlignment="Center" VerticalAlignment="Center"
                               AutomationProperties.Name="{Binding FramePresentation.AccessibleDescription}"
                               IsVisible="{Binding ShowNormalFrames}"><Run Text="{Binding FramePresentation.SignedIntegerDigits}" /><Run Text="{Binding FramePresentation.DecimalPoint}" /><Run Text="{Binding FramePresentation.NonRepeatingDigits}" /><Run Text="{Binding FramePresentation.RepeatingDigits}" TextDecorations="{x:Static media:TextDecorations.Overline}" /></TextBlock>
                    <Grid ToolTip.Tip="{DynamicResource Expression.Preview.ComparisonTooltip}"
                          AutomationProperties.Name="{Binding PreviewFramesAccessibleName}"
                          ColumnDefinitions="*,26,*"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Center"
                          IsVisible="{Binding ShowWideFramesPreview}">
                      <TextBlock Grid.Column="0" Classes="frameText framePreview"
                                 Classes.frameAccurate="{Binding IsPreviewBeforeFrameAccurate}"
                                 Classes.frameInexact="{Binding IsPreviewBeforeFrameInexact}"
                                 Classes.frameNeutral="{Binding IsPreviewBeforeFrameNeutral}"
                                 HorizontalAlignment="Stretch" TextAlignment="Center" VerticalAlignment="Center"><Run Text="{Binding PreviewBeforeFramePresentation.SignedIntegerDigits}" /><Run Text="{Binding PreviewBeforeFramePresentation.DecimalPoint}" /><Run Text="{Binding PreviewBeforeFramePresentation.NonRepeatingDigits}" /><Run Text="{Binding PreviewBeforeFramePresentation.RepeatingDigits}" TextDecorations="{x:Static media:TextDecorations.Overline}" /></TextBlock>
                      <i:Icon Grid.Column="1" Value="fa-solid fa-arrow-right" Width="14" Height="14" Margin="2,0" Foreground="{DynamicResource Brush.Accent}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                      <TextBlock Grid.Column="2" Classes="frameText framePreview"
                                 Classes.frameAccurate="{Binding IsPreviewCandidateFrameAccurate}"
                                 Classes.frameInexact="{Binding IsPreviewCandidateFrameInexact}"
                                 Classes.frameNeutral="{Binding IsPreviewCandidateFrameNeutral}"
                                 HorizontalAlignment="Stretch" TextAlignment="Center" VerticalAlignment="Center"><Run Text="{Binding PreviewCandidateFramePresentation.SignedIntegerDigits}" /><Run Text="{Binding PreviewCandidateFramePresentation.DecimalPoint}" /><Run Text="{Binding PreviewCandidateFramePresentation.NonRepeatingDigits}" /><Run Text="{Binding PreviewCandidateFramePresentation.RepeatingDigits}" TextDecorations="{x:Static media:TextDecorations.Overline}" /></TextBlock>
                    </Grid>
                    <Grid ToolTip.Tip="{DynamicResource Expression.Preview.ComparisonTooltip}"
                          AutomationProperties.Name="{Binding PreviewFramesAccessibleName}"
                          ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="4" RowSpacing="1"
                          IsVisible="{Binding ShowNarrowFramesPreview}">
                      <TextBlock Grid.Row="0" Grid.Column="1" Classes="frameText framePreview"
                                 Classes.frameAccurate="{Binding IsPreviewBeforeFrameAccurate}"
                                 Classes.frameInexact="{Binding IsPreviewBeforeFrameInexact}"
                                 Classes.frameNeutral="{Binding IsPreviewBeforeFrameNeutral}"
                                 HorizontalAlignment="Stretch" TextAlignment="Center" TextWrapping="NoWrap"><Run Text="{Binding PreviewBeforeFramePresentation.SignedIntegerDigits}" /><Run Text="{Binding PreviewBeforeFramePresentation.DecimalPoint}" /><Run Text="{Binding PreviewBeforeFramePresentation.NonRepeatingDigits}" /><Run Text="{Binding PreviewBeforeFramePresentation.RepeatingDigits}" TextDecorations="{x:Static media:TextDecorations.Overline}" /></TextBlock>
                      <i:Icon Grid.Row="1" Grid.Column="0" Value="fa-solid fa-arrow-right" Width="14" Height="14" Margin="2,0" Foreground="{DynamicResource Brush.Accent}" VerticalAlignment="Center" />
                      <TextBlock Grid.Row="2" Grid.Column="1" Classes="frameText framePreview"
                                 Classes.frameAccurate="{Binding IsPreviewCandidateFrameAccurate}"
                                 Classes.frameInexact="{Binding IsPreviewCandidateFrameInexact}"
                                 Classes.frameNeutral="{Binding IsPreviewCandidateFrameNeutral}"
                                 HorizontalAlignment="Stretch" TextAlignment="Center" TextWrapping="NoWrap"><Run Text="{Binding PreviewCandidateFramePresentation.SignedIntegerDigits}" /><Run Text="{Binding PreviewCandidateFramePresentation.DecimalPoint}" /><Run Text="{Binding PreviewCandidateFramePresentation.NonRepeatingDigits}" /><Run Text="{Binding PreviewCandidateFramePresentation.RepeatingDigits}" TextDecorations="{x:Static media:TextDecorations.Overline}" /></TextBlock>
                    </Grid>
                  </Grid>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
              <DataGridTemplateColumn.CellEditingTemplate>
                <DataTemplate x:DataType="vm:ChapterRowViewModel">
                  <TextBox Classes="gridEditor"
                           Text="{Binding FramesInfo, Mode=TwoWay}" />
                </DataTemplate>
              </DataGridTemplateColumn.CellEditingTemplate>
            </DataGridTemplateColumn>
          </DataGrid.Columns>
        </DataGrid>
        <StackPanel Grid.Row="0" Grid.Column="0" HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="{Binding IsChapterGridEmpty}" IsHitTestVisible="False" Spacing="8">
        <svg:Svg x:Name="ChapterGridEmptyImage"
                 IsVisible="{Binding IsChapterGridEmpty}"
                 Width="160"
                 Height="96"
                 HorizontalAlignment="Center"
                 VerticalAlignment="Center"
                 IsHitTestVisible="False"
                 Path="/Assets/Images/chapter-empty.svg"
                 AutomationProperties.AutomationId="ChapterGridEmptyImage" />
        <TextBlock Text="{DynamicResource Main.EmptyGuidance}" HorizontalAlignment="Center" />
        </StackPanel>
      </Grid>

      <Grid Grid.Row="2" RowDefinitions="Auto">
      <Grid x:Name="AdvancedOptionsGrid"
            Grid.Row="0"
            ColumnDefinitions="*,3*,*"
            RowDefinitions="Auto,Auto,Auto"
            Grid.IsSharedSizeScope="True"
            ColumnSpacing="16"
            RowSpacing="8"
            Margin="0"
            AutomationProperties.AutomationId="AdvancedOptions">
        <Grid x:Name="FormatOptionsGroup"
              Classes="optionCell"
              Grid.Row="0"
              Grid.Column="0"
              ColumnSpacing="6">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" SharedSizeGroup="BottomOptionLabel" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <TextBlock Grid.Column="0" Classes="optionLabel" HorizontalAlignment="Left" Text="{DynamicResource Main.SaveFormat}" />
          <ComboBox x:Name="FormatBox"
                    Grid.Column="1"
                    HorizontalAlignment="Stretch"
                    ItemsSource="{Binding SaveFormatOptions}"
                    SelectedIndex="{Binding SaveFormatIndex}"
                    AutomationProperties.AutomationId="ExportFormat" />
        </Grid>

        <Grid x:Name="ChapterNameOptionsGroup"
              Classes="optionCell"
              Grid.Row="0"
              Grid.Column="1"
              ColumnSpacing="6">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" SharedSizeGroup="BottomOptionLabel" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <TextBlock Grid.Column="0" Classes="optionLabel" HorizontalAlignment="Left" Text="{DynamicResource Label.ChapterName}" />
          <ComboBox x:Name="ChapterNameModeBox"
                    Grid.Column="1"
                    MinWidth="96"
                    HorizontalAlignment="Stretch"
                    ItemsSource="{Binding ChapterNameModeOptions}"
                    SelectedIndex="{Binding ChapterNameModeIndex}"
                    AutomationProperties.AutomationId="ChapterNameMode">
            <ComboBox.ItemTemplate>
              <DataTemplate x:DataType="vm:SelectorDisplayOption">
                <TextBlock VerticalAlignment="Center" Text="{Binding DisplayText}" TextTrimming="CharacterEllipsis" />
              </DataTemplate>
            </ComboBox.ItemTemplate>
            <ComboBox.SelectionBoxItemTemplate>
              <DataTemplate x:DataType="vm:SelectorDisplayOption">
                <TextBlock VerticalAlignment="Center" Text="{Binding DisplayText}" TextTrimming="CharacterEllipsis" />
              </DataTemplate>
            </ComboBox.SelectionBoxItemTemplate>
          </ComboBox>
          <Button x:Name="ChapterNameTemplateButton"
                  Grid.Column="2"
                  Classes="icon_button"
                  Width="32"
                  Height="32"
                  AutomationProperties.AutomationId="ChapterNameTemplateFile"
                  AutomationProperties.Name="{DynamicResource Main.TemplateFile}"
                  Command="{Binding #RootView.LoadChapterNameTemplateCommand}"
                  ToolTip.Tip="{DynamicResource Main.TemplateFile}">
            <i:Icon Value="fa-solid fa-folder-open" FontSize="12" />
          </Button>
        </Grid>

        <Grid x:Name="OrderShiftOptionsGroup"
              Classes="optionCell"
              Grid.Row="1"
              Grid.Column="1"
              ColumnSpacing="6">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" SharedSizeGroup="BottomOptionLabel" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <TextBlock x:Name="OrderShiftLabel"
                     Grid.Column="0"
                     Classes="optionLabel"
                     HorizontalAlignment="Left"
                     Text="{DynamicResource Main.OrderShift}" />
          <NumericUpDown x:Name="OrderShiftBox"
                         Grid.Column="1"
                         HorizontalAlignment="Stretch"
                         FontFamily="{DynamicResource ChapterTool.MonospaceFontFamily}"
                         Minimum="0"
                         Maximum="1000"
                         Increment="1"
                         ParsingNumberStyle="Integer"
                         Value="{Binding OrderShift}"
                         ValueChanged="OnOrderShiftValueChanged"
                         AutomationProperties.AutomationId="OrderShift" />
        </Grid>

        <Grid x:Name="XmlLanguageOptionsGroup"
              Classes="optionCell"
              Grid.Row="1"
              Grid.Column="0"
              ColumnSpacing="6"
              IsEnabled="{Binding IsXmlLanguageEnabled}"
              HorizontalAlignment="Stretch">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" SharedSizeGroup="BottomOptionLabel" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <TextBlock Grid.Column="0" Classes="optionLabel" HorizontalAlignment="Left" Text="{DynamicResource Main.XmlLanguage}" />
          <ComboBox x:Name="XmlLanguageBox"
                    Grid.Column="1"
                    HorizontalAlignment="Stretch"
                    ItemsSource="{Binding XmlLanguageDisplayOptions}"
                    SelectedItem="{Binding SelectedXmlLanguageDisplayOption, Mode=TwoWay}"
                    AutomationProperties.AutomationId="XmlLanguage">
            <ComboBox.ItemTemplate>
              <DataTemplate x:DataType="vm:SelectorDisplayOption">
                <TextBlock VerticalAlignment="Center" Text="{Binding DisplayText}" TextTrimming="CharacterEllipsis" />
              </DataTemplate>
            </ComboBox.ItemTemplate>
            <ComboBox.SelectionBoxItemTemplate>
              <DataTemplate x:DataType="vm:SelectorDisplayOption">
                <TextBlock VerticalAlignment="Center" Text="{Binding DisplayText}" TextTrimming="CharacterEllipsis" />
              </DataTemplate>
            </ComboBox.SelectionBoxItemTemplate>
          </ComboBox>
        </Grid>

        <Grid x:Name="ExpressionOptionsGroup"
              Classes="optionCell"
              Grid.Row="2"
              Grid.Column="0"
              ColumnSpacing="6">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" SharedSizeGroup="BottomOptionLabel" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <TextBlock Grid.Column="0" Classes="optionLabel" HorizontalAlignment="Left" Text="{DynamicResource Tool.Expression.Title}" />
          <controls:ExpressionEditor x:Name="ExpressionBox"
                                     Grid.Column="1"
                                     MinWidth="128"
                                     HorizontalAlignment="Stretch"
                                     IsMultilineExpandable="True"
                                     MultilineExpansionChanged="OnExpressionEditorMultilineExpansionChanged"
                                     Text="{Binding Expression, Mode=TwoWay}"
                                     Localizer="{Binding Localizer}"
                                     AuthoringService="{Binding ExpressionAuthoringService}"
                                     ToolTip.Tip="{Binding ExpressionPreviewText}"
                                     AutomationProperties.AutomationId="ExpressionText" />
          <Button x:Name="LoadExpressionButton"
                  Grid.Column="2"
                  Classes="icon_button"
                  Width="32"
                  Height="32"
                  AutomationProperties.Name="{DynamicResource Tool.Expression.LoadLuaScript}"
                  ToolTip.Tip="{DynamicResource Tool.Expression.LoadLuaScript}"
                  Command="{Binding #RootView.LoadLuaExpressionScriptCommand}">
            <i:Icon Value="fa-solid fa-file-code" FontSize="14" />
          </Button>
          <Button x:Name="PreviewContentOptionsButton"
                  Grid.Column="3"
                  Classes="flat"
                  MinWidth="76"
                  Content="{DynamicResource Expression.Preview.Options}"
                  IsVisible="{Binding CanPreviewContentOptions}"
                  Command="{Binding PreviewContentOptionsCommand}"
                  AutomationProperties.AutomationId="PreviewContentOptions" />
          <Button x:Name="ApplyContentPreviewButton" Grid.Column="4" Classes="flat primary" MinWidth="64"
                  Content="{DynamicResource Common.Apply}" IsVisible="{Binding IsContentPreviewPending}"
                  IsEnabled="{Binding CanApplyContentPreview}" Command="{Binding #RootView.ApplyContentPreviewCommand}"
                  ToolTip.Tip="{Binding ContentPreviewMetadataTooltip}"
                  AutomationProperties.AutomationId="ApplyContentPreview" />
          <Button x:Name="CancelContentPreviewButton" Grid.Column="5" Classes="flat" MinWidth="64"
                  Content="{DynamicResource Expression.Preview.Discard}" IsVisible="{Binding IsContentPreviewPending}"
                  Command="{Binding CancelContentPreviewCommand}" AutomationProperties.AutomationId="CancelContentPreview" />
          <Button x:Name="RefreshContentPreviewButton" Grid.Column="6" Classes="flat" MinWidth="64"
                  Content="{DynamicResource Expression.Preview.Update}" IsVisible="{Binding CanRefreshContentPreview}"
                  Command="{Binding RefreshContentPreviewCommand}" AutomationProperties.AutomationId="RefreshContentPreview" />
        </Grid>
      </Grid>
      </Grid>
      <ContentControl x:Name="SecondarySurface"
                      Grid.Row="0"
                      Grid.RowSpan="3"
                      HorizontalContentAlignment="Stretch"
                      VerticalContentAlignment="Stretch"
                      IsVisible="False" />
    </Grid>
  </DockPanel>
</UserControl>
