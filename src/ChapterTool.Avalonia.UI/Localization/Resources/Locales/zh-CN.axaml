  <x:String x:Key="Settings.About.RepositoryUrl" xml:space="preserve">https://github.com/tautcony/ChapterTool</x:String>
  <x:String x:Key="Settings.AboutBody" xml:space="preserve">ChapterTool Core 浏览器工作台：在 WebAssembly 中导入、编辑、投影并导出章节数据。</x:String>
