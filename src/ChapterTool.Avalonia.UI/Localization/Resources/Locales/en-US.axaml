  <x:String x:Key="Settings.About" xml:space="preserve">About</x:String>
  <x:String x:Key="Settings.About.Description" xml:space="preserve">ChapterTool is an Avalonia-based cross-platform chapter editor for importing, adjusting, combining, and exporting chapter lists from text, disc playlist, and media container sources.</x:String>
  <x:String x:Key="Settings.About.License" xml:space="preserve">License: GPLv3+. See LICENSE in the repository.</x:String>
  <x:String x:Key="Settings.About.OpenRepository" xml:space="preserve">Open project repository</x:String>
