  <x:String x:Key="Settings.AboutBody" xml:space="preserve">ChapterTool Core browser workspace for importing, editing, projecting and exporting chapter data in WebAssembly.</x:String>
  <x:String x:Key="Settings.AboutLicense" xml:space="preserve">Core functionality is provided under the project license.</x:String>
  <x:String x:Key="Settings.AboutRuntime" xml:space="preserve">Blazor WebAssembly · .NET 10</x:String>
